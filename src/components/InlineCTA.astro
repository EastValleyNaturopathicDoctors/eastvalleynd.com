---
/**
 * A booking prompt placed mid-article by the layouts (see lib/midcta.ts).
 * The wording repeats what /schedule-appointment/ already says about how a
 * request is handled — nothing here is a new claim about the clinic.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  topic?: string;
  /** The page's own online booking (D115); primary when present. */
  booking?: { label: string; url: string }[];
}
const { topic, booking = [] } = Astro.props;
const book = booking[0];
---
<aside class="cta-inline" id="talk" aria-label="Book an appointment" data-pagefind-ignore>
  <div class="cta-inline-text">
    <p class="cta-inline-title">
      {topic ? `Talk to a naturopathic doctor about ${topic}` : 'Talk to a naturopathic doctor'}
    </p>
    <p class="cta-inline-body">{book
      ? 'Pick a time online, or send a request and the front desk will call you back.'
      : 'Send a request and the front desk will call you back to confirm a time.'}</p>
  </div>
  <div class="cta-inline-actions">
    {book
      ? <Button href={book.url} variant="dark" icon="calendar" target="_blank" rel="noopener"
                aria-label={topic ? `Book ${topic} online (opens the scheduler)` : undefined}>Book online</Button>
      : <Button href="/new-patient-appointment-request/" variant="dark" icon="arrow-right">Request an appointment</Button>}
    {book && <a class="cta-inline-phone" href="/new-patient-appointment-request/">Or send a request</a>}
    <a class="cta-inline-phone" href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
  </div>
</aside>

<style is:global>
.cta-inline {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5) var(--space-7);
  margin: var(--space-7) 0; padding: var(--pad-card);
  background: var(--grn-soft); border: 1px solid #D5E9C2; border-radius: var(--radius-lg);
}
.cta-inline-text { flex: 1 1 320px; }
.cta-inline-title {
  margin: 0 0 var(--space-2); font-family: var(--font-display); font-weight: 600;
  font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -0.015em; line-height: 1.2; color: var(--ink);
  text-wrap: balance;
}
.cta-inline-body { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); max-width: 46ch; }
.cta-inline-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
.cta-inline-phone {
  display: inline-flex; align-items: center; gap: var(--space-2);
  font-family: var(--font-mono); font-size: 14px; color: var(--ink-2); text-decoration: none;
}
.cta-inline-phone:hover { color: var(--grn-2); }
.cta-inline-phone svg { color: var(--grn-2); flex: none; }
/* Inside an article the prose link rule skips classed links (prose.css), so
   the button and phone link keep their own colours with no restating here. */
/* A CTA button the copywriter placed in the deck (a `{…}` directive, D103);
   drawn in BodyHtml.astro as an outline with an arrow (tracker C8). */
.cta-inline-btn { margin: var(--space-7) 0; }
</style>
