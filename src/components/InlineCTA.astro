---
/**
 * A booking prompt placed mid-article by the layouts (see lib/midcta.ts).
 * The wording repeats what /schedule-appointment/ already says about how a
 * request is handled — nothing here is a new claim about the clinic.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { topic?: string }
const { topic } = Astro.props;
---
<aside class="cta-inline" id="talk" aria-label="Book an appointment" data-pagefind-ignore>
  <div class="cta-inline-text">
    <p class="cta-inline-title">
      {topic ? `Talk to a naturopathic doctor about ${topic}` : 'Talk to a naturopathic doctor'}
    </p>
    <p class="cta-inline-body">Send a request and the front desk will call you back to confirm a time.</p>
  </div>
  <div class="cta-inline-actions">
    <Button href="/new-patient-appointment-request/" variant="dark" icon="arrow-right">Request an appointment</Button>
    <a class="cta-inline-phone" href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
  </div>
</aside>

<style is:global>
.cta-inline {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 28px;
  margin: 2.2em 0; padding: 24px 26px;
  background: var(--grn-soft); border: 1px solid #D5E9C2; border-radius: var(--radius-lg);
}
.cta-inline-text { flex: 1 1 320px; }
.cta-inline-title {
  margin: 0 0 6px; font-family: var(--font-display); font-weight: 600;
  font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -0.015em; line-height: 1.2; color: var(--ink);
  text-wrap: balance;
}
.cta-inline-body { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); max-width: 46ch; }
.cta-inline-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
.cta-inline-phone {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono); font-size: 14px; color: var(--ink-2); text-decoration: none;
}
.cta-inline-phone:hover { color: var(--grn-2); }
.cta-inline-phone svg { color: var(--grn-2); flex: none; }
/* Inside an article body, `.cpage-body a` / `.post-body a` (green, underlined)
   outrank `.btn-dark` and `.cta-inline-phone` on specificity — restate them. */
.cpage-body .cta-inline a, .post-body .cta-inline a,
.cpage-body .cta-inline-btn a, .post-body .cta-inline-btn a { text-decoration: none; }
.cpage-body .cta-inline .btn-dark, .post-body .cta-inline .btn-dark,
.cpage-body .cta-inline-btn .btn-dark, .post-body .cta-inline-btn .btn-dark { color: #fff; }
.cpage-body .cta-inline-phone, .post-body .cta-inline-phone { color: var(--ink-2); }
.cpage-body .cta-inline-phone:hover, .post-body .cta-inline-phone:hover { color: var(--grn-2); }
/* A CTA button the copywriter placed in the deck (a `{…}` directive, D103). */
.cta-inline-btn { margin: 1.6em 0; }
</style>
