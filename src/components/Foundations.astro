---
import Eyebrow from './Eyebrow.astro';
import { process } from '../data/content';
---
<section class="section" id="about">
  <div class="container two-col">
    <div class="col-eyebrow"><Eyebrow>About / EVND Foundations</Eyebrow></div>
    <div class="col-body">
      <h2 class="h2">We don't chase symptoms. We build a working model of <em>your</em> biology and treat from there.</h2>
      <p class="lede">
        EVND Foundations is the framework our doctors have refined over 18 years of practice. It
        treats chronic disease, optimization, and acute illness as an individual journey — guided
        by labs you can read, decisions you understand, and a plan that adjusts as your body does.
      </p>
      <div class="found-grid">
        {process.map((s) => (
          <div class="found-cell">
            <span class="found-step">{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
.two-col {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: clamp(32px, 5vw, 80px);
  align-items: start;
}
.col-eyebrow { position: sticky; top: 100px; }
.found-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  margin-top: 48px;
  border-radius: var(--radius);
  overflow: hidden;
}
.found-cell {
  background: #fff;
  padding: 32px 28px;
  display: flex; flex-direction: column; gap: 8px;
  min-height: 220px;
}
.found-step {
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.1em;
  color: var(--grn-2);
  margin-bottom: 24px;
}
/* Card titles are h3: they sit under a section h2, and Lighthouse flagged
   the h2 -> h4 skip on every page carrying these cards. The hero's two
   .dp-title panels are h2 for the same reason — they followed the h1 directly. */
.found-cell h3 { font-family: var(--font-display); font-size: 22px; margin: 0; font-weight: 600; letter-spacing: -0.01em; }
.found-cell p { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.55; }

@media (max-width: 900px) {
  .two-col { grid-template-columns: 1fr; }
  .col-eyebrow { position: static; }
  .found-grid { grid-template-columns: 1fr; }
}
</style>
