---
/**
 * The appointment request form, rebuilt from the old site's Gravity Form 2
 * ("Request Appointment - Full Page"): the same fields and wording, in the
 * site's own styling, without the reCAPTCHA.
 *
 * Sent by the site's Worker to patientcare@ (src/lib/form-send.ts,
 * worker/index.js /api/appointment), behind Cloudflare Turnstile. An interim
 * route (Nov 2026) until the clinic's Paubox Forms: it has no HIPAA BAA, so
 * the date of birth and chief complaint fields are left out
 * (src/data/forms.ts) and the front desk asks on the call back. Without
 * JavaScript the button stays disabled, so no patient details end up in a
 * URL. Styles: src/styles/request-form.css.
 */
import Button from './Button.astro';
import { site } from '../data/site';
import { healthFields } from '../data/forms';
import { turnstileSiteKey } from '../data/turnstile';
import '../styles/request-form.css';
---
<form class="req-form" id="appointment-request" method="post" action="/api/appointment"
      data-endpoint="/api/appointment" data-action="appointment" data-sitekey={turnstileSiteKey}>
  <fieldset class="req-field">
    <legend>Name</legend>
    <div class="req-row">
      <label class="req-sub">
        <input type="text" name="first_name" autocomplete="given-name" />
        <span>First</span>
      </label>
      <label class="req-sub">
        <input type="text" name="last_name" autocomplete="family-name" />
        <span>Last</span>
      </label>
    </div>
  </fieldset>

  <div class="req-field">
    <label for="req-email">Email <span class="req-star" aria-hidden="true">*</span></label>
    <input id="req-email" type="email" name="email" autocomplete="email" required />
  </div>

  <div class="req-field">
    <label for="req-phone">Phone <span class="req-star" aria-hidden="true">*</span></label>
    <input id="req-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel"
           placeholder="(999) 999-9999" required />
  </div>

  <fieldset class="req-field">
    <legend>Current patient? <span class="req-star" aria-hidden="true">*</span></legend>
    <div class="req-choices">
      <label class="req-choice"><input type="radio" name="current_patient" value="no" required /><span>No</span></label>
      <label class="req-choice"><input type="radio" name="current_patient" value="yes" /><span>Yes</span></label>
    </div>
  </fieldset>

  {healthFields && (<fieldset class="req-field">
    <legend>Patient's date of birth</legend>
    <div class="req-dob">
      <label class="req-sub"><input type="text" name="dob_month" inputmode="numeric" maxlength="2" placeholder="MM" autocomplete="bday-month" /><span class="sr-only">Month</span></label>
      <label class="req-sub"><input type="text" name="dob_day" inputmode="numeric" maxlength="2" placeholder="DD" autocomplete="bday-day" /><span class="sr-only">Day</span></label>
      <label class="req-sub is-year"><input type="text" name="dob_year" inputmode="numeric" maxlength="4" placeholder="YYYY" autocomplete="bday-year" /><span class="sr-only">Year</span></label>
    </div>
  </fieldset>

  <div class="req-field">
    <label for="req-reason">What is your main reason or chief complaint for seeing or seeking a naturopath?</label>
    <textarea id="req-reason" name="reason" rows="5"></textarea>
  </div>)}

  <p class="req-legend"><span class="req-star" aria-hidden="true">*</span> Required</p>

  {/* A trap for form-filling bots: out of sight and out of the tab order. */}
  <div class="req-trap" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="req-turnstile"></div>

  <div class="req-actions">
    <Button variant="dark" size="lg" icon="arrow-right" type="submit" disabled><span class="btn-label">Submit</span></Button>
    <p class="req-error" role="alert" tabindex="-1" hidden></p>
  </div>

</form>
<div class="req-done" data-for="appointment-request" role="status" tabindex="-1" hidden>
  <p class="req-done-title">Thank you. Your request is in.</p>
  <p>The front desk will call you back to confirm a time. Need us sooner? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
</div>

<script>
  import { attach } from '@/lib/form-send';
  for (const form of document.querySelectorAll<HTMLFormElement>('#appointment-request')) attach(form);
</script>
