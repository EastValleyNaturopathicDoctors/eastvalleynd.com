---
/**
 * A section's index — Conditions, Services, About, Resources — read from the
 * sitemap tree. Two bands, each uniform (D114):
 *
 *   1. PANELS for the children that head sub-pages, widest first. A panel's
 *      width follows its size and its sub-pages run in columns inside it, so
 *      a fifteen-page Specialty Labs stands about as tall as a three-page
 *      Detox Programs, and every sub-page is listed — no "+N more".
 *   2. TILES for the leaf pages: icon, name, equal height.
 *
 * The old single grid put a 66px card beside a 311px one and hid children
 * behind a count. Rows are always full: a 12-column grid, spans of 12 / 6 / 4
 * by tier, and a leftover panel in a row is widened to close it.
 */
import Icon from './Icon.astro';
import { find, live, type NavNode } from '@/lib/nav';
import { site } from '@/data/site';
import { sectionKeywords } from '@/data/section-keywords';
import { sectionIcons, sectionIconDefault } from '@/data/section-icons';

interface Props {
  /** Top-level section path, e.g. "/conditions/". */
  root: string;
  /** Show each child's own sub-pages beneath it. Off → every item is a tile. */
  showChildren?: boolean;
  /** Band headings, shown only when both bands render. */
  panelsLabel?: string;
  tilesLabel?: string;
  /** A filter box above the index: its label and an example in the field. */
  filter?: { label: string; placeholder: string };
}
const { root, showChildren = true, panelsLabel, tilesLabel, filter } = Astro.props;

const section = find(root);
// Placeholder pages get no panel, tile or sub-page link (tracker N1).
const items = live(section?.children ?? []);
if (import.meta.env.DEV && !section) console.warn(`<SectionIndex> no nav section for "${root}"`);

/** What the filter box matches: the page's name and any everyday words for it. */
const findText = (n: NavNode) => [n.label, sectionKeywords[n.href]].filter(Boolean).join(' ');
const iconFor = (n: NavNode) => sectionIcons[n.href] ?? sectionIconDefault[root] ?? 'circle';

/** Soft-hyphen break points for the longest words in tile labels, so a narrow
 *  tile breaks "Photo-biomodulation" at a syllable instead of cutting it
 *  anywhere. Invisible unless the word actually has to break. */
const SOFT: Record<string, string> = {
  Photobiomodulation: 'Photo\u00ADbio\u00ADmodu\u00ADlation', Gastrointestinal: 'Gastro\u00ADintestinal',
  Dermatological: 'Dermato\u00ADlogical', Detoxification: 'Detoxi\u00ADfication', Environmental: 'Environ\u00ADmental',
  Neurofeedback: 'Neuro\u00ADfeedback', Mitochondrial: 'Mito\u00ADchondrial', Microneedling: 'Micro\u00ADneedling',
  Endometriosis: 'Endo\u00ADmetriosis', Hyperactivity: 'Hyper\u00ADactivity', Immunotherapy: 'Immuno\u00ADtherapy',
};
const soft = (label: string) => label.replace(/[A-Za-z]{13,}/g, (w) => SOFT[w] ?? w);

const withKids = showChildren ? items.filter((n) => n.children.length > 0) : [];
const leaves = showChildren ? items.filter((n) => n.children.length === 0) : items;

// Tiers by size, largest first (stable within a tier: sitemap order).
const tier = (n: NavNode) => (n.children.length >= 9 ? 12 : n.children.length >= 4 ? 6 : 4);
const sorted = [...withKids].sort((a, b) => tier(b) - tier(a) || b.children.length - a.children.length);
// Rows must be full. Spans are assigned tier by tier; a tier's remainder
// widens the last panel(s) so nothing sits beside a hole.
const panels: { node: NavNode; span: number }[] = [];
for (const t of [12, 6, 4]) {
  const group = sorted.filter((n) => tier(n) === t);
  const per = 12 / t;                        // panels per row at this tier
  const rem = group.length % per;
  group.forEach((node, i) => {
    let span = t;
    if (rem && i >= group.length - rem) span = 12 / rem;   // 2 left of 3 → 6 each; 1 left → 12
    panels.push({ node, span });
  });
}
const cols = (span: number) => (span === 12 ? 3 : span === 6 ? 2 : 1);
const bands = panels.length > 0 && leaves.length > 0;
---
<div class="six" data-pagefind-ignore data-six-filterable={filter ? '' : undefined}>
  {filter && (
    <div class="six-filter" role="search">
      <label class="six-filter-label" for={`six-find-${root.replace(/\W/g, '')}`}>{filter.label}</label>
      <div class="six-filter-field">
        <Icon name="search" size={18} />
        <input id={`six-find-${root.replace(/\W/g, '')}`} type="search" autocomplete="off" spellcheck="false"
               placeholder={filter.placeholder} />
      </div>
      <p class="six-filter-count" aria-live="polite"></p>
      <div class="six-filter-none" hidden>
        <p>Nothing here matches that yet. Call <a href={site.phoneHref}>{site.phone}</a> and we'll tell you whether we can help.</p>
        <button type="button" class="six-filter-clear">Clear the filter</button>
      </div>
    </div>
  )}
  {panels.length > 0 && (
    <div class="six-group" data-find-group>
      {bands && panelsLabel && <h2 class="six-band">{panelsLabel}</h2>}
      <div class="six-panels">
        {panels.map(({ node, span }) => (
          <div class={`six-panel is-${span}`} data-find={findText(node)}>
            <a class="six-head" href={node.href}>
              <span class="six-icon"><Icon name={iconFor(node)} size={22} /></span>
              <h3>{node.label}</h3>
              <Icon name="arrow-up-right" size={16} class="six-arrow" />
            </a>
            <ul class={`six-kids cols-${cols(span)}`}>
              {node.children.map((k) => <li data-find={findText(k)}><a href={k.href}>{k.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )}
  {leaves.length > 0 && (
    <div class="six-group" data-find-group>
      {bands && tilesLabel && <h2 class="six-band">{tilesLabel}</h2>}
      <ul class="six-tiles">
        {leaves.map((n) => (
          <li data-find={findText(n)}>
            <a href={n.href}>
              <span class="six-icon"><Icon name={iconFor(n)} size={22} /></span>
              <span class="six-tile-label">{soft(n.label)}</span>
              <Icon name="arrow-up-right" size={15} class="six-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<script>
  // The filter box (src/lib/index-filter.ts). A band heading goes with its band.
  import { words, applyFilter, countText } from '@/lib/index-filter';
  for (const root of document.querySelectorAll<HTMLElement>('[data-six-filterable]')) {
    const input = root.querySelector<HTMLInputElement>('.six-filter input');
    const count = root.querySelector<HTMLElement>('.six-filter-count');
    const none = root.querySelector<HTMLElement>('.six-filter-none');
    if (!input || !count || !none) continue;
    const run = () => {
      const q = words(input.value);
      const shown = applyFilter(root, q);
      none.hidden = !q.length || shown > 0;
      count.textContent = countText(q, shown);
    };
    input.addEventListener('input', run);
    root.querySelector('.six-filter-clear')?.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
  }
</script>

<style is:global>
/* The filter box. */
.six-filter { margin-bottom: var(--space-head); }
.six-filter-label {
  display: block; margin-bottom: var(--space-3);
  font-family: var(--font-mono); font-size: 12px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
}
.six-filter-field { position: relative; max-width: 560px; }
.six-filter-field svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }
.six-filter-field input {
  width: 100%; font: inherit; font-size: 16px; color: var(--ink);
  padding: 14px 16px 14px 46px; background: var(--bg);
  border: 1px solid var(--line-2); border-radius: 999px;
  transition: border-color .18s, box-shadow .18s;
}
.six-filter-field input:focus-visible { outline: none; border-color: var(--grn-2); box-shadow: 0 0 0 3px rgba(108, 190, 63, 0.25); }
.six-filter-count { margin: var(--space-2) 0 0 var(--space-4); min-height: 1.4em; font-size: 13.5px; color: var(--ink-3); }
.six-filter-none { margin-top: var(--space-3); }
.six-filter-none p { margin: 0; color: var(--ink-2); }
.six-filter-none a { color: var(--grn-2); font-weight: 600; }
.six-filter-clear {
  margin-top: var(--space-3); padding: 8px 14px; border: 1px solid var(--line-2); border-radius: 999px;
  background: var(--bg); font: inherit; font-size: 14px; font-weight: 500; color: var(--ink); cursor: pointer;
}
.six-filter-clear:hover { border-color: var(--grn); }
.six [hidden] { display: none !important; }

/* --- Section index: panels for sections, tiles for pages (D114) ---------- */
.six-band {
  font-family: var(--font-mono); font-size: 12px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
  margin: 0 0 var(--space-4);
}
.six-group + .six-group { margin-top: var(--space-head); }

.six-icon {
  flex: none; display: grid; place-items: center; width: 40px; height: 40px;
  border-radius: 12px; background: var(--grn-soft); color: var(--grn-2);
  transition: background .18s, color .18s;
}
.six-arrow { flex: none; color: var(--ink-3); transition: color .2s, transform .2s; }

/* Panels */
.six-panels {
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--gap-cards);
}
.six-panel {
  border: 1px solid var(--line); border-radius: var(--radius-lg);
  padding: var(--pad-card); background: var(--bg);
  transition: border-color .2s, box-shadow .2s;
}
.six-panel:hover { border-color: var(--line-2); box-shadow: 0 12px 32px rgba(14, 19, 17, 0.07); }
.six-panel.is-12 { grid-column: span 12; }
.six-panel.is-6 { grid-column: span 6; }
.six-panel.is-4 { grid-column: span 4; }
.six-head { display: flex; align-items: center; gap: var(--space-3); color: inherit; }
.six-head h3 {
  flex: 1; margin: 0;
  font-family: var(--font-display); font-size: 20px; font-weight: 600;
  letter-spacing: -0.012em; line-height: 1.2;
}
.six-head:hover .six-arrow { color: var(--grn-2); transform: translate(2px, -2px); }
.six-head:hover .six-icon { background: var(--grn); color: var(--ink); }
.six-kids {
  list-style: none; margin: var(--space-4) 0 0; padding: var(--space-3) 0 0;
  border-top: 1px solid var(--line);
  display: grid; gap: 0 var(--space-6);
}
.six-kids.cols-1 { grid-template-columns: 1fr; }
.six-kids.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.six-kids.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.six-kids a {
  display: block; padding: var(--space-1) 0; font-size: 14.5px; color: var(--ink-2);
  transition: color .15s;
}
.six-kids a:hover { color: var(--grn-2); }

/* Tiles */
.six-tiles {
  list-style: none; margin: 0; padding: 0;
  /* 264px leaves a label room for the longest word on one line at desktop sizes. */
  display: grid; grid-template-columns: repeat(auto-fill, minmax(264px, 1fr));
  gap: var(--gap-tiles);
}
.six-tiles li { display: flex; min-width: 0; }   /* every tile in a row takes the row's height */
.six-tiles a {
  flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--space-2); min-height: 66px;
  /* The card inset at the sides, so a tile's icon lines up with a panel's. */
  padding: var(--space-3) var(--pad-card); border: 1px solid var(--line); border-radius: var(--radius);
  background: var(--bg); color: var(--ink);
  font-weight: 500; font-size: 15.5px; line-height: 1.25;
  transition: border-color .18s, background .18s, transform .18s;
}
/* A long word ("Photobiomodulation") never pushes a tile over its neighbour.
   Desktop tiles fit every word whole, so it moves to the next line; phone
   tiles are narrower and break it at the soft hyphens set in soft(). */
.six-tile-label { flex: 1; min-width: 0; -webkit-hyphens: none; hyphens: none; overflow-wrap: break-word; }
.six-tiles a:hover { border-color: var(--grn); background: var(--grn-soft); transform: translateY(-1px); }
.six-tiles a:hover .six-icon { background: var(--grn); color: var(--ink); }
.six-tiles a:hover .six-arrow { color: var(--grn-2); transform: translate(2px, -2px); }

@media (max-width: 980px) {
  .six-panel.is-4 { grid-column: span 6; }
  .six-kids.cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .six-panel.is-6, .six-panel.is-4 { grid-column: span 12; }
  .six-kids.cols-1 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 560px) {
  .six-head h3 { font-size: 18px; }
  .six-kids.cols-2, .six-kids.cols-3, .six-kids.cols-1 { grid-template-columns: 1fr; }
  .six-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .six-tiles a { min-height: 0; padding: var(--space-2) var(--space-3); font-size: 13.5px; }
  .six-tiles .six-icon { width: 30px; height: 30px; border-radius: 9px; }
  .six-tiles .six-icon svg { width: 18px; height: 18px; }
  .six-tiles .six-arrow { display: none; }
  .six-tile-label { -webkit-hyphens: manual; hyphens: manual; }
}
</style>
