---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { optimization } from '../data/content';
---
<section class="section opt-section" id="optimize">
  <div class="container">
    <div class="opt-grid">
      <div class="opt-hero">
        <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1400&q=80&auto=format&fit=crop" alt="" loading="lazy" />
        <div class="opt-hero-overlay"></div>
        <div class="opt-hero-text">
          <Eyebrow>Optimization at EVND</Eyebrow>
          <h2 class="h2">Healthy isn't the ceiling. <br /><span class="accent-grn">It's the floor.</span></h2>
          <p>Programs for performance, longevity, hormone resilience, body composition and cognition — built by physicians, not influencers.</p>
          <Button href="/new-patient-appointment-request/" variant="light" icon="arrow-right">Book an optimization consult</Button>
        </div>
      </div>
      <div class="opt-list">
        {optimization.map((o) => (
          <a class="opt-item" href={o.href}>
            <div class="opt-icon"><Icon name={o.icon} size={20} /></div>
            <div>
              <h3>{o.name}</h3>
              <p>{o.desc}</p>
            </div>
            <Icon name="arrow-up-right" size={16} />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
.opt-section { background: var(--bg-soft); }
.opt-grid {
  display: grid; grid-template-columns: 1.1fr 1fr;
  gap: 24px;
}
.opt-hero {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  min-height: 560px;
  isolation: isolate;
}
.opt-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.opt-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(14,19,17,0.2) 0%, rgba(14,19,17,0.85) 100%);
}
.opt-hero-text {
  position: relative; z-index: 2;
  padding: 36px 34px;
  display: flex; flex-direction: column; gap: 18px;
  height: 100%;
  justify-content: flex-end;
  min-height: 560px;
  color: #fff;
}
.opt-hero-text .eyebrow {
  color: #fff;
  border-color: rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.08);
}
.opt-hero-text p { color: rgba(255,255,255,0.85); max-width: 38ch; margin: 0; }
.opt-list {
  background: #fff;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.opt-item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 20px;
  padding: 22px 24px;
  border-bottom: 1px solid var(--line);
  transition: background .2s;
  color: var(--ink-3);
}
.opt-item:last-child { border-bottom: 0; }
.opt-item:hover { background: var(--bg-softer); color: var(--ink); }
.opt-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  background: var(--grn-soft);
  color: var(--grn-2);
  display: inline-flex; align-items: center; justify-content: center;
}
.opt-item h3 { font-family: var(--font-display); font-size: 18px; margin: 0 0 4px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; }
.opt-item p { margin: 0; font-size: 14px; color: var(--ink-3); }

@media (max-width: 1000px) { .opt-grid { grid-template-columns: 1fr; } }
</style>
