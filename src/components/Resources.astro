---
/**
 * Homepage resources: the practice's own e-book, its most-watched topic
 * webinar, and the three newest blog posts that have a featured image.
 * Everything here is real content with a real destination (D106). The design
 * template's version posted an email form to /api/ebook — an endpoint a static
 * host does not have — and linked four invented articles to /resources/.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import Eyebrow from './Eyebrow.astro';
import webinarData from '../data/webinars.json';
interface Props { showHead?: boolean; }
const { showHead = true } = Astro.props;

// Offered free on the old site at /free-ebook-download-menopause/, "by Jennifer Nevels".
const EBOOK = '/wp-content/uploads/2018/07/How-to-Feel-Amazing-in-Menopause-eBook.pdf';
// 13.7 MB, measured 2026-09-17. Worth saying on a phone. The file is a fixed 2018 upload.
const ebookMB = 14;

const blogImages = import.meta.glob<{ default: ImageMetadata }>('/src/images/blog/*.{jpg,jpeg,png,webp}', { eager: true });
const posters = import.meta.glob<{ default: ImageMetadata }>('/src/images/webinars/*.jpg', { eager: true });

const webinar = webinarData.webinars.find((w) => w.id === 'hFJUnGl09pc')!;
const posts = (await getCollection('blog'))
  .filter((p) => p.data.imageFile && blogImages[`/src/images/blog/${p.data.imageFile}`])
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

// Read time is derived from the post's real word count, not asserted.
const minutes = (words: number) => `${Math.max(1, Math.round(words / 230))} min read`;
const cards = [
  { kind: 'Webinar', meta: 'Video', title: webinar.title, by: 'Dr. Jennifer Nevels',
    href: '/webinars/', img: posters[`/src/images/webinars/${webinar.posterFile}`]?.default },
  ...posts.map((p) => ({
    kind: 'Article', meta: minutes(p.data.wordCount), title: p.data.title, by: p.data.author,
    href: `/${p.data.slug}/`, img: blogImages[`/src/images/blog/${p.data.imageFile}`].default,
  })),
];
---
<section class="section resources-section is-band" id="resources">
  <div class="container">
    {showHead && (
      <SectionHead
        eyebrow="Resources"
        blurb="Articles, webinars and a free e-book from the EVND clinicians."
        ctaLabel="Resource library" ctaHref="/resources/">
        Learn the medicine, then decide.
      </SectionHead>
    )}

    <div class="res-grid">
      <div class="ebook-card">
        <Eyebrow>Free e-book</Eyebrow>
        <h3>How to Feel Amazing in Menopause</h3>
        <p>A complimentary guide by Dr. Jennifer Nevels.</p>
        <a class="btn btn-light ebook-download" href={EBOOK}>
          Download the e-book <Icon name="arrow-right" size={16} />
        </a>
        <small>PDF · {ebookMB} MB</small>
      </div>

      {cards.map((c) => (
        <a class="res-card" href={c.href}>
          {c.img && <Image src={c.img} alt="" width={640} height={360} loading="lazy" decoding="async" />}
          <div class="res-meta"><span>{c.kind}</span><span>{c.meta}</span></div>
          <h3>{c.title}</h3>
          <span class="res-author">By {c.by}</span>
          <span class="res-arrow"><Icon name="arrow-up-right" size={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
.resources-section { background: var(--bg-softer); }
.res-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.ebook-card {
  grid-row: span 2;
  background: var(--ink);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  /* Bottom-aligned, so the copy and its button stay together; margins, not a
     flex gap: h3 -> text 8, text -> button 32, button -> size note 8. */
  display: flex; flex-direction: column; gap: 0; justify-content: flex-end;
}
.ebook-card .eyebrow { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.85); }
.ebook-card h3 { font-family: var(--font-display); font-size: 30px; margin: 0; font-weight: 600; letter-spacing: -0.015em; line-height: 1.1; }
.ebook-card p { color: rgba(255,255,255,0.78); font-size: 15px; line-height: 1.55; margin: var(--space-2) 0 0; }
.ebook-download { margin-top: var(--space-7); align-self: flex-start; }
.ebook-card small { margin-top: var(--space-2); color: rgba(255,255,255,0.5); font-size: 12px; }

.res-card {
  position: relative;
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--line);
  display: flex; flex-direction: column;
  min-height: 260px;
  transition: transform .25s;
}
.res-card:hover { transform: translateY(-3px); }
.res-card img { aspect-ratio: 16/9; object-fit: cover; width: 100%; }
.res-meta {
  position: absolute; top: 14px; left: 14px; right: 14px;
  display: flex; justify-content: space-between;
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #fff;
}
.res-meta span:first-child { background: var(--grn); color: var(--ink); padding: 4px 10px; border-radius: 999px; font-weight: 600; }
.res-meta span:last-child { background: rgba(14,19,17,0.6); padding: 4px 10px; border-radius: 999px; backdrop-filter: blur(6px); }
.res-card h3 { font-family: var(--font-display); font-size: 20px; line-height: 1.2; font-weight: 600; letter-spacing: -0.01em; margin: 18px 22px 0; text-wrap: balance; }
.res-author { padding: 4px 22px 22px; color: var(--ink-3); font-size: 13px; }
.res-arrow {
  position: absolute; bottom: 18px; right: 18px;
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--bg-soft);
  display: inline-flex; align-items: center; justify-content: center;
  transition: background .2s, color .2s;
}
.res-card:hover .res-arrow { background: var(--ink); color: #fff; }

@media (max-width: 1000px) { .res-grid { grid-template-columns: repeat(2, 1fr); } .ebook-card { grid-row: span 1; grid-column: 1 / -1; } }
@media (max-width: 600px) { .res-grid { grid-template-columns: 1fr; } }
</style>
