---
/**
 * A YouTube video that costs nothing until someone presses play.
 *
 * Renders a locally-hosted poster frame and a button. The iframe — and every
 * request to Google — only happens on click. Six embedded players on one page
 * would otherwise pull well over a megabyte of third-party script before the
 * visitor had asked for any of it.
 *
 * Posters come from YouTube at 640x480 with letterbox bars; the 16:9 frame plus
 * object-fit: cover crops back to exactly the video frame.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  /** Shown on the card. */
  title: string;
  /** The video's own title on YouTube — the iframe's accessible name. */
  youtubeTitle?: string;
  posterFile?: string;
  loading?: 'lazy' | 'eager';
  /** 'h3' in a grid of videos (webinars); 'p' inside an article, where a
   *  caption must not enter the document outline (D115). */
  titleTag?: 'h3' | 'p';
}
const { id, title, youtubeTitle = '', posterFile = '', loading = 'lazy', titleTag = 'h3' } = Astro.props;
const TitleTag = titleTag;

const posters = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/webinars/*.{jpg,jpeg,png,webp}', { eager: true }
);
const poster = posterFile ? posters[`/src/images/webinars/${posterFile}`] : undefined;
if (import.meta.env.DEV && posterFile && !poster) {
  console.warn(`<VideoFacade> missing src/images/webinars/${posterFile}`);
}
---
<article class="video-card">
  <div class="video-frame" data-video-id={id} data-video-title={youtubeTitle || title}>
    {poster ? (
      <Image src={poster.default} alt="" width={640} height={360}
             class="video-poster" loading={loading} decoding="async" />
    ) : (
      <div class="video-poster video-poster-blank"></div>
    )}
    <button type="button" class="video-play">
      <span class="video-play-dot"><Icon name="play" size={20} /></span>
      <span class="sr-only">Play “{title}”</span>
    </button>
  </div>
  <TitleTag class="video-title">{title}</TitleTag>
  <a class="video-link" href={`https://www.youtube.com/watch?v=${id}`}
     target="_blank" rel="noopener">
    Watch on YouTube <Icon name="arrow-up-right" size={13} />
  </a>
</article>

<script>
  // Swap the poster for a real player on click. Nothing is requested from
  // YouTube until this runs. Lives here, not on a page, so every page that
  // renders a facade gets it — the webinars page and migrated bodies (D115).
  document.querySelectorAll<HTMLElement>('.video-frame').forEach((frame) => {
    const btn = frame.querySelector('.video-play');
    btn?.addEventListener('click', () => {
      const id = frame.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src =
        `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = frame.dataset.videoTitle ?? 'Video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      frame.replaceChildren(iframe);
      frame.classList.add('is-playing');
      iframe.focus();
    });
  });
</script>

<style is:global>
.video-card { display: flex; flex-direction: column; }
.video-frame {
  position: relative; aspect-ratio: 16 / 9; overflow: hidden;
  border-radius: var(--radius); background: var(--ink);
  border: 1px solid var(--line);
}
/* YouTube's poster is 4:3 with letterbox bars; cover crops them off. */
.video-poster { width: 100%; height: 100%; object-fit: cover; }
.video-poster-blank {
  background: linear-gradient(135deg, #141A17, #0A0E0C);
}
.video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
.video-frame.is-playing { border-color: var(--ink); }

.video-play {
  position: absolute; inset: 0; width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(180deg, rgba(14,19,17,0.10), rgba(14,19,17,0.42));
  transition: background .2s;
}
.video-play:hover { background: linear-gradient(180deg, rgba(14,19,17,0.05), rgba(14,19,17,0.32)); }
.video-play-dot {
  display: grid; place-items: center;
  width: 62px; height: 62px; border-radius: 50%;
  background: rgba(255,255,255,0.94); color: var(--ink);
  box-shadow: 0 10px 30px rgba(0,0,0,0.28);
  transition: transform .2s ease, background .2s;
}
.video-play-dot svg { margin-left: 3px; }   /* optical centring of the triangle */
.video-play:hover .video-play-dot { transform: scale(1.07); background: #fff; }
.video-play:focus-visible { outline: 3px solid var(--grn); outline-offset: 3px; }

.video-title {
  font-family: var(--font-display); font-weight: 600;
  font-size: clamp(17px, 1.5vw, 20px); line-height: 1.25; letter-spacing: -0.012em;
  margin: 16px 0 0; text-wrap: balance;
}
.video-link {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 8px;
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em;
  text-transform: uppercase; color: var(--ink-3);
}
.video-link:hover { color: var(--grn-2); }

@media (prefers-reduced-motion: reduce) {
  .video-play-dot, .video-play:hover .video-play-dot { transition: none; transform: none; }
}
</style>
