---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { nav, isSame, contains, isStub, type NavNode } from '@/lib/nav';
import { site } from '@/data/site';

const here = Astro.url.pathname;

/** Wide sections get a multi-column panel; short ones a simple list. */
const MEGA_AT = 8;

/**
 * A mega panel lists its section's own children and stops there.
 *
 * Listing grandchildren too put 87 links and 857px of menu on screen — taller
 * than a laptop viewport, and `columns: 4` flowed them down-then-across so a
 * group and its children split across a column break. The children are one
 * click away on the section page, which already renders them as cards, and on
 * the parent page itself. Picking the category is what a menu is for.
 */

/** What the panel offers alongside the list — the clinic's actual next step. */
const PANEL_ASIDE: Record<string, { title: string; body: string }> = {
  '/conditions/': {
    title: 'Not sure which applies?',
    body: 'Most people arrive with more than one thing going on. Tell us what you are experiencing and we will point you to the right clinician.',
  },
  '/services/': {
    title: 'Which treatment is right?',
    body: 'Treatments are chosen after testing, not before. A first visit works out which of these belongs in your plan.',
  },
};

/**
 * Header-only presentation rules. nav.json stays a faithful copy of the
 * sitemap tree — breadcrumbs, section indexes and /404/ all read it — so
 * anything that is about the *header* specifically belongs here, not in the
 * generator.
 */

/** Short labels for the header. The pages keep their full sitemap titles. */
const NAV_LABELS: Record<string, string> = {
  '/about/': 'About',
  '/conditions/': 'Conditions',
};

/**
 * Both of these are the CTA button now — carrying them as nav links too put
 * three ways to book within an inch of each other.
 * /contact/ moves to the utility bar (see topBarLinks in src/data/site.ts).
 */
const HEADER_EXCLUDE = new Set(['/contact/', '/schedule-appointment/']);

/**
 * Sections that are a chronological archive rather than part of the IA. Their
 * children are not listed in the menu: 44 posts in date order is not
 * navigation, it changes every time something is published, and the section's
 * own index page presents them far better.
 */
const ARCHIVE = new Set(['/blog/']);

const label = (n: NavNode) => NAV_LABELS[n.href] ?? n.label;
// Placeholder pages are left out of the menus and their counts (tracker N1).
// `contains` still walks the full tree, so a placeholder's section stays lit.
const kidsOf = (n: NavNode) => (ARCHIVE.has(n.href) ? [] : n.children.filter((c) => !isStub(c.href)));
const headerNav = nav.filter((n) => !HEADER_EXCLUDE.has(n.href) && !isStub(n.href));
---
<header class="mainnav" id="mainnav">
  <div class="container mainnav-inner">
    {/* EVND unfolding into East Valley Naturopathic Doctors and back (D127):
        one self-animating SVG, built by extract/build_logo.py from the two
        lockups in Logos/. No script; under reduced motion it holds on EVND.
        `alt=""` because the link already carries the accessible name. */}
    <a href="/" class="logo-link" aria-label="EVND home">
      <img src="/assets/EVND-animated.svg" alt="" width="183" height="44" loading="eager" />
    </a>

    <nav class="mainnav-links" aria-label="Primary">
      {headerNav.map((item) => {
        const kids = kidsOf(item);
        const active = contains(item, here);
        if (!kids.length) {
          return (
            <a href={item.href} class:list={['navlink', active && 'is-active']}
               aria-current={isSame(item.href, here) ? 'page' : undefined}>{label(item)}</a>
          );
        }
        const mega = kids.length > MEGA_AT;
        const aside = PANEL_ASIDE[item.href];
        return (
          <div class:list={['navitem', 'has-sub', mega && 'is-mega', active && 'is-active']}>
            <a href={item.href} class:list={['navlink', active && 'is-active']}
               aria-current={isSame(item.href, here) ? 'page' : undefined}>{label(item)}</a>
            <button type="button" class="subtoggle" aria-expanded="false"
                    aria-label={`Show ${label(item)} menu`}><Icon name="chevron-down" size={16} /></button>

            <div class:list={['subnav', mega && 'subnav-mega']}>
              <ul class="subnav-list">
                {kids.map((c) => (
                  <li>
                    <a href={c.href} class:list={[isSame(c.href, here) && 'is-active']}
                       aria-current={isSame(c.href, here) ? 'page' : undefined}>
                      <span>{c.label}</span>
                      {kidsOf(c).length > 0 && (
                        <>
                          <em class="subnav-count" aria-hidden="true">{kidsOf(c).length}</em>
                          <span class="sr-only">, {kidsOf(c).length} pages</span>
                        </>
                      )}
                    </a>
                  </li>
                ))}
              </ul>

              {mega && aside && (
                <aside class="mega-aside">
                  <p class="mega-aside-title">{aside.title}</p>
                  <p class="mega-aside-body">{aside.body}</p>
                  <a class="mega-aside-cta" href="/new-patient-appointment-request/">
                    New patient request <Icon name="arrow-right" size={13} />
                  </a>
                  <a class="mega-aside-phone" href={site.phoneHref}>
                    <Icon name="phone" size={14} />{site.phone}
                  </a>
                </aside>
              )}

              <a class="subnav-all" href={item.href}>
                All {label(item)}<em aria-hidden="true">{kids.length}</em><Icon name="arrow-right" size={13} />
              </a>
            </div>
          </div>
        );
      })}
    </nav>

    <div class="mainnav-right">
      {/* Opens the search dialog (SearchDialog.astro, rendered by Base). A
          <button>, because it does nothing without JavaScript: the dialog is
          the only search there is, and a link to nowhere is worse than no
          control. */}
      <button type="button" class="nav-search" data-search-open aria-label="Search the site" title="Search (press /)">
        <Icon name="search" size={18} />
      </button>
      {/* "Appointment" is dropped on phones (CSS) so the button still fits beside
          the logo and the hamburger. One text node, so a screen reader reads
          exactly what is shown. The label is one span, so the button's flex
          gap (label -> icon) does not also open up between the two words. */}
      <Button href="/schedule-appointment/" variant="dark" icon="calendar" class="nav-cta"
        ><span>Schedule<span class="cta-word"> Appointment</span></span></Button
      >
      <button class="hamburger" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="Open menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <!--
    Mobile groups collapse. Rendering the whole tree open made a 7,000px panel
    of 194 links, which is a scroll, not a menu. <details> gives the toggle
    natively: it works with JavaScript off, is keyboard operable, and screen
    readers announce the expanded state without any ARIA of ours.

    The shared `name` makes them an exclusive accordion natively: opening one
    closes the rest, with no JavaScript. The script covers browsers without it.

    Every group starts closed, so the menu opens the same way every time and the
    panel starts at 488px rather than 1,773px on a Conditions page. The section
    containing the current page is still marked `is-active` on its summary — it
    is flagged, not expanded.
  -->
  <nav class="mobilenav" id="mobileNav" aria-label="Mobile" hidden>
    {headerNav.map((item) => (
      kidsOf(item).length === 0 ? (
        <a href={item.href}
           class:list={['mobilenav-top', contains(item, here) && 'is-active']}>{label(item)}</a>
      ) : (
        <details class="mobilenav-group" name="mobilenav-group">
          <summary class:list={['mobilenav-top', contains(item, here) && 'is-active']}>
            {label(item)}
            <Icon name="chevron-down" size={16} />
          </summary>
          <ul class="mobilenav-sub">
            <li>
              <a class="mobilenav-all" href={item.href}>All {label(item)}</a>
            </li>
            {kidsOf(item).map((c) => (
              <li>
                <a href={c.href} class:list={[isSame(c.href, here) && 'is-active']}>
                  <span>{c.label}</span>
                  {kidsOf(c).length > 0 && (
                    <>
                      <em aria-hidden="true">{kidsOf(c).length}</em>
                      <span class="sr-only">, {kidsOf(c).length} pages</span>
                    </>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    ))}
    <div class="mobilenav-foot">
      <a href="/schedule-appointment/" class="navlink is-cta">Schedule Appointment</a>
      <a href={site.phoneHref} class="mobilenav-phone"><Icon name="phone" size={15} />{site.phone}</a>
      <a href="/contact/" class="mobilenav-secondary">Contact the clinic</a>
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('mainnav')!;
  const toggle = document.getElementById('navToggle')!;
  const panel = document.getElementById('mobileNav') as HTMLElement;

  // `is-scrolled` shrinks the header. Two things kept this cheap to get wrong:
  // toggling the class on every scroll event invalidates style even when the
  // value has not changed, and calling it synchronously at load forced a full
  // layout of the ~1,400-node page before first paint — the trace put 81 ms on
  // it. Now it only writes when the state flips, and the first read waits for
  // the next frame so it never sits in the critical path.
  let scrolled: boolean | undefined;
  const onScroll = () => {
    const now = window.scrollY > 20;
    if (now === scrolled) return;
    scrolled = now;
    nav.classList.toggle('is-scrolled', now);
  };
  requestAnimationFrame(onScroll);
  window.addEventListener('scroll', onScroll, { passive: true });

  // The panel sits below the header bar inside a sticky element, so the height
  // available to it is whatever is left between the bottom of the bar and the
  // bottom of the viewport. The bar's height is not a constant: the topbar
  // scrolls away and `is-scrolled` shrinks the logo, so measure it rather than
  // hard-coding it. The stylesheet turns this into a max-height and scrolls the
  // overflow.
  const bar = nav.querySelector('.mainnav-inner') as HTMLElement;
  const sizePanel = () =>
    nav.style.setProperty('--nav-h', Math.round(bar.getBoundingClientRect().bottom) + 'px');

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    panel.hidden = open;
    nav.classList.toggle('nav-open', !open);
    // Lock the page while the menu is over it, or a flick scrolls the article
    // underneath and the menu slides away with the header.
    document.body.classList.toggle('nav-locked', !open);
    if (!open) { sizePanel(); panel.scrollTop = 0; }
  });

  // One group open at a time. The shared `name` on the <details> already does
  // this in current browsers; closing the siblings here covers the ones where
  // `name` is ignored. Deliberately NOT feature-detected: where the browser
  // handles it the loop finds the siblings already closed and does nothing, and
  // setting `open = false` on a closed <details> fires no event. One code path
  // that every browser runs beats a fallback branch that no browser I can test
  // ever enters.
  const groups = Array.from(panel.querySelectorAll<HTMLDetailsElement>('.mobilenav-group'));

  groups.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      groups.forEach((o) => { if (o !== d) o.open = false; });
      // Collapsing the groups above this one pulls it upward, which can take
      // the header you just tapped off the top of the scrolled panel. Put it
      // back. Only ever scrolls up, so opening a group in view stays put.
      requestAnimationFrame(() => {
        const top = d.getBoundingClientRect().top - panel.getBoundingClientRect().top;
        if (top < 0) panel.scrollTop += top;
      });
    });
  });

  // Rotating the phone changes both the viewport and the bar. Crossing the
  // breakpoint is different: above 980px the panel is `display: none`, so
  // leaving it "open" would lock the page with no menu visible and no way to
  // unlock it. Close it instead.
  window.addEventListener('resize', () => {
    if (panel.hidden) return;
    if (window.matchMedia('(min-width: 981px)').matches) toggle.click();
    else sizePanel();
  });

  // Pointer users get hover from CSS; this covers click, touch and keyboard.
  const subs = Array.from(nav.querySelectorAll<HTMLElement>('.navitem.has-sub'));
  const closeAll = (except?: HTMLElement) => {
    subs.forEach((s) => {
      if (s === except) return;
      s.classList.remove('is-open');
      s.querySelector('.subtoggle')?.setAttribute('aria-expanded', 'false');
    });
  };
  subs.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.subtoggle')!;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(item);
      btn.setAttribute('aria-expanded', String(!open));
      item.classList.toggle('is-open', !open);
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) {
        item.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element)?.closest('.navitem.has-sub')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (toggle.getAttribute('aria-expanded') === 'true') toggle.click();
    closeAll();
  });
</script>

<style is:global>
.mainnav {
  position: sticky; top: 0; z-index: 60;
  background: rgba(255,255,255,0.86);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid transparent;
  transition: border-color .2s, background .2s;
}
.mainnav.is-scrolled { border-color: var(--line); background: rgba(255,255,255,0.96); }
.mainnav-inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 32px;
  align-items: center;
  padding: 18px var(--pad);
  transition: padding .2s ease;
}
/* The sticky bar gives back a little height once the reader is past the top —
   89px of permanent chrome is a tenth of a laptop viewport. */
.mainnav.is-scrolled .mainnav-inner { padding-top: 11px; padding-bottom: 11px; }
.mainnav.is-scrolled .logo-link img { height: 38px; }
.logo-link img { transition: height .2s ease; }
@media (prefers-reduced-motion: reduce) {
  .mainnav-inner, .logo-link img { transition: none; }
}
/* The asset is 750x300 (2.5:1). Asking for 150x44 (3.4:1) made the responsive
   image styles crop to `cover`, which cut the tagline off the bottom. Width and
   height follow the real ratio, and `contain` guarantees a logo is never
   cropped whatever size it is asked for. */
.logo-link img { height: 44px; width: auto; object-fit: contain; }
/* aspect-ratio: the trace flagged the SVG as an unsized image (0.0005 CLS);
   `height: 44px; width: auto` only knows the width once the file has loaded. */
.logo-link img { aspect-ratio: 1020 / 246; }
.mainnav-links { display: flex; gap: 4px; justify-content: center; }
.navlink {
  padding: 9px 14px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink-2);
  transition: color .2s, background .2s;
}
.navlink:hover { background: var(--bg-soft); color: var(--ink); }
.mainnav-right { display: flex; align-items: center; gap: 12px; }
.hamburger { display: none; padding: 8px; }
.nav-search {
  display: grid; place-items: center; width: 40px; height: 40px;
  border-radius: 999px; color: var(--ink-2);
  transition: background .2s, color .2s;
}
.nav-search:hover { background: var(--bg-soft); color: var(--ink); }
.nav-search:focus-visible { outline: 2px solid var(--grn-2); outline-offset: 2px; }

@media (max-width: 980px) {
  .mainnav-links { display: none; }
  .hamburger { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; }
  .nav-search { width: 44px; height: 44px; }
  /* The nav links are `display: none` here, which takes them out of the grid
     entirely — so the three-column track collapsed and the CTA and hamburger
     were laid out in the middle column, bunched against the logo with dead
     space to their right. Two columns is what this layout actually has. */
  .mainnav-inner {
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding-top: 11px; padding-bottom: 11px;
  }
  .mainnav-right { gap: 6px; }
}

/* 119px of the viewport was header on a 375px phone. */
@media (max-width: 560px) {
  .mainnav-inner { padding-top: 9px; padding-bottom: 9px; }
  .logo-link img { height: 38px; }
  .mainnav.is-scrolled .logo-link img { height: 34px; }
}

/* Mobile nav panel — the template was a single page and never needed one. */
.mobilenav { display: none; }
.mainnav.nav-open .mobilenav {
  display: flex; flex-direction: column; gap: 2px;
  padding: 12px var(--pad) 20px;
  background: var(--bg); border-top: 1px solid var(--line);
  /* The panel hangs inside the sticky header, so anything past the bottom of
     the viewport cannot be reached: with every group open it ran to 3,208px on
     an 812px phone, leaving the Schedule CTA 2,300px below the fold. Cap it to
     the space under the header bar and let it scroll itself. `max-height` only
     bites when the content is actually taller, so a short menu still sizes to
     its content. --nav-h is the bar's measured height, set by MainNav.astro on
     open and on resize; the literal is the fallback for the frame before that
     runs, and for no-JS. */
  max-height: calc(100vh - var(--nav-h, 97px));
  max-height: calc(100dvh - var(--nav-h, 97px));
  overflow-y: auto;
  /* Without this, flicking past the end of the menu scrolls the page behind it. */
  overscroll-behavior: contain;
}
/* The page must not scroll behind an open menu — the panel scrolls instead. */
body.nav-locked { overflow: hidden; }
.mainnav.nav-open .mobilenav .navlink { padding: 12px 0; font-size: 17px; }
.mobilenav .is-cta { color: var(--grn-2); font-weight: 600; }

/* --- Nav dropdowns + mega menus --------------------------------------------
   Pointer users open on hover; the toggle button covers click, touch and
   keyboard, where hover never fires. A section with more than 8 children gets
   a wide panel; the rest get a simple list. */
/* The pill wraps the link and its chevron together — the chevron is part of
   the control, not a separate thing floating beside it. The <a> and the
   <button> stay separate elements: one navigates, one opens the panel. */
/* Measured so the chevron reads as part of its label and every pill is even:
   label to chevron 7px, 14px of air inside both ends of every pill (matching
   Home, which has no chevron), 32px between every pair of items. The glyph
   sits about 4px inside its 16px box, hence the 3px and 10px. The chevron was
   13px in the paler --ink-3, 11px off its label, so it read as loose clutter
   and the items looked unevenly spaced. */
.navitem.has-sub {
  position: relative; display: inline-flex; align-items: center; gap: 0;
  padding-right: 10px; border-radius: 999px;
  transition: background .2s;
}
.navitem.has-sub > .navlink { padding-right: 3px; }
.navitem.has-sub > .navlink:hover { background: none; }
.navitem.has-sub:hover { background: var(--bg-soft); }
.navitem.has-sub:hover > .navlink { color: var(--ink); }
.navitem.has-sub .subtoggle {
  display: inline-grid; place-items: center;
  width: 16px; height: 16px; border-radius: 50%;
  color: var(--ink-2); transition: transform .18s ease, color .18s;
}
.navitem.has-sub:hover .subtoggle,
.navitem.has-sub.is-open .subtoggle { color: var(--ink); }
/* A chevron turning up reads as "this is open". The old plus rotated into an
   ×, which says "close" — the wrong idea for a disclosure. */
.navitem.has-sub.is-open .subtoggle { transform: rotate(180deg); }

.subnav {
  position: absolute; top: calc(100% + 10px); left: -7px; z-index: 60;
  min-width: 260px; max-width: 320px; padding: 8px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 60px -12px rgba(14, 19, 17, 0.18), 0 2px 6px rgba(14, 19, 17, 0.05);
  opacity: 0; visibility: hidden; transform: translateY(-8px) scale(.99);
  transform-origin: top center;
  transition: opacity .18s ease, transform .18s cubic-bezier(.2,.7,.3,1), visibility .18s;
}
.navitem.has-sub:hover .subnav,
.navitem.has-sub:focus-within .subnav,
.navitem.has-sub.is-open .subnav {
  opacity: 1; visibility: visible; transform: translateY(0) scale(1);
}
/* Bridges the gap between trigger and panel so the pointer can travel down. */
.navitem.has-sub::after {
  content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 14px;
}

.subnav-list { list-style: none; margin: 0; padding: 0; }
.subnav-list > li { margin: 0; }
.subnav-list a {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 12px; border-radius: 9px;
  font-size: 14.5px; line-height: 1.25; color: var(--ink-2);
  transition: background .15s, color .15s;
}
.subnav-list a > span { flex: 1; min-width: 0; }
.subnav-list a:hover { background: var(--bg-soft); color: var(--ink); }
.subnav-list a.is-active { color: var(--grn-2); font-weight: 600; background: var(--grn-soft); }

/* How many pages sit under this one. A quiet count is more use than listing
   them all: it says "there is more here" without spending 60 lines saying it. */
.subnav-count {
  flex: none; font-family: var(--font-mono); font-style: normal;
  font-size: 10.5px; line-height: 1; color: var(--ink-3);
  padding: 3px 6px; border-radius: 999px; background: var(--bg-sunk);
}
.subnav-list a:hover .subnav-count { background: var(--line); color: var(--ink-2); }
.subnav-list a.is-active .subnav-count { background: rgba(79,162,42,.14); color: var(--grn-2); }

.subnav-all {
  display: flex; align-items: center; gap: 8px;
  margin-top: 6px; padding: 11px 12px;
  border-top: 1px solid var(--line); border-radius: 0 0 12px 12px;
  font-family: var(--font-mono); font-size: 12px;
  text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3);
}
.subnav-all em {
  font-style: normal; margin-left: auto; font-size: 11px; color: var(--ink-3);
}
.subnav-all:hover { background: var(--bg-soft); color: var(--grn-2); }

/* Mega panel. An explicit grid, not CSS `columns` — column flow broke groups
   across the fold and made the panel taller than the viewport. */
.navitem.is-mega { position: static; }
.subnav-mega {
  left: 50%; transform: translate(-50%, -8px) scale(.99);
  /* The content box: the same left and right edges as the page below. */
  width: min(calc(var(--container) - 2 * var(--pad)), calc(100% - 2 * var(--pad)));
  max-width: none; padding: 20px;
  display: grid; grid-template-columns: 1fr 260px; gap: 20px;
  align-items: start;
}
.navitem.is-mega:hover .subnav-mega,
.navitem.is-mega:focus-within .subnav-mega,
.navitem.is-mega.is-open .subnav-mega { transform: translate(-50%, 0) scale(1); }
.subnav-mega .subnav-list {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px 8px; align-content: start;
}
.subnav-mega .subnav-all {
  grid-column: 1 / -1; margin-top: 4px; border-radius: 10px;
  background: var(--bg-softer);
}

/* The panel's own next step. A clinic menu should offer a way in, not only a
   list of destinations. */
.mega-aside {
  display: flex; flex-direction: column; gap: 12px;
  padding: 18px; border-radius: 12px;
  background: var(--bg-soft); border: 1px solid var(--line);
}
.mega-aside-title {
  margin: 0; font-family: var(--font-display); font-weight: 600;
  font-size: 16px; letter-spacing: -.01em; color: var(--ink);
}
.mega-aside-body { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-3); }
.mega-aside-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  margin-top: 2px; padding: 12px 16px; border-radius: 999px;
