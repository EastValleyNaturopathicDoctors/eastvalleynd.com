---
import Icon from './Icon.astro';
import { site, topBarLinks } from '../data/site';

/**
 * "Accepting new patients — May 2026" does not fit beside the phone number on a
 * 375px screen; both were wrapping to two lines. The qualifier after the dash
 * is the part that can go, so it is split out and hidden on small screens,
 * leaving "Accepting new patients" and the number on one clean line.
 */
const [statusHead, ...statusRest] = site.status.split('—');
const statusTail = statusRest.join('—').trim();
---
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span class="topbar-status">
        <span class="status-dot"></span>
        <span>{statusHead.trim()}{statusTail && <span class="topbar-status-tail"> — {statusTail}</span>}</span>
      </span>
    </div>
    <div class="topbar-right">
      {topBarLinks.map((l) => <a href={l.href} class="topbar-link">{l.label}</a>)}
      <a href={site.phoneHref} class="topbar-phone">
        <Icon name="phone" size={14} />{site.phone}
      </a>
    </div>
  </div>
</div>

<style is:global>
.topbar {
  background: var(--ink);
  color: rgba(255,255,255,0.78);
  font-size: 12.5px;
  letter-spacing: 0.01em;
}
.topbar-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 38px; gap: 16px;
}
.topbar-status { display: inline-flex; align-items: center; gap: 8px; }
.status-dot { width: 7px; height: 7px; background: var(--grn); border-radius: 50%; box-shadow: 0 0 0 4px rgba(108,190,63,0.18); animation: pulse 2.5s infinite; }
@keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(108,190,63,0); } }
.topbar-right { display: flex; gap: var(--space-5); align-items: center; }
.topbar-link { color: rgba(255,255,255,0.7); transition: color .2s; }
.topbar-link:hover { color: #fff; }
.topbar-phone { display: inline-flex; align-items: center; gap: var(--space-2); color: #fff; font-weight: 500; font-family: var(--font-mono); font-size: 12px; }

@media (max-width: 900px) {
  .topbar-right .topbar-link { display: none; }
}

/* 119px of the viewport was header on a 375px phone. */
@media (max-width: 560px) {
  .topbar-inner { height: 34px; gap: var(--space-2); }
  .topbar-status-tail { display: none; }
  .topbar-status, .topbar-phone { white-space: nowrap; }
  .topbar-phone { flex: none; }
  .topbar { font-size: 12px; }
}
</style>
