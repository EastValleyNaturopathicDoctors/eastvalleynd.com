---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { getCollection } from 'astro:content';
// Counted from the roster, so it can't drift from /physicians/ (D126). Not
// "licensed": the roster includes a holistic nutrition practitioner.
const practitioners = (await getCollection('physicians')).length;
---
<section class="hero" id="home">
  {/* A generated, slowly flowing field in the brand greens (D128), drawn live
      with WebGL in place of the old YouTube background. The gradient on
      .hero-bg is what shows before the first frame, without WebGL, and in
      print; reduced-motion visitors get one still frame. */}
  <div class="hero-bg" id="heroBg">
    <canvas class="hero-flow" aria-hidden="true"></canvas>
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <Eyebrow>
        <Icon name="leaf" size={14} />
        <span>Mesa, AZ · since 2008 · whole-person medicine</span>
      </Eyebrow>
      <h1 class="hero-title">Medicine that listens, treats, and restores.</h1>
      <p class="hero-sub">
        East Valley Naturopathic Doctors is a Mesa, AZ clinic of board-licensed NMDs who treat
        the root cause — whether you're sick and tired of being sick, or building the next 40
        years of your healthspan.
      </p>
      <div class="hero-cta">
        <Button href="/new-patient-appointment-request/" variant="light" icon="arrow-right" size="lg">Book a new patient visit</Button>
        <a href="/about/" class="play-link">
          <span class="play-circle"><Icon name="arrow-right" size={14} /></span>
          How we work
        </a>
      </div>
      <div class="hero-meta">
        <div><b>{practitioners}</b><span>practitioners</span></div>
        <div><b>18,000+</b><span>patients treated</span></div>
        <div><b>4.9★</b><span>Google rating</span></div>
      </div>
    </div>
  </div>

  <div class="hero-paths-wrap">
    <div class="container">
      <div class="hero-paths-label">
        <Icon name="arrow-right" size={14} />
        Start by telling us why you're here
      </div>
      <div class="dualpath">
        <a class="dp-card dp-treat" href="/conditions/">
          <div class="dp-top">
            <span class="dp-num">01</span>
            <span class="dp-tag"><Icon name="stetho" size={14} />For patients</span>
          </div>
          <h2 class="dp-title">Diagnosing &amp; treating health conditions</h2>
          <p class="dp-sub">I'm dealing with symptoms, a diagnosis, or a chronic condition and I want answers and a real plan.</p>
          <div class="dp-tags">
            <span>Chronic fatigue</span><span>Lyme &amp; mold</span><span>GI</span>
            <span>Autoimmune</span><span>Brain injury</span><span>+10 more</span>
          </div>
          <span class="dp-go">Start treatment path<Icon name="arrow-right" size={16} /></span>
        </a>
        <a class="dp-card dp-optimize" href="#optimize">
          <div class="dp-top">
            <span class="dp-num">02</span>
            <span class="dp-tag"><Icon name="sparkle" size={14} />For optimizers</span>
          </div>
          <h2 class="dp-title">Optimizing health</h2>
          <p class="dp-sub">I'm well, but I want to perform, recover, age, or feel better than "normal labs" allow.</p>
          <div class="dp-tags">
            <span>Peptides</span><span>Hormone therapy</span><span>NAD+</span>
            <span>PRP</span><span>Longevity labs</span><span>Semaglutide</span>
          </div>
          <span class="dp-go">Start optimization path<Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* Domain-warped noise (fbm feeding fbm feeding fbm): the field folds and
     drifts like ink in water. Rendered at a fraction of the screen's
     resolution — the image is soft by nature, so nobody can tell — and only
     while the hero is on screen and the tab is visible. */
  const bg = document.getElementById('heroBg');
  const canvas = bg?.querySelector<HTMLCanvasElement>('.hero-flow');
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });

  const VERT = `attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}`;
  const FRAG = `
    precision mediump float;
    uniform vec2 res; uniform float t;
    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float n(vec2 p){
      vec2 i = floor(p), f = fract(p); f = f*f*(3.-2.*f);
      return mix(mix(h(i), h(i+vec2(1,0)), f.x), mix(h(i+vec2(0,1)), h(i+vec2(1,1)), f.x), f.y);
    }
    float fbm(vec2 p){
      float v = 0., a = .5; mat2 r = mat2(.8, .6, -.6, .8);
      for (int i = 0; i < 5; i++){ v += a*n(p); p = r*p*2.03 + 7.1; a *= .5; }
      return v;
    }
    void main(){
      vec2 uv = gl_FragCoord.xy / res;
      vec2 p = (gl_FragCoord.xy - .5*res) / res.y * 1.05;
      float T = t * .045;
      vec2 q = vec2(fbm(p + vec2(0., T)), fbm(p + vec2(5.2, 1.3) - T*.8));
      vec2 s = vec2(fbm(p + 3.2*q + vec2(1.7, 9.2) + T*1.2), fbm(p + 3.2*q + vec2(8.3, 2.8) - T));
      float f = fbm(p + 3.4*s);
      vec3 ink    = vec3(.055, .075, .067);   // --ink
      vec3 deep   = vec3(.06, .20, .12);
      vec3 forest = vec3(.16, .42, .20);
      vec3 leaf   = vec3(.42, .75, .25);      // --grn
      vec3 teal   = vec3(.06, .30, .30);
      vec3 col = mix(ink, deep, clamp(f*f*2.2, 0., 1.));
      col = mix(col, forest, smoothstep(.45, 1.05, length(q)) * .85);
      col = mix(col, teal, smoothstep(.45, .85, s.y) * .45);
      col = mix(col, leaf, smoothstep(.55, .9, f) * .7);
      col *= .62 + .6*uv.x;                   // quieter on the left, under the copy
      col *= 1. - .3*pow(1. - uv.y, 2.);      // settle toward the path cards
      col += (h(gl_FragCoord.xy + t) - .5) / 255.;  // dither: no banding in the darks
      gl_FragColor = vec4(col, 1.);
    }`;

  function build(g: WebGLRenderingContext) {
    const sh = (type: number, src: string) => {
      const x = g.createShader(type)!; g.shaderSource(x, src); g.compileShader(x);
      return g.getShaderParameter(x, g.COMPILE_STATUS) ? x : null;
    };
    const v = sh(g.VERTEX_SHADER, VERT), f = sh(g.FRAGMENT_SHADER, FRAG);
    if (!v || !f) return null;
    const prog = g.createProgram()!;
    g.attachShader(prog, v); g.attachShader(prog, f); g.linkProgram(prog);
    if (!g.getProgramParameter(prog, g.LINK_STATUS)) return null;
    g.useProgram(prog);
    g.bindBuffer(g.ARRAY_BUFFER, g.createBuffer());
    g.bufferData(g.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), g.STATIC_DRAW);
    const loc = g.getAttribLocation(prog, 'p');
    g.enableVertexAttribArray(loc);
    g.vertexAttribPointer(loc, 2, g.FLOAT, false, 0, 0);
    return { res: g.getUniformLocation(prog, 'res'), t: g.getUniformLocation(prog, 't') };
  }

  const u = gl && build(gl);
  if (bg && canvas && gl && u) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Soft by design, so draw it at about half the CSS size and let the
    // browser scale it up; nobody can tell, and the GPU does a quarter of the work.
    const scale = () => (window.innerWidth < 900 ? 0.45 : 0.5);
    const t0 = performance.now() - 40000;   // start mid-flow, not from a blank seed
    const size = () => {
      const w = Math.max(1, Math.round(canvas.clientWidth * scale()));
      const h = Math.max(1, Math.round(canvas.clientHeight * scale()));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h);
      }
      gl.uniform2f(u.res, w, h);
    };
    const draw = (now: number) => {
      size();
      gl.uniform1f(u.t, (now - t0) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    let raf = 0, onScreen = true;
    const loop = (now: number) => { draw(now); raf = requestAnimationFrame(loop); };
    const run = () => {
      if (still || raf || !onScreen || document.hidden) return;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    draw(performance.now());
    bg.classList.add('flow-ready');
    if (!still) {
      new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; onScreen ? run() : stop(); })
        .observe(bg);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : run()));
      run();
    }
    window.addEventListener('resize', () => { if (!raf) draw(performance.now()); }, { passive: true });
  }
</script>

<style is:global>
.hero {
  position: relative;
  background: var(--ink);
  color: #fff;
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; z-index: 0; }
/* Before the first frame, without WebGL, and in print: the brand's dark gradient. */
.hero-bg {
  background:
    radial-gradient(120% 80% at 78% 8%, rgba(108, 190, 63, 0.16) 0%, rgba(108, 190, 63, 0) 60%),
    linear-gradient(to bottom, #141A17 0%, #0E1311 60%, #0A0E0C 100%);
}
.hero-flow {
  position: absolute; inset: 0; width: 100%; height: 100%;
  display: block; opacity: 0; transition: opacity 900ms ease;
}
.flow-ready .hero-flow { opacity: 1; }
@media (prefers-reduced-motion: reduce) { .hero-flow { transition: none; } }
/* On a phone the copy runs the full width, so the lighter right-hand currents
   sit under words too: an even veil keeps them readable. */
@media (max-width: 900px) {
  .hero-overlay { background: linear-gradient(to bottom, rgba(14, 19, 17, 0.38), rgba(14, 19, 17, 0.62)); }
}
.hero-overlay {
  position: absolute; inset: 0;
  /* The field already darkens toward the copy; this keeps the headline and the
     stat row comfortably legible whatever the flow is doing under them. */
  background:
    linear-gradient(95deg, rgba(14, 19, 17, 0.55) 0%, rgba(14, 19, 17, 0.28) 45%, rgba(14, 19, 17, 0) 75%),
    linear-gradient(to bottom, rgba(14, 19, 17, 0) 55%, rgba(14, 19, 17, 0.6) 100%);
}
.hero-inner {
  position: relative; z-index: 2;
  padding: clamp(80px, 12vw, 160px) var(--pad) clamp(50px, 6vw, 80px);
  min-height: 720px;
  display: flex;
  align-items: center;
}
.hero-content { max-width: 820px; }
.hero .eyebrow {
  color: #fff;
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
}
.hero-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(44px, 7.2vw, 104px);
  line-height: 0.98;
  letter-spacing: -0.028em;
  margin: 22px 0 22px;
  text-wrap: balance;
}
.hero-sub {
  font-size: clamp(17px, 1.4vw, 22px);
  line-height: 1.45;
  max-width: 60ch;
  color: rgba(255,255,255,0.82);
}

.play-link {
  display: inline-flex; align-items: center; gap: 12px;
  color: #fff; font-size: 14px;
}
.play-circle {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.5);
  display: inline-flex; align-items: center; justify-content: center;
  transition: background .2s;
}
.play-link:hover .play-circle { background: rgba(255,255,255,0.16); }
.hero-meta {
  display: flex; gap: clamp(24px, 4vw, 56px);
  margin-top: 56px;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.18);
  max-width: 620px;
}
.hero-meta div { display: flex; flex-direction: column; gap: 4px; }
.hero-meta b { font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 42px); font-weight: 500; }
.hero-meta span { font-size: 12px; color: rgba(255,255,255,0.62); letter-spacing: 0.03em; text-transform: uppercase; font-family: var(--font-mono); }

/* DUAL PATH */
.hero-paths-wrap {
  position: relative; z-index: 3;
  padding: 0 0 clamp(48px, 6vw, 80px);
}
.hero-paths-label {
  display: inline-flex; align-items: center; gap: 8px;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  margin-bottom: 18px;
}
.dualpath {
  display: grid; grid-template-columns: 1fr 1fr; gap: 18px;
}
.dp-card {
  position: relative;
  text-align: left;
  background: rgba(255,255,255,0.96);
  color: var(--ink);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: 30px 32px 28px;
  display: flex; flex-direction: column; gap: 14px;
  transition: transform .25s ease, box-shadow .25s ease, background .25s;
  overflow: hidden;
  cursor: pointer;
}
.dp-card::before {
  content: "";
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 6px;
  background: var(--grn);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform .35s ease;
}
.dp-treat::before { background: var(--blu); }
.dp-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -25px rgba(0,0,0,0.4); }
.dp-card:hover::before, .dp-card.is-active::before { transform: scaleY(1); }
.dp-card.is-active { background: var(--ink); color: #fff; border-color: transparent; }
.dp-card.is-active .dp-num,
.dp-card.is-active .dp-tag,
.dp-card.is-active .dp-tags span { color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.18); }
.dp-card.is-active .dp-sub { color: rgba(255,255,255,0.78); }
.dp-card.is-active .dp-go { color: #fff; }
.dp-top { display: flex; align-items: center; justify-content: space-between; }
.dp-num { font-family: var(--font-mono); font-size: 13px; color: var(--ink-3); letter-spacing: 0.06em; }
.dp-tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink-3);
  padding: 5px 10px; border-radius: 999px;
  border: 1px solid var(--line);
}
.dp-title {
  font-family: var(--font-display);
  font-size: clamp(24px, 2.6vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-weight: 600;
  margin: 0;
}
.dp-sub { color: var(--ink-2); margin: 0; font-size: 15.5px; line-height: 1.5; max-width: 46ch; }
.dp-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.dp-tags span {
  font-size: 12px;
  padding: 4px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-3);
}
.dp-go {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: auto;
  padding-top: 12px;
  font-weight: 600;
  color: var(--ink);
}
.dp-treat .dp-go { color: #176E92; }
.dp-treat.is-active .dp-go { color: var(--blu); }
.dp-optimize .dp-go { color: var(--grn-2); }
.dp-optimize.is-active .dp-go { color: var(--grn); }

@media (max-width: 800px) {
  .dualpath { grid-template-columns: 1fr; }
  .hero-meta { gap: 24px; flex-wrap: wrap; }
}

</style>
