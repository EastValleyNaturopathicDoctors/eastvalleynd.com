---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { Image } from 'astro:assets';
import team from '../images/site/hero-team.jpg';
import { getCollection } from 'astro:content';
// Counted from the roster, so it can't drift from /physicians/ (D126). Not
// "licensed": the roster includes a holistic nutrition practitioner.
const practitioners = (await getCollection('physicians')).length;
---
<section class="hero" id="home" data-hero="1">
  {/* The brand green mixed with sky blue (#01B9EB): two soft glows drifting
      over a deep teal, CSS only. Three ways to set the filter over the team
      in motion, as Option 1 / 2 / 3 for the clinic to compare (Oct 2026):
      1 Drift (livelier glows, the photo slowly breathing), 2 Aurora (bands of
      light sweeping across), 3 Spotlight (natural colour following the
      pointer, drifting on its own when idle). Once one is picked, the other
      two and the switcher go. */}
  <div class="hero-bg">
    {/* The clinic's own team, across the top of a desktop hero; decorative here
        (the About page carries it with its description), so alt is empty. The
        second copy is Option 3's spotlight, in natural colour. */}
    <div class="hero-photo" aria-hidden="true">
      <Image src={team} alt="" width={1600} loading="eager" fetchpriority="high" />
      <div class="hero-photo-color"><Image src={team} alt="" width={1600} loading="eager" /></div>
    </div>
    <div class="hero-aurora" aria-hidden="true"></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <Eyebrow>
        <Icon name="leaf" size={14} />
        <span>Mesa, AZ · since 2008 · whole-person medicine</span>
      </Eyebrow>
      <h1 class="hero-title">Medicine that listens, treats, and restores.</h1>
      <p class="hero-sub">
        East Valley Naturopathic Doctors is a Mesa, AZ clinic of board-licensed NMDs who treat
        the root cause — whether you're sick and tired of being sick, or building the next 40
        years of your healthspan.
      </p>
      <div class="hero-cta">
        <Button href="/new-patient-appointment-request/" variant="light" icon="arrow-right" size="lg">Book a new patient visit</Button>
        <a href="/about/" class="play-link">
          <span class="play-circle"><Icon name="arrow-right" size={14} /></span>
          How we work
        </a>
      </div>
      <div class="hero-meta">
        <div><b>{practitioners}</b><span>practitioners</span></div>
        <div><b>19,000+</b><span>patients treated</span></div>
        <div><b>4.9★</b><span>Google rating</span></div>
      </div>
    </div>
  </div>

  <div class="hero-paths-wrap">
    <div class="container">
      <div class="hero-paths-top">
        <div class="hero-paths-label">
          <Icon name="arrow-right" size={14} />
          Start by telling us why you're here
        </div>
        <div class="hero-switch" role="group" aria-label="Hero style">
          {[1, 2, 3].map((n) => (
            <button type="button" data-v={n} aria-pressed={n === 1 ? 'true' : 'false'}>Option {n}</button>
          ))}
        </div>
      </div>
      <div class="dualpath">
        <a class="dp-card dp-treat" href="/conditions/">
          <div class="dp-top">
            <span class="dp-num">01</span>
            <span class="dp-tag"><Icon name="stetho" size={14} />For patients</span>
          </div>
          <h2 class="dp-title">Diagnosing &amp; treating health conditions</h2>
          <p class="dp-sub">I'm dealing with symptoms, a diagnosis, or a chronic condition and I want answers and a real plan.</p>
          <div class="dp-tags">
            <span>Chronic fatigue</span><span>Lyme &amp; mold</span><span>GI</span>
            <span>Autoimmune</span><span>Brain injury</span><span>+10 more</span>
          </div>
          <span class="dp-go">Start treatment path<Icon name="arrow-right" size={16} /></span>
        </a>
        <a class="dp-card dp-optimize" href="#optimize">
          <div class="dp-top">
            <span class="dp-num">02</span>
            <span class="dp-tag"><Icon name="sparkle" size={14} />For optimizers</span>
          </div>
          <h2 class="dp-title">Optimizing health</h2>
          <p class="dp-sub">I'm well, but I want to perform, recover, age, or feel better than "normal labs" allow.</p>
          <div class="dp-tags">
            <span>Hormone therapy</span><span>NAD+</span><span>PRP</span>
            <span>IV therapy</span><span>Neurofeedback</span><span>Semaglutide</span>
          </div>
          <span class="dp-go">Start optimization path<Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The hero style switcher (Option 1 / 2 / 3), kept in the address as
  // #hero-2 so a link can open one, and Option 3's spotlight following the
  // pointer over the team photo.
  const hero = document.querySelector<HTMLElement>('.hero[data-hero]');
  if (hero) {
    const buttons = [...hero.querySelectorAll<HTMLButtonElement>('.hero-switch button')];
    const set = (v: string, keep = false) => {
      hero.dataset.hero = v;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
      if (keep) history.replaceState(null, '', v === '1' ? location.pathname + location.search : `#hero-${v}`);
    };
    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.v ?? '1', true)));
    const fromHash = () => /^#hero-([123])$/.exec(location.hash)?.[1];
    if (fromHash()) set(fromHash()!);
    window.addEventListener('hashchange', () => { if (fromHash()) set(fromHash()!); });

    const photo = hero.querySelector<HTMLElement>('.hero-photo');
    let idle = 0;
    hero.addEventListener('pointermove', (e) => {
      if (hero.dataset.hero !== '3' || !photo || e.pointerType === 'touch') return;
      const r = photo.getBoundingClientRect();
      hero.style.setProperty('--sx', `${((e.clientX - r.left) / r.width) * 100}%`);
      hero.style.setProperty('--sy', `${((e.clientY - r.top) / r.height) * 100}%`);
      hero.classList.add('is-pointing');
      window.clearTimeout(idle);
      idle = window.setTimeout(() => { hero.classList.remove('is-pointing'); hero.style.removeProperty('--sx'); hero.style.removeProperty('--sy'); }, 2500);
    });
  }
</script>

<style is:global>
.hero {
  position: relative;
  background: var(--ink);
  color: #fff;
  overflow: hidden;
}
/* The brand green with sky blue (#01B9EB): two soft glows drift slowly over a
   deep teal that warms toward green. The overlay keeps the copy side calm so
   white type reads cleanly. */
.hero-bg {
  position: absolute; inset: 0; z-index: 0; overflow: hidden;
  background:
    radial-gradient(55% 75% at 88% 12%, rgba(1, 185, 235, 0.70) 0%, rgba(1, 185, 235, 0) 62%),
    radial-gradient(50% 70% at 70% 95%, rgba(108, 190, 63, 0.65) 0%, rgba(108, 190, 63, 0) 60%),
    linear-gradient(115deg, #052E39 0%, #08495A 38%, #0A6A6C 72%, #128A63 100%);
}
.hero-bg::before,
.hero-bg::after {
  content: ''; position: absolute; border-radius: 50%;
  filter: blur(70px); opacity: 0.55; will-change: transform;
}
.hero-bg::before {
  width: 48vw; height: 48vw; right: -10vw; top: -14vw; background: #01B9EB;
  animation: hero-drift-a 28s ease-in-out infinite alternate;
}
.hero-bg::after {
  width: 40vw; height: 40vw; right: 16vw; bottom: -20vw; background: #6CBE3F;
  animation: hero-drift-b 34s ease-in-out infinite alternate;
}
@keyframes hero-drift-a { to { transform: translate(-7vw, 6vw) scale(1.08); } }
@keyframes hero-drift-b { to { transform: translate(8vw, -5vw) scale(0.92); } }

/* Option 1, Drift: the glows wander further and faster, and the team photo
   breathes, a slow push in and out. */
.hero[data-hero="1"] .hero-bg::before { animation: hero-drift-a1 16s ease-in-out infinite alternate; opacity: 0.65; }
.hero[data-hero="1"] .hero-bg::after { animation: hero-drift-b1 19s ease-in-out infinite alternate; opacity: 0.6; }
.hero[data-hero="1"] .hero-photo > img { animation: hero-breathe 22s ease-in-out infinite alternate; transform-origin: 70% 30%; }
@keyframes hero-drift-a1 { 50% { transform: translate(-16vw, 10vw) scale(1.15); } to { transform: translate(-4vw, 16vw) scale(0.95); } }
@keyframes hero-drift-b1 { 50% { transform: translate(14vw, -8vw) scale(0.9); } to { transform: translate(-6vw, -14vw) scale(1.12); } }
@keyframes hero-breathe { to { transform: scale(1.07) translateX(-1.5%); } }

/* Option 2, Aurora: wide bands of sky blue and green sweep across the team,
   lightening what they pass over. */
.hero-aurora { display: none; }
.hero[data-hero="2"] .hero-aurora {
  /* Twice the pattern side by side, slid left by one: a seamless loop that
     moves on the GPU instead of repainting the hero every frame. */
  display: block; position: absolute; top: 0; bottom: 0; left: 0; width: 300%; pointer-events: none;
  background: linear-gradient(110deg,
    rgba(1, 185, 235, 0) 0%, rgba(1, 185, 235, 0.55) 12%, rgba(108, 190, 63, 0.5) 22%, rgba(108, 190, 63, 0) 32%,
    rgba(1, 185, 235, 0) 50%, rgba(1, 185, 235, 0.5) 62%, rgba(108, 190, 63, 0.5) 72%, rgba(108, 190, 63, 0) 82%, rgba(1, 185, 235, 0) 100%)
    0 0 / 50% 100% repeat-x;
  mix-blend-mode: screen; opacity: 0.55; will-change: transform;
  animation: hero-aurora 22s linear infinite;
}
@keyframes hero-aurora { to { transform: translateX(-50%); } }

/* Option 3, Spotlight: the team in natural colour inside a soft circle that
   follows the pointer, and drifts across them on its own when idle. */
@property --sx { syntax: '<percentage>'; inherits: true; initial-value: 72%; }
@property --sy { syntax: '<percentage>'; inherits: true; initial-value: 38%; }
.hero-photo-color { display: none; }
.hero[data-hero="3"] .hero-photo-color {
  display: block; position: absolute; inset: 0;
  -webkit-mask-image: radial-gradient(circle 260px at var(--sx) var(--sy), #000 30%, transparent 100%);
  mask-image: radial-gradient(circle 260px at var(--sx) var(--sy), #000 30%, transparent 100%);
  animation: hero-spot 14s ease-in-out infinite alternate;
}
.hero[data-hero="3"].is-pointing .hero-photo-color { animation: none; transition: --sx .25s ease-out, --sy .25s ease-out; }
.hero-photo-color img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; opacity: 0.9; }
@keyframes hero-spot {
  0% { --sx: 52%; --sy: 32%; }
  35% { --sx: 70%; --sy: 48%; }
  70% { --sx: 84%; --sy: 30%; }
  100% { --sx: 96%; --sy: 44%; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-bg::before, .hero-bg::after, .hero-photo > img, .hero-aurora, .hero-photo-color { animation: none !important; }
}
.hero-overlay {
  position: absolute; inset: 0;
  background:
    linear-gradient(95deg, rgba(3, 32, 40, 0.55) 0%, rgba(3, 32, 40, 0.22) 48%, rgba(3, 32, 40, 0) 75%),
    linear-gradient(to bottom, rgba(3, 32, 40, 0) 55%, rgba(3, 32, 40, 0.45) 100%);
}
/* On a phone the copy runs the full width, so an even veil keeps it readable. */
@media (max-width: 900px) {
  .hero-overlay { background: linear-gradient(to bottom, rgba(3, 32, 40, 0.35), rgba(3, 32, 40, 0.55)); }
}
.hero-inner {
  position: relative; z-index: 2;
  /* The showcase hero's top inset is its own (spacing spec 1.4); the stat row
     sits one block above the path cards. */
  padding: clamp(80px, 12vw, 160px) var(--pad) var(--space-block);
  min-height: 720px;
  display: flex;
  align-items: center;
}
.hero-content { max-width: 820px; }
.hero .eyebrow {
  color: #fff;
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
}
.hero-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(44px, 7.2vw, 104px);
  line-height: 0.98;
  letter-spacing: -0.028em;
  margin: 0;               /* label -> title 16 comes from global.css */
  text-wrap: balance;
}
.hero-sub {
  font-size: clamp(17px, 1.4vw, 22px);
  line-height: 1.45;
  max-width: 60ch;
  color: rgba(255,255,255,0.82);
  margin: 0;
}
/* Title -> text 20, then the button row's 32 (.hero-cta). */
.hero-title + .hero-sub { margin-top: var(--space-5); }

.play-link {
  display: inline-flex; align-items: center; gap: 12px;
  color: #fff; font-size: 14px;
}
.play-circle {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.5);
  display: inline-flex; align-items: center; justify-content: center;
  transition: background .2s;
}
.play-link:hover .play-circle { background: rgba(255,255,255,0.16); }
.hero-meta {
  display: flex; gap: var(--gap-cols);
  margin-top: var(--space-8);
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255,255,255,0.18);
  max-width: 620px;
}
.hero-meta div { display: flex; flex-direction: column; gap: 4px; }
.hero-meta b { font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 42px); font-weight: 500; }
.hero-meta span { font-size: 12px; color: rgba(255,255,255,0.62); letter-spacing: 0.03em; text-transform: uppercase; font-family: var(--font-mono); }

/* DUAL PATH */
.hero-paths-wrap {
  position: relative; z-index: 3;
  padding: 0 0 var(--space-hero-bottom);
}
.hero-paths-top {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.hero-paths-top .hero-paths-label { margin-bottom: 0; }
.hero-switch {
  display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px;
  background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.18); backdrop-filter: blur(6px);
}
.hero-switch button {
  padding: 6px 12px; border: 0; border-radius: 999px; background: transparent; cursor: pointer;
  font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75);
  transition: background .18s, color .18s;
}
.hero-switch button:hover { color: #fff; }
.hero-switch button[aria-pressed="true"] { background: #fff; color: var(--ink); }
.hero-switch button:focus-visible { outline: 2px solid var(--grn); outline-offset: 2px; }

/* The homepage hero rises in on load like every page's top (global.css). */
@media (prefers-reduced-motion: no-preference) {
  .hero-content > .eyebrow { animation: page-rise .55s cubic-bezier(.2, .7, .2, 1) both; }
  .hero-content > .hero-title { animation: page-rise-title .65s cubic-bezier(.2, .7, .2, 1) 70ms both; }
  .hero-content > .hero-sub { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 160ms both; }
  .hero-content > .hero-cta { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 240ms both; }
  .hero-content > .hero-meta { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 320ms both; }
  .hero-paths-wrap { animation: page-rise .7s cubic-bezier(.2, .7, .2, 1) 380ms both; }
}

.hero-paths-label {
  display: inline-flex; align-items: center; gap: 8px;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  margin-bottom: var(--space-4);
}
.dualpath {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-cards);
}
.dp-card {
  position: relative;
  text-align: left;
  background: rgba(255,255,255,0.96);
  color: var(--ink);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: var(--pad-feature);
  /* Margins, not a flex gap: number row -> title 16, title -> text 8, text ->
     tags 16, and the link pinned to the foot 16 under whatever is tallest. */
  display: flex; flex-direction: column; gap: 0;
  transition: transform .25s ease, box-shadow .25s ease, background .25s;
  overflow: hidden;
  cursor: pointer;
}
.dp-card::before {
  content: "";
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 6px;
  background: var(--grn);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform .35s ease;
}
.dp-treat::before { background: var(--blu); }
.dp-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -25px rgba(0,0,0,0.4); }
.dp-card:hover::before, .dp-card.is-active::before { transform: scaleY(1); }
.dp-card.is-active { background: var(--ink); color: #fff; border-color: transparent; }
.dp-card.is-active .dp-num,
.dp-card.is-active .dp-tag,
.dp-card.is-active .dp-tags span { color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.18); }
.dp-card.is-active .dp-sub { color: rgba(255,255,255,0.78); }
.dp-card.is-active .dp-go { color: #fff; }
.dp-top { display: flex; align-items: center; justify-content: space-between; }
.dp-num { font-family: var(--font-mono); font-size: 13px; color: var(--ink-3); letter-spacing: 0.06em; }
.dp-tag {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink-3);
  padding: 5px 10px; border-radius: 999px;
  border: 1px solid var(--line);
}
.dp-title {
  font-family: var(--font-display);
  font-size: clamp(24px, 2.6vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-weight: 600;
  margin: var(--space-4) 0 0;
}
.dp-sub { color: var(--ink-2); margin: var(--space-2) 0 0; font-size: 15.5px; line-height: 1.5; max-width: 46ch; }
.dp-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
.dp-tags span {
  font-size: 12px;
  padding: 4px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-3);
}
.dp-go {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: auto;
  padding-top: var(--space-4);
  font-weight: 600;
  color: var(--ink);
}
.dp-treat .dp-go { color: #176E92; }
.dp-treat.is-active .dp-go { color: var(--blu); }
.dp-optimize .dp-go { color: var(--grn-2); }
.dp-optimize.is-active .dp-go { color: var(--grn); }

@media (max-width: 800px) {
  .dualpath { grid-template-columns: 1fr; }
  .hero-meta { flex-wrap: wrap; }
}

/* The team photo across the top of a desktop hero, above the path cards: the
   photo is 2:1, so a full-width band shows nearly the whole team. It fades
   out to the left under the headline and toward the cards, and takes the
   field's colour (a duotone). Not on a phone, where the copy runs the full
   width over it. */
.hero-photo {
  position: absolute; top: 0; left: 0; right: 0; height: 70%;
  -webkit-mask-image: linear-gradient(to right, transparent 8%, #000 58%), linear-gradient(to bottom, #000 62%, transparent 100%);
  -webkit-mask-composite: source-in;
  mask-image: linear-gradient(to right, transparent 8%, #000 58%), linear-gradient(to bottom, #000 62%, transparent 100%);
  mask-composite: intersect;
}
.hero-photo > img {
  width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;
  filter: grayscale(1) contrast(1.05); mix-blend-mode: luminosity; opacity: 0.6;
}
@media (max-width: 900px) { .hero-photo { display: none; } }
</style>
