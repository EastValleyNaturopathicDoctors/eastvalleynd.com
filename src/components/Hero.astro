---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import posterJpg from '../images/site/hero-video-poster.jpg';
// Counted from the roster, so it can't drift from /physicians/ (D126). Not
// "licensed": the roster includes a holistic nutrition practitioner.
const practitioners = (await getCollection('physicians')).length;
// The video's first frame: shown while the video loads, and instead of it
// under reduced motion, without JavaScript, or when a phone won't autoplay.
const poster = await getImage({ src: posterJpg, format: 'webp', width: 1920, quality: 72 });
// The clinic's homepage video (Nov 2026, from its iPhone footage; HDR brought
// to standard colour). AV1 where the browser plays it, H.264 everywhere else,
// and 720p on phones. Served by worker/index.js so Safari gets byte ranges.
// A new cut gets a new date in the name (the files are cached for a year).
const V = '/videos/hero-2026-11';
---
<section class="hero" id="home">
  {/* The clinic's video, under a deep-teal veil so the white type reads. The
      brand gradient underneath shows until the poster loads. The team photo
      that sat here is off (src/images/site/hero-team.jpg is kept). */}
  <div class="hero-bg">
    <video class="hero-video" muted loop playsinline disablepictureinpicture preload="none"
      poster={poster.src} aria-hidden="true" tabindex="-1">
      <source src={`${V}-720.av1.mp4`} type='video/mp4; codecs="av01.0.08M.08"' media="(max-width: 900px)" />
      <source src={`${V}-720.h264.mp4`} type="video/mp4" media="(max-width: 900px)" />
      <source src={`${V}-1080.av1.mp4`} type='video/mp4; codecs="av01.0.08M.08"' />
      <source src={`${V}-1080.h264.mp4`} type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <Eyebrow>
        <Icon name="leaf" size={14} />
        <span>Mesa, AZ · since 2008 · whole-person medicine</span>
      </Eyebrow>
      <h1 class="hero-title">Medicine that listens, treats, and restores.</h1>
      <p class="hero-sub">
        East Valley Naturopathic Doctors is a Mesa, AZ clinic of board-licensed NMDs who treat
        the root cause — whether you're sick and tired of being sick, or building the next 40
        years of your healthspan.
      </p>
      <div class="hero-cta">
        <Button href="/new-patient-appointment-request/" variant="light" icon="arrow-right" size="lg">Request a new patient visit</Button>
        <a href="/about/" class="play-link">
          <span class="play-circle"><Icon name="arrow-right" size={14} /></span>
          How we work
        </a>
      </div>
      <div class="hero-meta">
        <div><b>{practitioners}</b><span>practitioners</span></div>
        <div><b>19,000+</b><span>patients treated</span></div>
        <div><b>4.9★</b><span>Google rating</span></div>
      </div>
    </div>
  </div>

  <div class="hero-paths-wrap">
    <div class="container">
      <div class="hero-paths-top">
        <div class="hero-paths-label">
          <Icon name="arrow-right" size={14} />
          Start by telling us why you're here
        </div>
        <button type="button" class="hero-pause" aria-pressed="false" hidden>
          <span class="hero-pause-icon" aria-hidden="true"></span>
          <span class="hero-pause-text">Pause video</span>
        </button>
      </div>
      <div class="dualpath">
        <a class="dp-card dp-treat" href="/conditions/">
          <div class="dp-top">
            <span class="dp-num">01</span>
            <span class="dp-tag"><Icon name="stetho" size={14} />For patients</span>
          </div>
          <h2 class="dp-title">Diagnosing &amp; treating health conditions</h2>
          <p class="dp-sub">I'm dealing with symptoms, a diagnosis, or a chronic condition and I want answers and a real plan.</p>
          <div class="dp-tags">
            <span>Chronic fatigue</span><span>Lyme &amp; mold</span><span>GI</span>
            <span>Autoimmune</span><span>Brain injury</span><span>+10 more</span>
          </div>
          <span class="dp-go">Start treatment path<Icon name="arrow-right" size={16} /></span>
        </a>
        <a class="dp-card dp-optimize" href="#optimize">
          <div class="dp-top">
            <span class="dp-num">02</span>
            <span class="dp-tag"><Icon name="sparkle" size={14} />For optimizers</span>
          </div>
          <h2 class="dp-title">Optimizing health</h2>
          <p class="dp-sub">I'm well, but I want to perform, recover, age, or feel better than "normal labs" allow.</p>
          <div class="dp-tags">
            <span>Hormone therapy</span><span>NAD+</span><span>PRP</span>
            <span>IV therapy</span><span>Neurofeedback</span><span>Semaglutide</span>
          </div>
          <span class="dp-go">Start optimization path<Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The hero video plays from here rather than `autoplay`, so it stays on its
  // poster under reduced motion. It pauses while scrolled out of view, and the
  // Pause button (moving content longer than 5s needs one, WCAG 2.2.2) keeps
  // it paused until pressed again. If the phone refuses to play (Low Power
  // Mode), the poster simply stays and the button stays hidden.
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const button = document.querySelector<HTMLButtonElement>('.hero-pause');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video && button && !still) {
    let held = false;
    let inView = true;
    const label = button.querySelector('.hero-pause-text');
    const show = () => {
      button.setAttribute('aria-pressed', String(held));
      if (label) label.textContent = held ? 'Play video' : 'Pause video';
    };
    const run = () => {
      if (held || !inView) { video.pause(); return; }
      video.play().then(() => { button.hidden = false; }).catch(() => {});
    };
    video.preload = 'auto';
    button.addEventListener('click', () => { held = !held; show(); run(); });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; run(); }).observe(video);
    document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); else run(); });
    run();
  }
</script>

<style is:global>
.hero {
  position: relative;
  background: var(--ink);
  color: #fff;
  overflow: hidden;
}
/* Under the video: the brand teal-to-green, all that shows until the poster
   loads. The veil keeps the copy side dark enough for white type over the
   clinic's bright rooms, and tints the footage toward the brand teal. */
.hero-bg {
  position: absolute; inset: 0; z-index: 0; overflow: hidden;
  background:
    radial-gradient(55% 75% at 88% 12%, rgba(1, 185, 235, 0.70) 0%, rgba(1, 185, 235, 0) 62%),
    radial-gradient(50% 70% at 70% 95%, rgba(108, 190, 63, 0.65) 0%, rgba(108, 190, 63, 0) 60%),
    linear-gradient(115deg, #052E39 0%, #08495A 38%, #0A6A6C 72%, #128A63 100%);
}
.hero-video {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  pointer-events: none;
}
.hero-overlay {
  position: absolute; inset: 0;
  background:
    linear-gradient(95deg, rgba(3, 32, 40, 0.86) 0%, rgba(3, 32, 40, 0.66) 45%, rgba(3, 32, 40, 0.38) 100%),
    linear-gradient(to bottom, rgba(3, 32, 40, 0) 50%, rgba(3, 32, 40, 0.6) 100%);
}
/* On a phone the copy runs the full width, so an even veil keeps it readable. */
@media (max-width: 900px) {
  .hero-overlay { background: linear-gradient(to bottom, rgba(3, 32, 40, 0.6) 0%, rgba(3, 32, 40, 0.7) 55%, rgba(3, 32, 40, 0.82) 100%); }
}
.hero-inner {
  position: relative; z-index: 2;
  /* The showcase hero's top inset is its own (spacing spec 1.4); the stat row
     sits one block above the path cards. */
  padding: clamp(80px, 12vw, 160px) var(--pad) var(--space-block);
  min-height: 720px;
  display: flex;
  align-items: center;
}
/* Everything from the eyebrow to the stat row on one column, up to 1000px
   (the clinic, Nov 2026). */
.hero-content { max-width: 1000px; }
.hero .eyebrow {
  color: #fff;
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
}
.hero-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(44px, 7.2vw, 104px);
  line-height: 0.98;
  letter-spacing: -0.01em;
  margin: 0;               /* label -> title 16 comes from global.css */
  text-wrap: balance;
}
.hero-sub {
  font-size: clamp(17px, 1.4vw, 22px);
  line-height: 1.45;
  color: rgba(255,255,255,0.82);
  margin: 0;
}
/* Title -> text 20, then the button row's 32 (.hero-cta). */
.hero-title + .hero-sub { margin-top: var(--space-5); }

.play-link {
  display: inline-flex; align-items: center; gap: 12px;
  color: #fff; font-size: 14px;
}
.play-circle {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.5);
  display: inline-flex; align-items: center; justify-content: center;
  transition: background .2s;
}
.play-link:hover .play-circle { background: rgba(255,255,255,0.16); }
.hero-meta {
  display: flex; gap: var(--gap-cols);
  margin-top: var(--space-8);
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255,255,255,0.18);
}
.hero-meta div { display: flex; flex-direction: column; gap: 4px; }
.hero-meta b { font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 42px); font-weight: 500; }
.hero-meta span { font-size: 12px; color: rgba(255,255,255,0.62); letter-spacing: 0.03em; text-transform: uppercase; font-family: var(--font-mono); }

/* DUAL PATH */
.hero-paths-wrap {
  position: relative; z-index: 3;
  padding: 0 0 var(--space-hero-bottom);
}
.hero-paths-top {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.hero-paths-top .hero-paths-label { margin-bottom: 0; }
.hero-pause {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 12px 6px 10px; border-radius: 999px; cursor: pointer;
  background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.18); backdrop-filter: blur(6px);
  font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(255, 255, 255, 0.8);
  transition: background .18s, color .18s;
}
.hero-pause[hidden] { display: none; }
.hero-pause:hover { color: #fff; background: rgba(255, 255, 255, 0.18); }
.hero-pause:focus-visible { outline: 2px solid var(--grn); outline-offset: 2px; }
/* Two bars when playing, a triangle when paused. */
.hero-pause-icon { width: 10px; height: 10px; border-left: 3px solid currentColor; border-right: 3px solid currentColor; box-sizing: border-box; }
.hero-pause[aria-pressed="true"] .hero-pause-icon {
  border-right: 0; border-left: 9px solid currentColor;
  border-top: 5px solid transparent; border-bottom: 5px solid transparent; height: 10px;
}

/* The homepage hero rises in on load like every page's top (global.css). */
@media (prefers-reduced-motion: no-preference) {
  .hero-content > .eyebrow { animation: page-rise .55s cubic-bezier(.2, .7, .2, 1) both; }
  .hero-content > .hero-title { animation: page-rise-title .65s cubic-bezier(.2, .7, .2, 1) 70ms both; }
  .hero-content > .hero-sub { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 160ms both; }
  .hero-content > .hero-cta { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 240ms both; }
  .hero-content > .hero-meta { animation: page-rise .65s cubic-bezier(.2, .7, .2, 1) 320ms both; }
  .hero-paths-wrap { animation: page-rise .7s cubic-bezier(.2, .7, .2, 1) 380ms both; }
}

.hero-paths-label {
  display: inline-flex; align-items: center; gap: 8px;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  margin-bottom: var(--space-4);
}
.dualpath {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-cards);
}
.dp-card {
  position: relative;
  text-align: left;
  background: rgba(255,255,255,0.96);
  color: var(--ink);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: var(--pad-feature);
  /* Margins, not a flex gap: number row -> title 16, title -> text 8, text ->
     tags 16, and the link pinned to the foot 16 under whatever is tallest. */
  display: flex; flex-direction: column; gap: 0;
  transition: transform .25s ease, box-shadow .25s ease, background .25s;
  overflow: hidden;
  cursor: pointer;
}
.dp-card::before {
  content: "";
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 6px;
  background: var(--grn);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform .35s ease;
}
.dp-treat::before { background: var(--blu); }
.dp-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -25px rgba(0,0,0,0.4); }
.dp-card:hover::before, .dp-card.is-active::before { transform: scaleY(1); }
.dp-card.is-active { background: var(--dark); color: #fff; border-color: transparent; }
.dp-card.is-active .dp-num,
.dp-card.is-active .dp-tag,
.dp-card.is-active .dp-tags span { color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.18); }
.dp-card.is-active .dp-sub { color: rgba(255,255,255,0.78); }
.dp-card.is-active .dp-go { color: #fff; }
.dp-top { display: flex; align-items: center; justify-content: space-between; }
.dp-num { font-family: var(--font-mono); font-size: 13px; color: var(--ink-3); letter-spacing: 0.06em; }
.dp-tag {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink-3);
  padding: 5px 10px; border-radius: 999px;
  border: 1px solid var(--line);
}
.dp-title {
  font-family: var(--font-display);
  font-size: clamp(24px, 2.6vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-weight: 600;
  margin: var(--space-4) 0 0;
}
.dp-sub { color: var(--ink-2); margin: var(--space-2) 0 0; font-size: 15.5px; line-height: 1.5; max-width: 46ch; }
.dp-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
.dp-tags span {
  font-size: 12px;
  padding: 4px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-3);
}
.dp-go {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: auto;
  padding-top: var(--space-4);
  font-weight: 600;
  color: var(--ink);
}
.dp-treat .dp-go { color: #176E92; }
.dp-treat.is-active .dp-go { color: var(--blu); }
.dp-optimize .dp-go { color: var(--grn-2); }
.dp-optimize.is-active .dp-go { color: var(--grn); }

@media (max-width: 800px) {
  .dualpath { grid-template-columns: 1fr; }
  .hero-meta { flex-wrap: wrap; }
}

</style>
