---
import Icon from './Icon.astro';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';
import { conditions } from '../data/content';
import { find } from '@/lib/nav';
interface Props { limit?: number; showHead?: boolean; }
const { limit, showHead = true } = Astro.props;
const items = limit ? conditions.slice(0, limit) : conditions;
// The eight cards are a sample. Say so, with the real count from the nav tree
// (the sitemap's Conditions section), and put the way to the rest where the
// eye lands after the grid — the small link in the section head was easy to
// miss. Only rendered when the list is cut.
const total = find('/conditions/')?.children.length ?? 0;
const truncated = !!limit && total > items.length;
---
<section class="section conditions-section" id="conditions">
  <div class="container">
    {showHead && (
      <SectionHead
        eyebrow="Conditions we treat"
        blurb="Each condition links to a full page with our specific labs, therapies, and the doctors who lead that work at EVND."
        ctaLabel={truncated ? undefined : 'All conditions A–Z'} ctaHref="/conditions/">
        If conventional medicine has shrugged, <br />we are probably the next call.
      </SectionHead>
    )}
    <div class="cond-grid">
      {items.map((c, i) => (
        <a href={c.href} class="cond-card" style={`--i:${i}`}>
          <img src={c.img} alt="" loading="lazy" decoding="async" />
          <div class="cond-overlay"></div>
          <div class="cond-body">
            <span class="cond-tag">{c.tag}</span>
            <h3>{c.name}</h3>
            <span class="cond-arrow"><Icon name="arrow-up-right" size={16} /></span>
          </div>
        </a>
      ))}
    </div>
    {truncated && (
      <div class="cond-more">
        <p>Showing {items.length} of {total} conditions we treat.</p>
        <Button href="/conditions/" variant="dark" icon="arrow-right">See all {total} conditions</Button>
      </div>
    )}
  </div>
</section>

<style is:global>
.conditions-section { background: #fff; }
.cond-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.cond-card {
  position: relative;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius);
  overflow: hidden;
  isolation: isolate;
  transition: transform .25s;
}
.cond-card:hover { transform: translateY(-3px); }
.cond-card img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform .6s ease;
}
.cond-card:hover img { transform: scale(1.08); }
.cond-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(14,19,17,0.08) 0%, rgba(14,19,17,0.75) 100%);
}
.cond-body {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 18px 18px 18px;
  color: #fff;
  display: flex; flex-direction: column; gap: 8px;
}
.cond-tag {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.14);
  padding: 4px 8px; border-radius: 999px;
  align-self: flex-start;
  backdrop-filter: blur(6px);
}
.cond-card h3 {
  font-family: var(--font-display);
  font-weight: 600; font-size: 18px;
  margin: 0;
  letter-spacing: -0.01em;
  line-height: 1.15;
  text-wrap: balance;
}
.cond-arrow {
  position: absolute; top: 14px; right: 14px;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: inline-flex; align-items: center; justify-content: center;
  color: #fff;
  backdrop-filter: blur(6px);
  transition: background .2s;
}
.cond-card:hover .cond-arrow { background: var(--grn); color: var(--ink); }

@media (max-width: 1100px) { .cond-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 700px) { .cond-grid { grid-template-columns: repeat(2, 1fr); } }

/* The way to the other conditions, after the sample. */
.cond-more {
  display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap;
  margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line);
}
.cond-more p { margin: 0; color: var(--ink-3); font-size: 15px; }
@media (max-width: 560px) {
  .cond-more { flex-direction: column; align-items: stretch; text-align: center; margin-top: 20px; }
  .cond-more .btn { justify-content: center; }
}
</style>
