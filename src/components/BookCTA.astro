---
import PageImage from './PageImage.astro';
import { stockSlot } from '@/lib/stock';
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { site } from '../data/site';
const a = site.address;
---
<section class="section book-section" id="book" data-pagefind-ignore>
  <div class="container book-wrap">
    <div class="book-bg">
      <PageImage set="stock" file={stockSlot('section:booking')!.file} alt="" width={1800} height={1000} />
      <div class="book-overlay"></div>
    </div>
    <div class="book-text">
      <Eyebrow light>New patients</Eyebrow>
      <h2 class="h1">Ready when you are.</h2>
      <p>Most new patients are seen within 7–14 days. Bring your story; we'll bring the medicine.</p>
      <div class="book-actions">
        <Button href={site.phoneHref} variant="light" icon="phone" size="lg">{site.phone}</Button>
        <Button href="/new-patient-appointment-request/" variant="outline-light" icon="calendar" size="lg">Book online</Button>
      </div>
      <div class="book-meta">
        <div><Icon name="map" size={16} /><span>{a.street}<br />{a.city}, {a.state} {a.zip}</span></div>
        <div><Icon name="calendar" size={16} /><span>{site.hours.map((h) => `${h.days} ${h.time}`).join(' · ')}</span></div>
        <div><Icon name="heart" size={16} /><span>HSA/FSA accepted<br />Self-pay packages available</span></div>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* The booking panel sits directly on the footer: no gap beneath it, square
   bottom corners so the two dark blocks read as one, and a 10px margin either
   side rather than the container's usual gutter. */
.book-section { padding: clamp(40px, 5vw, 60px) 0 0; }
.book-wrap {
  position: relative;
  width: auto; max-width: none; margin: 0 10px; padding: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow: hidden;
  isolation: isolate;
  min-height: 540px;
}
.book-bg { position: absolute; inset: 0; }
.book-bg img { width: 100%; height: 100%; object-fit: cover; }
.book-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(115deg, rgba(14,19,17,0.92) 0%, rgba(14,19,17,0.7) 50%, rgba(14,19,17,0.4) 100%);
}
.book-text {
  position: relative; z-index: 2;
  padding: clamp(40px, 5vw, 72px);
  display: flex; flex-direction: column; gap: 18px;
  color: #fff;
  max-width: 800px;
}
.book-text .eyebrow { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.85); }
.book-text p { color: rgba(255,255,255,0.85); font-size: 18px; max-width: 56ch; margin: 0; }
.book-actions { display: flex; gap: 14px; flex-wrap: wrap; margin: 18px 0 12px; }
.book-meta {
  margin-top: 28px;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.16);
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.book-meta div { display: flex; gap: 12px; color: rgba(255,255,255,0.82); font-size: 14px; line-height: 1.45; }
.book-meta svg { color: var(--grn); flex-shrink: 0; margin-top: 2px; }
@media (max-width: 700px) { .book-meta { grid-template-columns: 1fr; } }
</style>
