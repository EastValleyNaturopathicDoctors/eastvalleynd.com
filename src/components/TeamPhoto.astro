---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Filename inside src/images/team, e.g. "jason-porter.jpg". */
  file: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
}
const { file, alt, width, height, class: cls = '', loading = 'lazy', fetchpriority } = Astro.props;

// Eager glob so the lookup is a plain object at build time. Astro resizes and
// re-encodes each source once, then reuses the result across every page.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/team/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const mod = images[`/src/images/team/${file}`];
if (import.meta.env.DEV && !mod) {
  console.warn(`<TeamPhoto> no image at src/images/team/${file}`);
}
---
{mod && (
  <Image
    src={mod.default}
    alt={alt}
    width={width}
    height={height}
    class={cls}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
)}
