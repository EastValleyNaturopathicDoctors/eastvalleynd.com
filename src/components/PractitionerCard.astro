---
import Icon from './Icon.astro';
import TeamPhoto from './TeamPhoto.astro';
interface Props {
  name: string; credentials: string; slug: string;
  imageFile?: string; summary?: string; index?: number;
  /** h3 under the homepage's "Practitioners" h2; h2 on /physicians/, where the
   *  cards sit directly under the page's h1 and an h3 would skip a level. */
  level?: 'h2' | 'h3';
  /** 'row' is the compact list on the homepage and /about/; 'tile' is the
   *  larger-headshot card on /physicians/, the full team page (tracker R8);
   *  'schedule' is the row on /contact/, ending in a Schedule link. */
  variant?: 'row' | 'tile' | 'schedule';
  /** The schedule variant's link: one scheduler opens in a new tab. */
  schedule?: { href: string; external: boolean };
}
const { name, credentials, slug, imageFile = '', summary = '', index = 0, level = 'h3', variant = 'row', schedule } = Astro.props;
const Heading = level;
const initials = name.replace(/^Dr\.\s*/, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
---
{variant === 'schedule' && schedule ? (
<div class="doc-row is-schedule">
  <div class="doc-num">{String(index + 1).padStart(2, '0')}</div>
  <div class="doc-name">
    <Heading><a href={`/physicians/${slug}/`}>{name}</a></Heading>
    <span>{credentials}</span>
  </div>
  <div class="doc-photo">
    {imageFile
      ? <TeamPhoto file={imageFile} alt="" width={128} height={128} />
      : <span class="doc-initials" aria-hidden="true">{initials}</span>}
  </div>
  {schedule.external ? (
    <a class="doc-cta" href={schedule.href} target="_blank" rel="noopener"
       aria-label={`Schedule with ${name} (opens the scheduler)`}>
      <span>Schedule</span><Icon name="arrow-up-right" size={14} />
    </a>
  ) : (
    <a class="doc-cta" href={schedule.href} aria-label={`Schedule with ${name}`}>
      <span>Schedule</span><Icon name="arrow-right" size={14} />
    </a>
  )}
</div>
) : variant === 'tile' ? (
<a class="doc-tile" href={`/physicians/${slug}/`}>
  <div class="doc-tile-photo">
    {imageFile
      ? <TeamPhoto file={imageFile} alt={name} width={640} height={640}
          loading={index < 3 ? 'eager' : 'lazy'} />
      : <span class="doc-initials" aria-hidden="true">{initials}</span>}
  </div>
  <div class="doc-tile-body">
    <Heading>{name}</Heading>
    <span class="doc-tile-creds">{credentials}</span>
    {summary && <p>{summary}</p>}
    <span class="doc-cta"><span>View profile</span><Icon name="arrow-up-right" size={14} /></span>
  </div>
</a>
) : (
<a class="doc-row" href={`/physicians/${slug}/`}>
  <div class="doc-num">{String(index + 1).padStart(2, '0')}</div>
  <div class="doc-name">
    <Heading>{name}</Heading>
    <span>{credentials}</span>
  </div>
  <div class="doc-focus">{summary}</div>
  <div class="doc-photo">
    {imageFile
      ? <TeamPhoto file={imageFile} alt={name} width={128} height={128} />
      : <span class="doc-initials" aria-hidden="true">{initials}</span>}
  </div>
  <span class="doc-cta"><span>View profile</span><Icon name="arrow-up-right" size={14} /></span>
</a>
)}

<style is:global>
.practitioners-section { background: #fff; }
.docs-list {
  border-top: 1px solid var(--line);
}
.doc-row {
  display: grid;
  grid-template-columns: 70px 240px 1fr 130px 90px 140px;
  align-items: center;
  gap: var(--space-6);
  padding: var(--space-6) 0;
  border-bottom: 1px solid var(--line);
  transition: background .2s;
  position: relative;
}
.doc-row:hover { background: var(--bg-softer); }
.doc-num { font-family: var(--font-mono); font-size: 13px; color: var(--ink-3); }
.doc-name h2, .doc-name h3 { font-family: var(--font-display); font-size: 22px; margin: 0; font-weight: 600; letter-spacing: -0.01em; }
.doc-name span { font-size: 12.5px; color: var(--ink-3); font-family: var(--font-mono); letter-spacing: 0.04em; }
.doc-focus { color: var(--ink-2); font-size: 15px; }
.doc-photo {
  width: 64px; height: 64px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-soft);
  filter: grayscale(0.3);
  transition: filter .2s, transform .2s;
}
.doc-row:hover .doc-photo { filter: none; transform: scale(1.05); }
.doc-photo img { width: 100%; height: 100%; object-fit: cover; }
.doc-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 16px;
  border: 1px solid var(--line-2);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
  transition: background .2s, color .2s, border-color .2s;
}
.doc-cta:hover { background: var(--ink); color: #fff; border-color: var(--ink); }

@media (max-width: 1000px) {
  .doc-row { grid-template-columns: 40px 1fr 1fr 60px; gap: var(--space-2) var(--space-3); padding: var(--space-5) 0; }
  .doc-focus { grid-column: 1 / -1; padding-left: calc(40px + var(--space-3)); }
  .doc-cta { padding: 8px 12px; font-size: 12px; }
}

/* Practitioner fallback when we have no headshot on file. */
.doc-photo .doc-initials {
  width: 100%; height: 100%; display: grid; place-items: center;
  background: var(--grn-soft); color: var(--grn-2);
  font-family: var(--font-display); font-size: 20px; font-weight: 600;
}

/* --- Practitioner pages ---------------------------------------------------- */

/* Index rows reuse .doc-row from the design system, but as links rather than
   hover-highlight rows, and without the "years in practice" column (we only
   have a verified start year for some people). Restate the grid for 5 children
   and restore the hover affordance. */
.docs-list a.doc-row {
  color: inherit;
  grid-template-columns: 70px 240px 1fr 64px 150px;
}
.docs-list a.doc-row:hover { background: var(--bg-softer); }
.docs-list a.doc-row:hover .doc-photo { filter: none; transform: scale(1.05); }
.docs-list a.doc-row .doc-focus {
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
/* The rule above out-ranks the shared phone rule for .doc-row, so on a phone
   these rows kept the 544px desktop grid and pushed the page 240px sideways
   on /, /about/ and /physicians/. Their own phone layout: number, name and
   photo on one line; the summary and the link beneath, under the name. */
@media (max-width: 1000px) {
  .docs-list a.doc-row { grid-template-columns: 40px minmax(0, 1fr) 56px; gap: var(--space-2) var(--space-3); padding: var(--space-5) 0; }
  .docs-list a.doc-row .doc-num { grid-row: 1; grid-column: 1; }
  .docs-list a.doc-row .doc-name { grid-row: 1; grid-column: 2; }
  .docs-list a.doc-row .doc-photo { grid-row: 1; grid-column: 3; width: 56px; height: 56px; }
  .docs-list a.doc-row .doc-focus { grid-row: 2; grid-column: 2 / -1; padding-left: 0; font-size: 14.5px; }
  .docs-list a.doc-row .doc-cta { grid-row: 3; grid-column: 2 / -1; justify-self: start; }
  .docs-list a.doc-row .doc-name h2, .docs-list a.doc-row .doc-name h3 { font-size: 19px; }
}

/* Schedule rows on /contact/: the same row without the summary, ending in the
   practitioner's Schedule link. Only the name links to the profile. */
.docs-list .doc-row.is-schedule { grid-template-columns: 70px minmax(0, 1fr) 64px 150px; }
.doc-row.is-schedule .doc-name a { color: inherit; }
.doc-row.is-schedule .doc-name a:hover { color: var(--grn-2); }
.doc-row.is-schedule:hover .doc-photo { filter: none; transform: scale(1.05); }
@media (max-width: 1000px) {
  .docs-list .doc-row.is-schedule { grid-template-columns: 40px minmax(0, 1fr) 56px; gap: var(--space-2) var(--space-3); }
  .doc-row.is-schedule .doc-photo { width: 56px; height: 56px; }
  .doc-row.is-schedule .doc-cta { grid-row: 2; grid-column: 2 / -1; justify-self: start; }
  .doc-row.is-schedule .doc-name h3 { font-size: 19px; }
}

/* --- Team page tiles (tracker R8) -------------------------------------------
   /physicians/ was a third copy of the homepage list. Here each practitioner
   gets a large headshot in colour, the full summary excerpt, and the same
   whole-card link to the profile. The first row loads eagerly: it is in the
   first screen on a laptop. */
.docs-grid {
  display: grid; gap: var(--gap-media);
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}
.doc-tile { display: flex; flex-direction: column; color: inherit; }
.doc-tile-photo {
  aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden;
  background: var(--bg-soft);
}
.doc-tile-photo img {
  width: 100%; height: 100%; object-fit: cover; object-position: center 20%;
  transition: transform .5s cubic-bezier(.2,.7,.3,1);
}
.doc-tile:hover .doc-tile-photo img { transform: scale(1.04); }
.doc-tile-photo .doc-initials {
  width: 100%; height: 100%; display: grid; place-items: center;
  background: var(--grn-soft); color: var(--grn-2);
  font-family: var(--font-display); font-size: clamp(40px, 5vw, 64px); font-weight: 600;
}
.doc-tile-body { display: flex; flex-direction: column; flex: 1; padding-top: var(--space-4); }
.doc-tile-body h2, .doc-tile-body h3 {
  font-family: var(--font-display); font-size: 24px; font-weight: 600;
  letter-spacing: -0.015em; line-height: 1.15; margin: 0; transition: color .2s;
}
.doc-tile:hover .doc-tile-body h2, .doc-tile:hover .doc-tile-body h3 { color: var(--grn-2); }
.doc-tile-creds {
  font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.04em;
  color: var(--ink-3); margin-top: var(--space-1);
}
.doc-tile-body p { margin: var(--space-3) 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
/* The summary takes up the slack, so the links line up along a row of cards. */
.doc-tile-body p { flex-grow: 1; }
.doc-tile .doc-cta { align-self: flex-start; margin-top: var(--space-5); }
.doc-tile:hover .doc-cta { background: var(--ink); color: #fff; border-color: var(--ink); }
/* One column on a phone: a landscape crop keeps a full-width headshot from
   filling the whole screen. */
@media (max-width: 600px) {
  .doc-tile-photo { aspect-ratio: 4 / 3; }
}
</style>
