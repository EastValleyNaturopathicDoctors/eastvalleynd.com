---
import PageImage from './PageImage.astro';
import { stockSlot } from '@/lib/stock';
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
/**
 * The homepage spotlight on TruDOSE™ Platelet IV Therapy. There is no TruDOSE
 * page on the site yet (the old /trudose-iv-therapy/trudose/ wasn't
 * migrated), and the owners restricted TruDOSE claims, so this says only what
 * is established: the patient's own platelets (it's in the name), given in
 * the clinic's in-office IV suite in Mesa. The design template's outcome copy
 * ("restoring tissue, calming inflammation…", "60–90 minute appointments",
 * "New regenerative technology") is gone (audit 2026-11-02), and the button,
 * which went to /iv-therapy/ (no mention of TruDOSE), asks the front desk.
 * When the clinic writes a TruDOSE page, point the button there.
 */
---
<section class="section trudose is-band" data-pagefind-ignore>
  <div class="container trudose-inner">
    <div class="trudose-media">
      <PageImage set="stock" file={stockSlot('section:trudose')!.file} alt="" width={1000} height={1250} />
      <div class="trudose-media-overlay"></div>
      <div class="trudose-badge"><Icon name="drop" size={14} />Offered at EVND</div>
    </div>
    <div class="trudose-text">
      <Eyebrow>Spotlight · TruDOSE™ Platelet IV Therapy</Eyebrow>
      <h2 class="h2">Your blood. Your dose. <span class="accent-grn">Precisely yours.</span></h2>
      <p class="lede">
        TruDOSE™ Platelet IV Therapy uses your own platelets, given by IV. Ask our doctors
        whether it's right for you.
      </p>
      <ul class="ticklist">
        <li><Icon name="check" size={16} /><span>In our in-office IV suite in Mesa</span></li>
      </ul>
      <div class="hero-cta">
        <Button href="/contact/" variant="dark" icon="arrow-right">Ask about TruDOSE</Button>
      </div>
    </div>
  </div>
</section>

<style is:global>
.trudose { background: var(--bg-soft); }
.trudose-inner {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: var(--gap-cols);
  align-items: stretch;
}
.trudose-media {
  position: relative; aspect-ratio: 4/5; border-radius: var(--radius-lg); overflow: hidden;
}
.trudose-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.trudose-media-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(14,19,17,0.2) 0%, rgba(14,19,17,0.55) 100%);
}
.trudose-badge {
  position: absolute; top: var(--space-6); left: var(--space-6);
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.95);
  padding: 8px 14px;
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink);
}
.trudose-badge svg { color: var(--grn-2); }
/* A stack of margins, not a flex gap: the rhythm is not uniform (label -> h2
   12 and h2 -> lede 20 from global.css, the list 24, the button row 32). */
.trudose-text { display: flex; flex-direction: column; justify-content: center; gap: 0; }
.trudose-text .ticklist { margin-top: var(--space-6); }
.ticklist { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.ticklist li { display: flex; align-items: flex-start; gap: var(--space-3); font-size: 16px; color: var(--ink-2); }
.ticklist li svg { color: var(--grn-2); flex-shrink: 0; margin-top: 3px; }

@media (max-width: 900px) {
  .trudose-inner { grid-template-columns: 1fr; }
  .trudose-media { aspect-ratio: 4/3; }
}
</style>
