---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
---
<section class="section trudose" data-pagefind-ignore>
  <div class="container trudose-inner">
    <div class="trudose-media">
      <img src="https://images.unsplash.com/photo-1631549916768-4119b2e5f926?w=1400&q=80&auto=format&fit=crop" alt="" loading="lazy" />
      <div class="trudose-media-overlay"></div>
      <div class="trudose-badge"><Icon name="drop" size={14} />New regenerative technology</div>
    </div>
    <div class="trudose-text">
      <Eyebrow>Spotlight · TruDOSE™ Platelet IV Therapy</Eyebrow>
      <h2 class="h2">Your blood. Your dose. <span class="accent-grn">Precisely yours.</span></h2>
      <p class="lede">
        TruDOSE™ delivers your own platelets, intravenously and dose-specific to your physiology —
        restoring tissue, calming inflammation, and accelerating recovery in conditions PRP
        injections alone can't reach.
      </p>
      <ul class="ticklist">
        <li><Icon name="check" size={16} /><span>Dose-titrated to your platelet count and condition</span></li>
        <li><Icon name="check" size={16} /><span>Used for post-stroke, post-concussion, ME/CFS, Lyme, joint disease</span></li>
        <li><Icon name="check" size={16} /><span>In-office IV suite, 60–90 minute appointments</span></li>
      </ul>
      <div class="hero-cta">
        <Button href="/iv-therapy/" variant="dark" icon="arrow-right">TruDOSE Platelet IV Therapy</Button>
      </div>
    </div>
  </div>
</section>

<style is:global>
.trudose { background: var(--bg-soft); }
.trudose-inner {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: clamp(32px, 5vw, 64px);
  align-items: stretch;
}
.trudose-media {
  position: relative; aspect-ratio: 4/5; border-radius: var(--radius-lg); overflow: hidden;
}
.trudose-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.trudose-media-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(14,19,17,0.2) 0%, rgba(14,19,17,0.55) 100%);
}
.trudose-badge {
  position: absolute; top: 22px; left: 22px;
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.95);
  padding: 8px 14px;
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink);
}
.trudose-badge svg { color: var(--grn-2); }
.trudose-text { display: flex; flex-direction: column; justify-content: center; gap: 20px; }
.ticklist { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
.ticklist li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; color: var(--ink-2); }
.ticklist li svg { color: var(--grn-2); flex-shrink: 0; margin-top: 3px; }

@media (max-width: 900px) {
  .trudose-inner { grid-template-columns: 1fr; }
  .trudose-media { aspect-ratio: 4/3; }
}
</style>
