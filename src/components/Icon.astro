---
/**
 * Inline icon: Material Symbols, rounded, filled — see lib/icons.ts (D111).
 * `name` is one of the site's short aliases ("phone", "arrow-right") or any
 * Material Symbols name ("neurology"). `stroke` is accepted and ignored: the
 * symbols are filled shapes, not strokes, and some call sites still pass it.
 */
import { iconSvg } from '@/lib/icons';
interface Props { name: string; size?: number; stroke?: number; class?: string; }
const { name, size = 24, class: cls = '' } = Astro.props;
const svg = iconSvg(name, size, cls);
if (import.meta.env.DEV && !svg) console.warn(`<Icon> unknown name: "${name}"`);
---
<Fragment set:html={svg} />
