---
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

/**
 * Every set of testimonials on the site renders through this component, so the
 * house rule lives in exactly one place: **more than three go in a carousel.**
 * Three or fewer sit side by side, where they are all readable at once and a
 * carousel would only hide content behind a click.
 *
 * Two visual treatments, both pre-existing:
 *   feature — the dark full-bleed band on / and /about/, display-size type.
 *   doc     — the light bordered cards on a practitioner bio page.
 */
export interface Testimonial {
  quote: string;
  name: string;
  /** Feature variant: the line under the name ("Patient since 2019"). */
  context?: string;
  /** Carried in the physician data but deliberately not rendered: the migrated
   *  value is the string "100%", which reads as a percentage rather than a
   *  rating next to a name. Kept on the type so the data still type-checks. */
  stars?: string;
}

interface Props {
  /** readonly, because `src/data/content.ts` exports `as const`. */
  items: readonly Testimonial[];
  eyebrow: string;
  variant?: 'feature' | 'doc';
  /** A link under the quotes — "Read our reviews on Google". */
  more?: { label: string; href: string };
}

const { items, eyebrow, variant = 'feature', more } = Astro.props;

const CAROUSEL_ABOVE = 3;
const carousel = items.length > CAROUSEL_ABOVE;
const doc = variant === 'doc';

/** A migrated review is one string with blank lines in it, not one paragraph. */
const paras = (q: string) => q.split('\n').map((p) => p.trim()).filter(Boolean);
---

<!-- Both variants sit on the same dark band; `doc` only changes the cards. -->
{items.length > 0 && (
  <section class="section testi-section is-band" data-pagefind-ignore>
    <div class="container">
      <div class:list={['testi-wrap', carousel && 'testi-carousel']}>
        <div class="testi-head">
          <Eyebrow>{eyebrow}</Eyebrow>
          {/* Previous / dots / next, then pause at the end of the row (tracker
              K8). The arrows and pause sit outside the tablist, which may
              only hold tabs. Icon-only: the words live in aria-label. */}
          {carousel && (
            <div class="testi-controls">
              <button type="button" class="testi-step" data-step="-1" aria-label="Previous story">
                <Icon name="chevron_left" size={22} />
              </button>
              <div class="testi-nav" role="tablist" aria-label={eyebrow}>
                {items.map((_, n) => (
                  <button type="button" role="tab" data-i={n} class={n === 0 ? 'is-on' : ''}
                          aria-selected={n === 0 ? 'true' : 'false'}
                          aria-label={`Story ${n + 1} of ${items.length}`}><span></span></button>
                ))}
              </div>
              <button type="button" class="testi-step" data-step="1" aria-label="Next story">
                <Icon name="chevron_right" size={22} />
              </button>
              <button type="button" class="testi-step testi-toggle" aria-label="Pause stories">
                <Icon name="pause" size={20} class="i-pause" />
                <Icon name="play_arrow" size={22} class="i-play" />
              </button>
            </div>
          )}
        </div>

        {/* Not a carousel: the cards sit in a grid. As a carousel the same
            cards stack in one place and the script shows one at a time. */}
        <div class:list={[doc && 'doc-testi-grid', carousel && 'is-carousel']}>
          {items.map((t, n) => (
            <blockquote class:list={[doc ? 'doc-testi' : 'testi-quote', 'testi-slide']}
                        data-slide={n} hidden={carousel && n !== 0}>
              <span class="quotemark">&ldquo;</span>
              {paras(t.quote).map((p) => <p>{p}</p>)}
              <footer>
                <b>{t.name}</b>
                {t.context && <span>{t.context}</span>}
              </footer>
            </blockquote>
          ))}
        </div>
        {more && (
          <p class="testi-more">
            <a href={more.href} rel="noopener" target="_blank">{more.label}<Icon name="arrow-right" size={16} /></a>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<script>
  // Scoped per root rather than to the document, so a page may carry more than
  // one of these without the two fighting over the same slides. The previous
  // version queried `.testi-quote` globally and only worked because exactly one
  // carousel existed on the site.
  document.querySelectorAll<HTMLElement>('.testi-carousel').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.testi-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.testi-nav button'));
    if (slides.length < 2) return;

    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== i));
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k === i);
        d.setAttribute('aria-selected', String(k === i));
      });
    };

    // Auto-advance runs until the visitor touches any control, then stops for
    // good: a review swapped out mid-sentence is worse than one that waits
    // (tracker K8, WCAG 2.2.2). Only the play button starts it again. Under
    // reduced motion it never starts, so the pause button has nothing to do.
    const toggle = root.querySelector<HTMLButtonElement>('.testi-toggle');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let playing = !reduce;
    let timer: number | undefined;
    const restart = () => {
      clearInterval(timer);
      if (playing) timer = window.setInterval(() => show(i + 1), 7000);
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      toggle?.classList.toggle('is-paused', !on);
      toggle?.setAttribute('aria-label', on ? 'Pause stories' : 'Play stories');
      restart();
    };
    if (toggle) toggle.hidden = reduce;
    toggle?.addEventListener('click', () => setPlaying(!playing));

    dots.forEach((d) =>
      d.addEventListener('click', () => { show(Number(d.dataset.i)); setPlaying(false); }));
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { show(i + Number(b.dataset.step)); setPlaying(false); }));

    // A reader part-way through a long review should not have it swapped out
    // from under them. Practitioner reviews run to 200 words.
    root.addEventListener('pointerenter', () => clearInterval(timer));
    root.addEventListener('pointerleave', restart);
    root.addEventListener('focusin', () => clearInterval(timer));

    setPlaying(playing);
  });
</script>

<style is:global>
.testi-section { background: var(--ink); color: #fff; }
.testi-section .eyebrow { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.18); color: rgba(255,255,255,0.78); }
.testi-wrap { display: flex; flex-direction: column; gap: 48px; }
.testi-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 18px; }
.testi-controls { display: flex; align-items: center; gap: 4px; }
.testi-nav { display: flex; flex-wrap: wrap; }
/* The dash stays 2px; the button around it is the 44px-tall tap target (K8). */
.testi-nav button { padding: 21px 6px; }
.testi-nav span { display: block; width: 28px; height: 2px; background: rgba(255,255,255,0.2); transition: background .2s; }
.testi-nav button:hover span { background: rgba(255,255,255,0.45); }
.testi-nav button.is-on span { background: var(--grn); }
.testi-step {
  display: grid; place-items: center; flex: none;
  width: 40px; height: 40px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.85);
  transition: border-color .2s, color .2s;
}
.testi-step:hover { border-color: var(--grn); color: #fff; }
.testi-toggle { margin-left: 8px; }
.testi-toggle[hidden] { display: none; }
.testi-toggle .i-play, .testi-toggle.is-paused .i-pause { display: none; }
.testi-toggle.is-paused .i-play { display: block; }
/* Six stories plus three buttons must fit a 343px phone column, under the eyebrow. */
@media (max-width: 560px) {
  .testi-controls { gap: 2px; }
  .testi-nav button { padding: 21px 4px; }
  .testi-nav span { width: 18px; }
  .testi-step { width: 36px; height: 36px; }
  .testi-toggle { margin-left: 4px; }
}
.testi-quote {
  margin: 0; max-width: 1000px;
  display: flex; flex-direction: column; gap: 28px;
  animation: fadein .4s ease;
}
.quotemark {
  font-family: var(--font-display);
  font-size: 90px;
  line-height: 0.4;
  color: var(--grn);
}
.testi-quote p {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(28px, 3.4vw, 46px);
  line-height: 1.18;
  letter-spacing: -0.02em;
  margin: 0;
}
.testi-quote footer { display: flex; gap: 16px; align-items: baseline; font-size: 14px; color: rgba(255,255,255,0.75); }
.testi-quote footer b { color: #fff; font-weight: 600; }
.testi-more { margin: clamp(28px, 4vw, 44px) 0 0; }
.testi-more a {
  display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600;
  color: #fff; border-bottom: 1px solid rgba(255,255,255,0.35); padding-bottom: 3px;
  transition: border-color .2s, gap .2s;
}
.testi-more a:hover { border-color: var(--grn); gap: 11px; }
@keyframes fadein { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

/* Real patient reviews carried over from the WordPress bio pages. */
.doc-testi-grid {
  display: grid; gap: 18px;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  margin-top: 28px;
}
.doc-testi {
  margin: 0; padding: 28px; border: 1px solid var(--line);
  border-radius: var(--radius-lg); background: var(--bg);
  position: relative;
}
.doc-testi .quotemark {
  font-family: var(--font-display); font-size: 56px; line-height: 1;
  color: var(--grn); display: block; margin-bottom: 4px;
}
.doc-testi p { margin: 0 0 0.9em; font-size: 15.5px; line-height: 1.6; color: var(--ink-2); }
.doc-testi footer { font-size: 13px; font-family: var(--font-mono); color: var(--ink-3); }
.doc-testi footer b { color: var(--ink); font-family: var(--font-sans); }
</style>
