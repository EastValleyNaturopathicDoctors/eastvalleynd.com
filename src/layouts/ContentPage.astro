---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PageImage from '../components/PageImage.astro';
import Icon from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';
import BookCTA from '../components/BookCTA.astro';
import InlineCTA from '../components/InlineCTA.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import BodyHtml from '../components/BodyHtml.astro';
import LongReadToc from '../components/LongReadToc.astro';
import Button from '../components/Button.astro';
import { splitForCta } from '@/lib/midcta';
import { longRead, longReadFor, readingTime } from '@/lib/longread';
import { heroMode, heroOnce, isIvGraphic, opensWithMedia } from '@/lib/hero';
import { injectTileIcons } from '@/lib/icons';
import { cleanLinks } from '@/lib/links';
import { tidyProse } from '@/lib/prose';
import { linkHubEntries, hasHubLinks } from '@/lib/hublinks';
import { closingAsk } from '@/lib/closing';
import { takePrimaryAction } from '@/lib/primaryaction';
import { trail as navTrail, live, isDuplicate } from '@/lib/nav';
import { stockFor, stockPlaceholders } from '@/lib/stock';
import { sectionIcons } from '@/data/section-icons';
import { compactHeroes } from '@/data/compact-heroes';
import { keptInsets } from '@/data/kept-insets';
import { retiredPages } from '@/data/retired-pages';
import { documentPages } from '@/data/document-pages';
import '../styles/section-cards.css';
import '../styles/page-figure.css';

interface Props { entry: CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
// `rendered.html` is the HTML <Content /> would emit: the bodies are migrated
// HTML, not markdown. It is rendered from the string so the pipeline's tile
// grids can carry their icons (D112) and long bodies can take a booking
// prompt part-way down (D103). A hub's entry list gets back the links it lost
// (tracker P1), then all links are tidied (tracker L3), and the lists and
// reference list repaired (tracker K2). A page whose body opens with the
// button most visitors came for shows it in the hero instead, as the page's
// main button (tracker P2). A body that opens with the top image again shows
// it once (tracker R5).
const once = heroOnce(entry.rendered?.html ?? '', d.route);
const { html: body, action } = takePrimaryAction(
  injectTileIcons(tidyProse(cleanLinks(linkHubEntries(once.html, d.route), d.route))), d.route);
// A long body gets its paste damage repaired, ids on its headings and a
// contents list (D131) — only when there are enough sections to list.
const long = longReadFor(body, d.wordCount);
// A library of documents opens with jump links to its sections however short
// it is, from the same ids and list (tracker L8).
const docs = documentPages.includes(d.route);
const jumps = docs && !long ? longRead(body) : null;
// A body that ends by asking for the booking marks that closing, so the
// layout does not stack its own offers on it (tracker C10).
let { html, ask } = closingAsk((long ?? jumps)?.html ?? body);

// Breadcrumb and child links come from the same nav tree as the header. The
// breadcrumb keeps the full tree; the child cards skip placeholders (tracker N1).
const trail = navTrail(d.route);
const parents = trail.slice(0, -1);
const children = live(trail.at(-1)?.children ?? []);
// A service or condition page reads as a landing page, not a blog post: its
// picture sits beside the title in the hero, at a fixed size, and a page that
// heads others lists them straight under the hero, ahead of its copy.
const landing = ['/services/', '/conditions/'].includes(trail[0]?.href ?? '') && trail.length > 1;
// A body tile grid that links every child (D112) is the section's menu, so on
// a landing page it moves up to the top whole, icons and extra links and all.
const gridRe = /<ul class="wp-tilegrid[\s\S]*?<\/ul>\s*/;
const liftGrid = landing && children.length > 0 && gridRe.test(html)
  && children.every((c) => html.match(gridRe)![0].includes(`href="${c.href}"`));
const topGrid = liftGrid ? html.match(gridRe)![0] : '';
if (liftGrid) html = html.replace(gridRe, '');
const kidsFirst = landing && children.length > 0;
// A landing page's body that opens with a plain paragraph of intro length gives it to
// the hero, beside the picture, when enough copy is left to fill the body.
const textOf = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const leadRe = /^\s*<p>((?:(?!<\/?p\b|<(?:img|iframe|video|figure)\b)[\s\S])*)<\/p>\s*/;
const leadMatch = landing ? html.match(leadRe) : null;
const lead = leadMatch && textOf(leadMatch[1]).length >= 120 && textOf(leadMatch[1]).length <= 650
  && textOf(html.slice(leadMatch[0].length)).length >= 400 ? leadMatch[1] : '';
if (lead) html = html.slice(leadMatch![0].length);
// A leaf page carries the booking card beside the article; a page that heads a
// section ends in its child cards instead. A landing hub lists them first, so
// it takes the card beside its copy like a leaf page.
const aside = children.length === 0 || kidsFirst;
// A section page has no card beside it, so one the mid-body split skipped
// takes the card once at the end of its body, ahead of the child cards, with
// the hub's own scheduler (tracker C4). A short leaf page does not: there it
// would sit right on the booking band. A long section page's rail carries the
// compact card under its contents list, as a long leaf page's does, and so
// also hides the mid-body card where the rail is on screen. A body that already
// ends on its own request button keeps that instead, unless the hub has its
// own scheduler for the card to offer (tracker C10).
const halves = splitForCta(html);
const endCard = !aside && !halves && !(ask === 'button' && !d.booking.length);
// The full card (597px) is taller than the shortest leaf bodies (174–488px),
// so on those pages the booking band starts one section under the card's foot
// rather than the text's. The card keeps its address, hours and links there
// all the same: hiding them would take words off the page (tracker K11).
const sideCard = aside || !!long;
// A body that carries its own tile grid linking every child (D112), or a hub's
// linked entry list (tracker P1), is already the section's menu; the card list
// would repeat it.
const hasGrid = html.includes('wp-tilegrid') || hasHubLinks(d.route);
const showChildren = !kidsFirst && children.length > 0 && !(hasGrid && children.every((c) => html.includes(`href="${c.href}"`)));
// "Ready to Get Started? Request an appointment below": the band is that
// section's action, so it follows without the usual gap (tracker C10).
const ontoBand = ask === 'lead' && !endCard && !showChildren;
const mode = d.imageFile && !once.hideHero ? heroMode(d.imageWidth) : 'none';
// A small image that is content, like a partner lab's logo, stays an inset (I5).
const hero = mode === 'hidden' && keptInsets.includes(d.route) ? 'inset' : mode;
// A smaller own image sits in a tinted frame, except the IV graphics (I5, I6).
const framed = hero === 'contained' && !isIvGraphic(d.route);
// A page WordPress gave no image carries an Unsplash photo instead, or a
// branded panel where none fitted (D118). Its own image always wins.
// Also when the page's own image is an icon-sized thumbnail D116 hides (D119).
// Neither goes above a body that opens with its own video or picture, and a
// task page takes a short icon band instead (tracker I5).
const fill = hero === 'none' && !opensWithMedia(html);
const compact = fill && !landing && compactHeroes.includes(d.route);
const stock = fill && !compact ? stockFor(d.route) : undefined;
const placeholder = compact || (fill && !landing && !stock && stockPlaceholders.includes(d.route));
// The landing hero's picture: the page's own, else its stock photo.
const media = landing && (hero === 'wide' || hero === 'contained' || !!stock);
// The panel's icon: the page's own, else the nearest section's.
const segs = d.route.split('/').filter(Boolean);
const panelIcon = segs.map((_, i) => `/${segs.slice(0, segs.length - i).join('/')}/`)
  .map((r) => sectionIcons[r]).find(Boolean) ?? 'eco';
// A page that repeats another stays out of search engines until it redirects
// there; its canonical already names the page kept (tracker R2).
const duplicate = isDuplicate(d.route);
// An old page on its way out does too, canonical to its replacement (tracker R4).
const retiredTo = retiredPages[d.route];
---
<Base title={d.title} description={d.metaDescription} canonicalPath={d.canonical || retiredTo}
      noindex={duplicate || !!retiredTo} searchSection={parents[0]?.label}>
  {long && <div class="lr-progress" aria-hidden="true"></div>}
  <article class:list={['cpage', long && 'is-long', docs && 'is-docs', ontoBand && 'onto-band']}>
    <header class:list={['page-hero', 'cpage-hero', media && 'is-split']}>
      <div class:list={['container', media && 'cpage-hero-grid']}>
        <div class="cpage-hero-text">
        {parents.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
            {parents.map((p) => <a href={p.href}>{p.label}</a>)}
          </nav>
        )}
        {parents.length === 0 && <Eyebrow>East Valley Naturopathic Doctors</Eyebrow>}
        <h1 class="h1">{d.title}</h1>
        {long && (
          <p class="lr-meta" data-pagefind-ignore>
            <span>{readingTime(d.wordCount)}</span>{long.sections > 1 && <span>{long.sections} sections</span>}
          </p>
        )}
        {lead && <p class="lede cpage-lead" set:html={lead} />}
        {action && (
          <p class="cpage-action">
            {action.newTab
              ? <Button href={action.href} size="lg" icon="arrow-up-right" target="_blank" rel="noopener">{action.label}</Button>
              : <Button href={action.href} size="lg">{action.label}</Button>}
          </p>
        )}
        </div>
        {media && (
          <div class:list={['cpage-hero-media', stock ? 'is-photo' : 'is-own']} data-pagefind-ignore={stock ? '' : undefined}>
            {stock
              ? <PageImage set="stock" file={stock.file} alt={stock.alt}
                           width={960} height={720} loading="eager" fetchpriority="high" />
              : <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                           width={960} height={0} loading="eager" fetchpriority="high" />}
          </div>
        )}
      </div>
    </header>

    {kidsFirst && (
      <section class="cpage-top" aria-labelledby="cpage-top-head" data-pagefind-ignore>
        <div class="container">
          <h2 class="cpage-top-head" id="cpage-top-head">Explore {trail.at(-1)?.label}</h2>
          {liftGrid ? <BodyHtml html={topGrid} /> : (
            <div class="sec-grid">
              {children.map((c) => (
                <div class="sec-card">
                  <a class="sec-card-head" href={c.href}>
                    <h3>{c.label}</h3>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    {!landing && hero === 'wide' && (
      <div class="container cpage-figure">
        <PageImage file={d.imageFile} alt={d.imageAlt || d.title}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {!landing && stock && (
      <div class="container cpage-figure is-stock" data-pagefind-ignore>
        <PageImage set="stock" file={stock.file} alt={stock.alt}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {placeholder && (
      <div class="container cpage-figure" aria-hidden="true" data-pagefind-ignore>
        <div class="cpage-panel is-compact"><Icon name={panelIcon} size={40} /></div>
      </div>
    )}
    {!landing && hero === 'contained' && (
      <div class="container cpage-figure is-contained">
        {framed ? (
          <div class="cpage-frame">
            <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                       width={960} height={0} loading="eager" fetchpriority="high" />
          </div>
        ) : (
          <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                     width={960} height={0} loading="eager" fetchpriority="high" />
        )}
      </div>
    )}

    <div class:list={['container', 'cpage-body-wrap', sideCard && 'has-aside', long && 'has-rail']}>
      <div class="cpage-body prose">
        {long && <LongReadToc items={long.toc} variant="panel" />}
        {jumps && jumps.sections > 1 && <LongReadToc items={jumps.toc} variant="chips" />}
        {hero === 'inset' && (
          <figure class="cpage-inset">
            <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural width={420} height={0} loading="eager" />
          </figure>
        )}
        {halves ? (
          <Fragment><BodyHtml html={halves[0]} /><InlineCTA topic={d.title} booking={d.booking} /><BodyHtml html={halves[1]} /></Fragment>
        ) : <BodyHtml html={html} />}
        {endCard && <InlineCTA topic={d.title} booking={d.booking} />}
      </div>
      {long ? (
        <div class="lr-rail">
          <LongReadToc items={long.toc} variant="rail" />
          <SidebarCTA booking={d.booking} topic={d.title} compact />
        </div>
      ) : aside && <SidebarCTA booking={d.booking} topic={d.title} />}
    </div>

    {showChildren && (
      <section class="section cpage-children" data-pagefind-ignore>
        <div class="container">
          <h2 class="h2">Explore {d.title}</h2>
          <div class="sec-grid">
            {children.map((c) => (
              <div class="sec-card">
                <a class="sec-card-head" href={c.href}>
                  <h3>{c.label}</h3>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <BookCTA />
</Base>

<style is:global>
/* --- Interior content pages -------------------------------------------------
   The article's prose rules are shared with the blog and the legal pages
   (src/styles/prose.css, via BodyHtml); only this template's extras are here.
   The hero keeps the page-hero padding: half a section under its last line. */
.cpage-hero { border-bottom: none; }
.cpage-hero .h1 { max-width: 20ch; font-size: clamp(34px, 4.6vw, 62px); }
/* The page's main button under the title (tracker P2); the arrow marks a new tab. */
.cpage-action { margin: var(--space-7) 0 0; }

.crumbs {
  display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
  margin-bottom: var(--space-4);
  font-family: var(--font-mono); font-size: 12px;
  letter-spacing: 0.06em; text-transform: uppercase;
}
.crumbs a { color: var(--ink-3); }
.crumbs a:hover { color: var(--grn-2); }
.crumbs a + a::before { content: '/'; margin-right: var(--space-2); color: var(--line-2); }

.cpage-figure { margin-top: var(--space-section-tight); }
/* A mid-sized featured image at its own width, uncropped (D116), on the
   content edge like the title above it. */
.cpage-figure.is-contained { display: flex; justify-content: flex-start; }
.cpage-figure.is-contained img { width: auto; max-width: 100%; max-height: min(420px, 60vh); aspect-ratio: auto; object-fit: contain; }
/* …inside the tinted frame (src/styles/page-figure.css), on a desktop the
   shape of a stock photo. */
@media (min-width: 720px) {
  .cpage-figure .cpage-frame { aspect-ratio: 21 / 9; }
  .cpage-figure .cpage-frame img { max-height: min(100%, 420px); }
}
/* Stock photos take a shorter, wider crop on a desktop, so the intro and
   booking card rise into the first screen (I5). */
@media (min-width: 720px) { .cpage-figure.is-stock img { aspect-ratio: 21 / 9; } }
.cpage-figure img {
  width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
  border-radius: var(--radius-lg);
}
/* Stand-in where no stock photo fitted (D118), and a task page's band (I5):
   the phone hero's dark gradient (D12) and the section's icon. Always the
   short band, never a photo-sized panel: a large dark field with one small
   icon read as an image that failed to load (tracker K11). */
.cpage-panel {
  display: grid; place-items: center;
  border-radius: var(--radius-lg); color: var(--grn);
  background:
    radial-gradient(120% 80% at 78% 8%, rgba(108, 190, 63, 0.16) 0%, rgba(108, 190, 63, 0) 60%),
    linear-gradient(to bottom, #141A17 0%, #0E1311 60%, #0A0E0C 100%);
}
.cpage-panel.is-compact { height: clamp(84px, 10vw, 128px); }   /* the compact band's height (exempt) */

/* Half a section under the hero's edge; after a featured image, one block
   below it. A whole section closes the article above the booking band. */
.cpage-body-wrap { padding-block: var(--space-section-tight) var(--space-section); }
.cpage-figure + .cpage-body-wrap { padding-top: var(--space-block); }
/* A hub entry's linked heading (tracker P1) still reads as a heading; its
   "Learn More" words carry the usual link style. */
.cpage-body h3 > a.hub-link { color: inherit; text-decoration: none; }
.cpage-body h3 > a.hub-link:hover { color: var(--grn-2); text-decoration: underline; text-underline-offset: 3px; }
.cpage-body .wp-linklist {
  list-style: none; padding: 0; display: grid; gap: var(--space-2);
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}
.cpage-body .wp-linklist a { text-decoration: none; font-weight: 500; }

/* Tile grid recovered from a WPBakery icon menu (D112): icon + label, linked.
   Three-up on a desktop; on a phone two compact rows so thirteen tiles are
   about seven rows, not thirteen full-width cards. */
:is(.cpage-body, .cpage-top) .wp-tilegrid {
  list-style: none; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--gap-tiles);
}
:is(.cpage-body, .cpage-top) .wp-tilegrid li { margin: 0; }
:is(.cpage-body, .cpage-top) .wp-tilegrid a {
  display: flex; align-items: center; gap: var(--space-3); min-height: 64px;
  padding: var(--pad-tile); border: 1px solid var(--line); border-radius: var(--radius);
  background: var(--bg); color: var(--ink); text-decoration: none;
  font-weight: 500; font-size: 15.5px; line-height: 1.25;
  transition: border-color .18s, background .18s, color .18s, transform .18s;
}
:is(.cpage-body, .cpage-top) .wp-tilegrid a:hover { border-color: var(--grn); background: var(--grn-soft); transform: translateY(-1px); }
:is(.cpage-body, .cpage-top) .wp-tile-icon {
  flex: none; display: grid; place-items: center; width: 40px; height: 40px;
  border-radius: 12px; background: var(--grn-soft); color: var(--grn-2);
}
:is(.cpage-body, .cpage-top) .wp-tilegrid a:hover .wp-tile-icon { background: var(--grn); color: var(--ink); }
@media (max-width: 560px) {
  :is(.cpage-body, .cpage-top) .wp-tilegrid { grid-template-columns: 1fr 1fr; }
  :is(.cpage-body, .cpage-top) .wp-tilegrid a { min-height: 0; padding: var(--space-2) var(--space-3); gap: var(--space-2); font-size: 13.5px; }
  :is(.cpage-body, .cpage-top) .wp-tile-icon { width: 30px; height: 30px; border-radius: 9px; }
  :is(.cpage-body, .cpage-top) .wp-tile-icon svg { width: 18px; height: 18px; }
}

/* --- Service and condition pages --------------------------------------------
   The title and the picture share the hero: text on the left, the picture on
   the right in a fixed 4:3 frame, so no photo is ever wider than half the page
   or taller than 400px. A stock photo fills its frame; the clinic's own image
   is shown whole on a white mount, so no lettering or equipment is cropped.
   On a phone the picture follows the title in a short 16:10 frame. */
.cpage-hero.is-split .h1 { font-size: clamp(32px, 3.6vw, 50px); }
.cpage-lead { margin-top: var(--space-5); font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; }
.cpage-lead a { color: var(--grn-2); text-decoration: underline; text-underline-offset: 3px; }
.cpage-hero-media {
  position: relative; aspect-ratio: 4 / 3; max-height: 400px; overflow: hidden;
  border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg);
}
.cpage-hero-media img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
}
.cpage-hero-media.is-own img {
  inset: var(--space-5); width: calc(100% - 2 * var(--space-5)); height: calc(100% - 2 * var(--space-5));
  object-fit: contain;
}
@media (min-width: 900px) {
  .cpage-hero-grid {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--gap-cols); align-items: center;
  }
}
@media (max-width: 899px) {
  .cpage-hero-media { margin-top: var(--space-7); aspect-ratio: 16 / 10; max-height: 280px; }
}

/* A landing page that heads others lists them first, under the hero: compact
   cards, four across on a desktop, two on a phone. */
.cpage-top { padding-top: var(--space-section-tight); }
.cpage-top-head {
  margin: 0 0 var(--space-6);
  font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.2vw, 28px);
  letter-spacing: -0.015em; line-height: 1.15;
}
.cpage-top .sec-grid { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--gap-tiles); }
.cpage-top .sec-card { padding: var(--pad-tile); border-radius: var(--radius); justify-content: center; min-height: 64px; }
.cpage-top .sec-card-head { align-items: center; }
.cpage-top .sec-card-head h3 { font-size: 15.5px; }
.cpage-top .sec-card:hover { border-color: var(--grn); background: var(--grn-soft); box-shadow: none; transform: translateY(-1px); }
@media (max-width: 560px) {
  .cpage-top .sec-grid { grid-template-columns: 1fr 1fr; }
  .cpage-top .sec-card { min-height: 0; padding: var(--space-2) var(--space-3); }
  .cpage-top .sec-card-head h3 { font-size: 13.5px; }
}
.cpage-top + .cpage-body-wrap { padding-top: var(--space-section-tight); }

/* The child cards follow the article on the same ground: one section gap,
   the wrap's bottom padding. */
.cpage-body-wrap + .section { padding-top: 0; }
.cpage-children .sec-grid { margin-top: var(--space-head); }
/* A body closing on "…below" sits close on the booking band (tracker C10):
   half a section, where every other page leaves a whole one. */
.cpage.onto-band .cpage-body-wrap { padding-bottom: var(--space-section-tight); }
</style>
