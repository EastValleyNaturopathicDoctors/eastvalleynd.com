---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PageImage from '../components/PageImage.astro';
import Icon from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';
import BookCTA from '../components/BookCTA.astro';
import InlineCTA from '../components/InlineCTA.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import BodyHtml from '../components/BodyHtml.astro';
import LongReadToc from '../components/LongReadToc.astro';
import { splitForCta } from '@/lib/midcta';
import { longReadFor, readingTime } from '@/lib/longread';
import { heroMode } from '@/lib/hero';
import { injectTileIcons } from '@/lib/icons';
import { cleanLinks } from '@/lib/links';
import { linkHubEntries, hasHubLinks } from '@/lib/hublinks';
import { trail as navTrail, live, isDuplicate } from '@/lib/nav';
import { stockFor, stockPlaceholders } from '@/lib/stock';
import { sectionIcons } from '@/data/section-icons';
import '../styles/section-cards.css';

interface Props { entry: CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
// `rendered.html` is the HTML <Content /> would emit: the bodies are migrated
// HTML, not markdown. It is rendered from the string so the pipeline's tile
// grids can carry their icons (D112) and long bodies can take a booking
// prompt part-way down (D103). A hub's entry list gets back the links it lost
// (tracker P1), then all links are tidied (tracker L3).
const body = injectTileIcons(cleanLinks(linkHubEntries(entry.rendered?.html ?? '', d.route), d.route));
// A long body gets its paste damage repaired, ids on its headings and a
// contents list (D131) — only when there are enough sections to list.
const long = longReadFor(body, d.wordCount);
const html = long ? long.html : body;
const halves = splitForCta(html);

// Breadcrumb and child links come from the same nav tree as the header. The
// breadcrumb keeps the full tree; the child cards skip placeholders (tracker N1).
const trail = navTrail(d.route);
const parents = trail.slice(0, -1);
const children = live(trail.at(-1)?.children ?? []);
// A leaf page carries the booking card beside the article; a page that heads a
// section ends in its child cards instead.
const aside = children.length === 0;
// A body that carries its own tile grid linking every child (D112), or a hub's
// linked entry list (tracker P1), is already the section's menu; the card list
// would repeat it.
const hasGrid = html.includes('wp-tilegrid') || hasHubLinks(d.route);
const showChildren = children.length > 0 && !(hasGrid && children.every((c) => html.includes(`href="${c.href}"`)));
const hero = d.imageFile ? heroMode(d.imageWidth) : 'none';
// A page WordPress gave no image carries an Unsplash photo instead, or a
// branded panel where none fitted (D118). Its own image always wins.
// Also when the page's own image is an icon-sized thumbnail D116 hides (D119).
const stock = hero === 'none' ? stockFor(d.route) : undefined;
const placeholder = hero === 'none' && !stock && stockPlaceholders.includes(d.route);
// The panel's icon: the page's own, else the nearest section's.
const segs = d.route.split('/').filter(Boolean);
const panelIcon = segs.map((_, i) => `/${segs.slice(0, segs.length - i).join('/')}/`)
  .map((r) => sectionIcons[r]).find(Boolean) ?? 'eco';
// A page that repeats another stays out of search engines until it redirects
// there; its canonical already names the page kept (tracker R2).
const duplicate = isDuplicate(d.route);
---
<Base title={d.title} description={d.metaDescription} canonicalPath={d.canonical || undefined}
      noindex={duplicate} searchSection={parents[0]?.label}>
  {long && <div class="lr-progress" aria-hidden="true"></div>}
  <article class:list={['cpage', long && 'is-long']}>
    <header class="page-hero cpage-hero">
      <div class="container">
        {parents.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
            {parents.map((p) => <a href={p.href}>{p.label}</a>)}
          </nav>
        )}
        {parents.length === 0 && <Eyebrow>East Valley Naturopathic Doctors</Eyebrow>}
        <h1 class="h1">{d.title}</h1>
        {long && (
          <p class="lr-meta" data-pagefind-ignore>
            <span>{readingTime(d.wordCount)}</span><span>{long.toc.length} sections</span>
          </p>
        )}
      </div>
    </header>

    {hero === 'wide' && (
      <div class="container cpage-figure">
        <PageImage file={d.imageFile} alt={d.imageAlt || d.title}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {stock && (
      <div class="container cpage-figure" data-pagefind-ignore>
        <PageImage set="stock" file={stock.file} alt={stock.alt}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {placeholder && (
      <div class="container cpage-figure" aria-hidden="true" data-pagefind-ignore>
        <div class="cpage-panel"><Icon name={panelIcon} size={56} /></div>
      </div>
    )}
    {hero === 'contained' && (
      <div class="container cpage-figure is-contained">
        <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                   width={960} height={0} loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class:list={['container', 'cpage-body-wrap', aside && 'has-aside', long && 'has-rail']}>
      <div class="cpage-body prose">
        {long && <LongReadToc items={long.toc} variant="panel" />}
        {hero === 'inset' && (
          <figure class="cpage-inset">
            <PageImage file={d.imageFile} alt={d.imageAlt || d.title} natural width={420} height={0} loading="eager" />
          </figure>
        )}
        {halves ? (
          <Fragment><BodyHtml html={halves[0]} /><InlineCTA topic={d.title} booking={d.booking} /><BodyHtml html={halves[1]} /></Fragment>
        ) : <BodyHtml html={html} />}
      </div>
      {long ? (
        <div class="lr-rail">
          <LongReadToc items={long.toc} variant="rail" />
          {aside && <SidebarCTA booking={d.booking} topic={d.title} compact />}
        </div>
      ) : aside && <SidebarCTA booking={d.booking} topic={d.title} />}
    </div>

    {showChildren && (
      <section class="section cpage-children" data-pagefind-ignore>
        <div class="container">
          <h2 class="h2">Explore {d.title}</h2>
          <div class="sec-grid" style="margin-top:26px">
            {children.map((c) => (
              <div class="sec-card">
                <a class="sec-card-head" href={c.href}>
                  <h3>{c.label}</h3>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <BookCTA />
</Base>

<style is:global>
/* --- Interior content pages -------------------------------------------------
   Prose rules match the blog and practitioner bios; all three are migrated
   WordPress copy and should read identically. */
.cpage-hero { border-bottom: none; padding-bottom: clamp(20px, 3vw, 32px); }
.cpage-hero .h1 { max-width: 20ch; font-size: clamp(34px, 4.6vw, 62px); }

.crumbs {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
  margin-bottom: 18px;
  font-family: var(--font-mono); font-size: 12px;
  letter-spacing: 0.06em; text-transform: uppercase;
}
.crumbs a { color: var(--ink-3); }
.crumbs a:hover { color: var(--grn-2); }
.crumbs a + a::before { content: '/'; margin-right: 8px; color: var(--line-2); }

.cpage-figure { margin-top: clamp(18px, 2.6vw, 30px); }
/* A mid-sized featured image at its own width, uncropped (D116). */
.cpage-figure.is-contained { display: flex; justify-content: center; }
.cpage-figure.is-contained img { width: auto; max-width: 100%; max-height: min(420px, 60vh); aspect-ratio: auto; object-fit: contain; }
/* A small one beside the opening paragraphs rather than stretched across the page. */
.cpage-inset { float: right; margin: 0.3em 0 1em 1.6em; max-width: min(42%, 320px); }
.cpage-inset img { margin: 0; border-radius: var(--radius); width: 100%; height: auto; }
@media (max-width: 560px) {
  .cpage-inset { float: none; margin: 0 auto 1.4em; max-width: 100%; display: flex; justify-content: center; }
  .cpage-inset img { width: auto; max-width: 100%; }
}
.cpage-figure img {
  width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
  border-radius: var(--radius-lg);
}
/* Stand-in where no stock photo fitted (D118): the phone hero's dark gradient
   (D12) and the section's icon, shorter than a photo so it reads as a band. */
.cpage-panel {
  display: grid; place-items: center; aspect-ratio: 21 / 9;
  border-radius: var(--radius-lg); color: var(--grn);
  background:
    radial-gradient(120% 80% at 78% 8%, rgba(108, 190, 63, 0.16) 0%, rgba(108, 190, 63, 0) 60%),
    linear-gradient(to bottom, #141A17 0%, #0E1311 60%, #0A0E0C 100%);
}
@media (max-width: 560px) { .cpage-panel { aspect-ratio: 16 / 9; } }

.cpage-body-wrap { padding: clamp(34px, 4.6vw, 60px) var(--pad) clamp(20px, 3vw, 40px); }
.cpage-body {
  max-width: 72ch; margin: 0 auto;
  font-size: 17.5px; line-height: 1.66; color: var(--ink-2);
}
.cpage-body > :first-child { margin-top: 0; }
.cpage-body p { margin: 0 0 1.2em; }
.cpage-body h1 { /* stray h1s from the old body; demote visually */
  font-family: var(--font-display); font-size: clamp(25px, 2.6vw, 33px);
  color: var(--ink); letter-spacing: -0.015em; line-height: 1.18; margin: 1.9em 0 0.5em;
}
.cpage-body h2, .cpage-body h3, .cpage-body h4 {
  font-family: var(--font-display); color: var(--ink);
  letter-spacing: -0.015em; line-height: 1.18; margin: 1.9em 0 0.5em;
}
.cpage-body h2 { font-size: clamp(24px, 2.5vw, 31px); }
.cpage-body h3 { font-size: clamp(20px, 2vw, 25px); }
.cpage-body h4 { font-size: 18px; }
.cpage-body ul, .cpage-body ol { margin: 0 0 1.2em; padding-left: 1.3em; }
.cpage-body li { margin-bottom: 0.45em; }
.cpage-body a { color: var(--grn-2); text-decoration: underline; text-underline-offset: 2px; }
/* A hub entry's linked heading (tracker P1) still reads as a heading; its
   "Learn More" words carry the usual link style. */
.cpage-body h3 > a.hub-link { color: inherit; text-decoration: none; }
.cpage-body h3 > a.hub-link:hover { color: var(--grn-2); text-decoration: underline; text-underline-offset: 3px; }
.cpage-body strong { color: var(--ink); }
.cpage-body img { max-width: 100%; height: auto; border-radius: var(--radius); margin: 1.4em 0; }
.cpage-body table { width: 100%; border-collapse: collapse; margin: 1.4em 0; font-size: 15px; }
.cpage-body th, .cpage-body td { border: 1px solid var(--line); padding: 9px 12px; text-align: left; }
.cpage-body .wp-linklist {
  list-style: none; padding: 0; display: grid; gap: 6px;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}
.cpage-body .wp-linklist a { text-decoration: none; font-weight: 500; }

/* Tile grid recovered from a WPBakery icon menu (D112): icon + label, linked.
   Three-up on a desktop; on a phone two compact rows so thirteen tiles are
   about seven rows, not thirteen full-width cards. */
.cpage-body .wp-tilegrid {
  list-style: none; margin: 1.6em 0 1.8em; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px;
}
.cpage-body .wp-tilegrid li { margin: 0; }
.cpage-body .wp-tilegrid a {
  display: flex; align-items: center; gap: 12px; min-height: 64px;
  padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius);
  background: var(--bg); color: var(--ink); text-decoration: none;
  font-weight: 500; font-size: 15.5px; line-height: 1.25;
  transition: border-color .18s, background .18s, color .18s, transform .18s;
}
.cpage-body .wp-tilegrid a:hover { border-color: var(--grn); background: var(--grn-soft); transform: translateY(-1px); }
.cpage-body .wp-tile-icon {
  flex: none; display: grid; place-items: center; width: 40px; height: 40px;
  border-radius: 12px; background: var(--grn-soft); color: var(--grn-2);
}
.cpage-body .wp-tilegrid a:hover .wp-tile-icon { background: var(--grn); color: var(--ink); }
@media (max-width: 560px) {
  .cpage-body .wp-tilegrid { grid-template-columns: 1fr 1fr; gap: 8px; margin: 1.3em 0 1.5em; }
  .cpage-body .wp-tilegrid a { min-height: 0; padding: 9px 10px; gap: 9px; font-size: 13.5px; }
  .cpage-body .wp-tile-icon { width: 30px; height: 30px; border-radius: 9px; }
  .cpage-body .wp-tile-icon svg { width: 18px; height: 18px; }
}

.cpage-children { padding-top: 0; }
</style>
