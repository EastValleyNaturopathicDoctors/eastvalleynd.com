---
import { jsonLd } from '@/lib/schema';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import BlogImage from '../components/BlogImage.astro';
import BodyHtml from '../components/BodyHtml.astro';
import LongReadToc from '../components/LongReadToc.astro';
import { heroMode, heroOnce, isOff169, opensWithMedia } from '@/lib/hero';
import PageImage from '../components/PageImage.astro';
import { stockFor } from '@/lib/stock';
import Eyebrow from '../components/Eyebrow.astro';
import BookCTA from '../components/BookCTA.astro';
import InlineCTA from '../components/InlineCTA.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import { splitForCta } from '@/lib/midcta';
import { longReadFor } from '@/lib/longread';
import { cleanLinks } from '@/lib/links';
import { tidyProse } from '@/lib/prose';
import { site } from '../data/site';
import { blogImageMeta } from '@/lib/blogimage';
import '../styles/pager.css';

interface Props { entry: CollectionEntry<'blog'> }
const { entry } = Astro.props;
const d = entry.data;
const slug = d.slug;
// A body that opens with the top image again shows it once (tracker R5).
const once = heroOnce(entry.rendered?.html ?? '', `/${slug}/`);
const body = tidyProse(cleanLinks(once.html, `/${slug}/`));   // trackers L3, K2
const long = longReadFor(body, d.wordCount);   // contents rail, D131
const html = long ? long.html : body;
const halves = splitForCta(html);   // mid-article booking prompt, D103
const hero = d.imageFile && !once.hideHero ? heroMode(d.imageWidth) : 'none';   // D116
// A wide image clearly not 16:9 shows whole in the frame, not cropped through
// its lettering (tracker I5).
const meta = d.imageFile ? blogImageMeta(d.imageFile) : undefined;
const whole = hero === 'wide' && !!meta && isOff169(meta.width, meta.height);
// A post WordPress gave no image opens on an Unsplash photo (D119), unless the
// body opens with its own video or picture (tracker I5).
const stock = hero === 'none' && !opensWithMedia(html) ? stockFor(`/${d.slug}/`) : undefined;

const all = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const i = all.findIndex((e) => e.data.slug === slug);
const prev = i > 0 ? all[i - 1] : null;
const next = i >= 0 && i < all.length - 1 ? all[i + 1] : null;

const fmt = (s: string) =>
  s ? new Date(s + 'T00:00:00').toLocaleDateString('en-US',
      { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  datePublished: d.date,
  dateModified: d.updated || d.date,
  author: { '@type': 'Organization', name: d.author || site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={d.title} description={d.metaDescription || d.excerpt} searchSection="Blog">
  {long && <div class="lr-progress" aria-hidden="true"></div>}
  <article class:list={['post', long && 'is-long']}>
    <header class="page-hero post-hero">
      <div class="container post-hero-inner">
        <Eyebrow><a href="/blog/">Blog</a></Eyebrow>
        <h1 class="h1">{d.title}</h1>
        <div class="post-meta">
          {d.date && <time datetime={d.date}>{fmt(d.date)}</time>}
          {d.author && <span>{d.author}</span>}
          {d.wordCount > 0 && <span>{Math.max(1, Math.round(d.wordCount / 220))} min read</span>}
        </div>
        {d.categories.length > 0 && (
          <ul class="post-cats">
            {d.categories.map((c) => <li>{c}</li>)}
          </ul>
        )}
      </div>
    </header>

    {hero === 'wide' && !whole && (
      <div class="container post-figure">
        <BlogImage file={d.imageFile} alt={d.imageAlt || d.title}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {stock && (
      <div class="container post-figure is-stock" data-pagefind-ignore>
        <PageImage set="stock" file={stock.file} alt={stock.alt}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {(hero === 'contained' || whole) && (
      <div class:list={['container', 'post-figure', 'is-contained', whole && 'is-whole']}>
        <div class="cpage-frame">
          <BlogImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                     width={whole ? 1200 : 960} height={0} loading="eager" fetchpriority="high" />
        </div>
      </div>
    )}

    <div class:list={['container', 'post-body-wrap', 'has-aside', long && 'has-rail']}>
      <div class="post-body prose">
        {long && <LongReadToc items={long.toc} variant="panel" />}
        {hero === 'inset' && (
          <figure class="cpage-inset">
            <BlogImage file={d.imageFile} alt={d.imageAlt || d.title} natural width={420} height={0} loading="eager" />
          </figure>
        )}
        {halves ? (
          <Fragment><BodyHtml html={halves[0]} /><InlineCTA /><BodyHtml html={halves[1]} /></Fragment>
        ) : <BodyHtml html={html} />}
      </div>
      {long ? (
        <div class="lr-rail">
          <LongReadToc items={long.toc} variant="rail" />
          <SidebarCTA compact />
        </div>
      ) : <SidebarCTA />}
    </div>
  </article>

  <nav class="pager post-pager" aria-label="More posts" data-pagefind-ignore>
    <div class="container">
      <div class="pager-inner">
        {prev ? (
          <a class="pager-link is-prev" href={`/${prev.data.slug}/`}>
            <Icon name="arrow-right" size={16} />
            <span><small>Previous</small>{prev.data.title}</span>
          </a>
        ) : <span />}
        <a class="pager-all" href="/blog/">All posts</a>
        {next ? (
          <a class="pager-link is-next" href={`/${next.data.slug}/`}>
            <span><small>Next</small>{next.data.title}</span>
            <Icon name="arrow-right" size={16} />
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

  <BookCTA />
  <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
</Base>

<style is:global>
/* --- Blog -------------------------------------------------------------------
   Post bodies share the article rules with content and legal pages
   (src/styles/prose.css, via BodyHtml); the pager is src/styles/pager.css.
   The hero keeps the page-hero padding: half a section under its last line. */
.post-hero { border-bottom: none; }
/* The header starts on the container's edge, as the image and every other
   template's title do; the h1 keeps its own measure (tracker K5). */
.post-hero .h1 { max-width: 22ch; font-size: clamp(34px, 4.6vw, 60px); }
.post-hero .eyebrow a { text-decoration: none; }

.post-meta {
  display: flex; flex-wrap: wrap; gap: var(--space-2) 0; margin-top: var(--space-5);
  font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.04em;
  color: var(--ink-3);
}
/* Every item carries its dot in the 16px to its left; the list is pulled out
   by that much and clipped back, so the dot on whichever item starts a line
   (the first, or one that wrapped) is cut off instead of dangling (tracker K5). */
.post-meta { margin-left: calc(-1 * var(--space-4)); clip-path: inset(0 0 0 var(--space-4)); }
.post-meta > * { position: relative; margin-left: var(--space-4); }
.post-meta > *::before {
  content: '·'; position: absolute; left: -10px; color: var(--line-2);
}
.post-cats { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: var(--space-3) 0 0; padding: 0; }
.post-cats li {   /* the eyebrow's pill */
  font-size: 12px; padding: 6px 10px; border-radius: 999px;
  background: var(--grn-soft); color: var(--grn-2); font-weight: 500;
}

.post-figure { margin: var(--space-section-tight) auto 0; }
.post-figure.is-contained { display: flex; justify-content: center; }
.post-figure.is-contained img { width: auto; max-width: 100%; max-height: min(420px, 60vh); aspect-ratio: auto; object-fit: contain; }
/* The same tinted frame as a content page's smaller images (tracker I5). A
   whole wide image fills the frame's width and stops at most of a screen. */
.cpage-frame {
  display: flex; align-items: center; justify-content: center; width: 100%;
  padding: var(--pad-feature); background: var(--bg-soft); border-radius: var(--radius-lg);
}
.post-figure .cpage-frame img { border-radius: var(--radius); }
.post-figure.is-whole img { max-height: min(640px, 72vh); }
@media (min-width: 720px) {
  .post-figure.is-contained:not(.is-whole) .cpage-frame { aspect-ratio: 21 / 9; }
  .post-figure.is-contained:not(.is-whole) .cpage-frame img { max-height: min(100%, 420px); }
  .post-figure.is-stock img { aspect-ratio: 21 / 9; }
}
.cpage-inset { float: right; margin: 0.3em 0 var(--space-4) var(--space-6); max-width: min(42%, 320px); }
.cpage-inset img { margin: 0; border-radius: var(--radius); width: 100%; height: auto; }
@media (max-width: 560px) {
  .cpage-inset { float: none; margin: 0 auto var(--space-6); max-width: 100%; display: flex; justify-content: center; }
  .cpage-inset img { width: auto; max-width: 100%; }
}
.post-figure img {
  width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
  border-radius: var(--radius-lg);
}

/* Half a section under the hero's edge (one block after a featured image)
   and half a section above the pager's rule. */
.post-body-wrap { padding-block: var(--space-section-tight); }
.post-figure + .post-body-wrap { padding-top: var(--space-block); }
.post-body .wp-linklist { list-style: none; padding: 0; display: grid; gap: var(--space-2);
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
.post-body .wp-linklist a { text-decoration: none; font-weight: 500; }
</style>
