---
import { jsonLd } from '@/lib/schema';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import BlogImage from '../components/BlogImage.astro';
import BodyHtml from '../components/BodyHtml.astro';
import { heroMode } from '@/lib/hero';
import Eyebrow from '../components/Eyebrow.astro';
import BookCTA from '../components/BookCTA.astro';
import InlineCTA from '../components/InlineCTA.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import { splitForCta } from '@/lib/midcta';
import { site } from '../data/site';

interface Props { entry: CollectionEntry<'blog'> }
const { entry } = Astro.props;
const d = entry.data;
const slug = d.slug;
const html = entry.rendered?.html ?? '';
const halves = splitForCta(html);   // mid-article booking prompt, D103
const hero = d.imageFile ? heroMode(d.imageWidth) : 'none';   // D116

const all = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const i = all.findIndex((e) => e.data.slug === slug);
const prev = i > 0 ? all[i - 1] : null;
const next = i >= 0 && i < all.length - 1 ? all[i + 1] : null;

const fmt = (s: string) =>
  s ? new Date(s + 'T00:00:00').toLocaleDateString('en-US',
      { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  datePublished: d.date,
  dateModified: d.updated || d.date,
  author: { '@type': 'Organization', name: d.author || site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={d.title} description={d.metaDescription || d.excerpt} searchSection="Blog">
  <article class="post">
    <header class="page-hero post-hero">
      <div class="container post-hero-inner">
        <Eyebrow><a href="/blog/">Blog</a></Eyebrow>
        <h1 class="h1">{d.title}</h1>
        <div class="post-meta">
          {d.date && <time datetime={d.date}>{fmt(d.date)}</time>}
          {d.author && <span>{d.author}</span>}
          {d.wordCount > 0 && <span>{Math.max(1, Math.round(d.wordCount / 220))} min read</span>}
        </div>
        {d.categories.length > 0 && (
          <ul class="post-cats">
            {d.categories.map((c) => <li>{c}</li>)}
          </ul>
        )}
      </div>
    </header>

    {hero === 'wide' && (
      <div class="container post-figure">
        <BlogImage file={d.imageFile} alt={d.imageAlt || d.title}
                   width={1200} height={675} loading="eager" fetchpriority="high" />
      </div>
    )}
    {hero === 'contained' && (
      <div class="container post-figure is-contained">
        <BlogImage file={d.imageFile} alt={d.imageAlt || d.title} natural
                   width={960} height={0} loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="container post-body-wrap has-aside">
      <div class="post-body prose">
        {hero === 'inset' && (
          <figure class="cpage-inset">
            <BlogImage file={d.imageFile} alt={d.imageAlt || d.title} natural width={420} height={0} loading="eager" />
          </figure>
        )}
        {halves ? (
          <Fragment><BodyHtml html={halves[0]} /><InlineCTA /><BodyHtml html={halves[1]} /></Fragment>
        ) : <BodyHtml html={html} />}
      </div>
      <SidebarCTA />
    </div>
  </article>

  <nav class="section post-pager" aria-label="More posts" data-pagefind-ignore>
    <div class="container post-pager-inner">
      {prev ? (
        <a class="post-pager-link is-prev" href={`/${prev.data.slug}/`}>
          <Icon name="arrow-right" size={16} />
          <span><small>Previous</small>{prev.data.title}</span>
        </a>
      ) : <span />}
      <a class="post-pager-all" href="/blog/">All posts</a>
      {next ? (
        <a class="post-pager-link is-next" href={`/${next.data.slug}/`}>
          <span><small>Next</small>{next.data.title}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      ) : <span />}
    </div>
  </nav>

  <BookCTA />
  <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
</Base>

<style is:global>
/* --- Blog -------------------------------------------------------------------
   Post bodies reuse the same prose rules as the practitioner bios; both are
   migrated WordPress copy and should read identically. */
.post-hero { border-bottom: none; padding-bottom: clamp(24px, 3vw, 36px); }
.post-hero-inner { max-width: 78ch; }
.post-hero .h1 { max-width: 22ch; font-size: clamp(34px, 4.6vw, 60px); }
.post-hero .eyebrow a { text-decoration: none; }

.post-meta {
  display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 20px;
  font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.04em;
  color: var(--ink-3);
}
.post-meta > * { position: relative; }
.post-meta > * + *::before {
  content: '·'; position: absolute; left: -11px; color: var(--line-2);
}
.post-cats { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 16px 0 0; padding: 0; }
.post-cats li {
  font-size: 12px; padding: 5px 11px; border-radius: 999px;
  background: var(--grn-soft); color: var(--grn-2); font-weight: 500;
}

.post-figure { margin: clamp(20px, 3vw, 34px) auto 0; }
.post-figure.is-contained { display: flex; justify-content: center; }
.post-figure.is-contained img { width: auto; max-width: 100%; max-height: min(420px, 60vh); aspect-ratio: auto; object-fit: contain; }
.cpage-inset { float: right; margin: 0.3em 0 1em 1.6em; max-width: min(42%, 320px); }
.cpage-inset img { margin: 0 !important; border-radius: var(--radius); width: 100%; height: auto; }
@media (max-width: 560px) {
  .cpage-inset { float: none; margin: 0 auto 1.4em; max-width: 100%; display: flex; justify-content: center; }
  .cpage-inset img { width: auto; max-width: 100%; }
}
.post-figure img {
  width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
  border-radius: var(--radius-lg);
}

.post-body-wrap { padding: clamp(36px, 5vw, 64px) var(--pad) clamp(48px, 6vw, 80px); }
.post-body {
  max-width: 72ch; margin: 0 auto;
  font-size: 17.5px; line-height: 1.66; color: var(--ink-2);
}
.post-body > :first-child { margin-top: 0; }
.post-body p { margin: 0 0 1.2em; }
.post-body h2, .post-body h3, .post-body h4 {
  font-family: var(--font-display); color: var(--ink);
  letter-spacing: -0.015em; line-height: 1.18; margin: 1.9em 0 0.5em;
}
.post-body h2 { font-size: clamp(25px, 2.6vw, 33px); }
.post-body h3 { font-size: clamp(21px, 2.1vw, 26px); }
.post-body h4 { font-size: 18px; }
.post-body ul, .post-body ol { margin: 0 0 1.2em; padding-left: 1.3em; }
.post-body li { margin-bottom: 0.45em; }
.post-body a { color: var(--grn-2); text-decoration: underline; text-underline-offset: 2px; }
.post-body strong { color: var(--ink); }
.post-body img { border-radius: var(--radius); margin: 1.4em 0; }
.post-body blockquote {
  margin: 1.6em 0; padding: 4px 0 4px 22px;
  border-left: 3px solid var(--grn); color: var(--ink);
  font-size: 19px;
}
.post-body .wp-linklist { list-style: none; padding: 0; display: grid; gap: 6px;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
.post-body .wp-linklist a { text-decoration: none; font-weight: 500; }

/* Prev / next */
.post-pager { padding-top: 0; }
.post-pager-inner {
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  border-top: 1px solid var(--line); padding-top: 28px; flex-wrap: wrap;
}
.post-pager-link { display: inline-flex; align-items: center; gap: 12px; max-width: 40%; }
.post-pager-link small {
  display: block; font-family: var(--font-mono); font-size: 12px;
  text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3);
}
.post-pager-link span { font-weight: 500; }
.post-pager-link.is-prev svg { transform: rotate(180deg); flex: none; }
.post-pager-link.is-next svg { flex: none; }
.post-pager-link:hover { color: var(--grn-2); }
.post-pager-all { font-size: 14px; color: var(--ink-3); }
.post-pager-all:hover { color: var(--ink); }

@media (max-width: 820px) {
  .post-pager-link { max-width: 100%; }
  .post-pager-inner { flex-direction: column; align-items: flex-start; }
}
</style>
