---
import { jsonLd } from '@/lib/schema';
import '../styles/global.css';
import '../styles/font-fallbacks.css';   // generated: scripts/font-fallbacks.mjs
// Fonts are self-hosted (fontsource) rather than fetched from Google. Two
// reasons: a third-party DNS+TLS+CSS+font chain sat on the critical path of
// every page, and for a medical practice, Google Fonts is a GDPR exposure the
// site does not need. Latin subset only; only the weights the stylesheet sets.
// Roboto and Roboto Condensed (Nov 2026 preview): the logo's own face. Roboto
// Condensed sets the headings and the small uppercase labels, Roboto the text.
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-600.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto-condensed/latin-400.css';
import '@fontsource/roboto-condensed/latin-500.css';
import '@fontsource/roboto-condensed/latin-600.css';
// Preload the two faces that paint above the fold: Roboto Condensed 500 sets
// the hero title, Roboto 400 the text under it. Without a preload the hero
// rendered in the fallback and reflowed when the font landed. `?url` hands
// back the hashed path Vite will emit, so the preload can never drift from
// the file the stylesheet references.
import displayWoff2 from '@fontsource/roboto-condensed/files/roboto-condensed-latin-500-normal.woff2?url';
import bodyWoff2 from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';
import TopBar from '../components/TopBar.astro';
import MainNav from '../components/MainNav.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import { seoTitles } from '../data/seo-titles';
import { metaDescriptions } from '../data/meta-descriptions';
import preview from '../data/preview.json';

interface Props {
  title: string;
  description?: string;
  /** Dark hero pages let the nav sit transparent over the top. */
  transparentNav?: boolean;
  ogImage?: string;
  /**
   * Points elsewhere when this page deliberately repeats another one's body.
   * The sitemap files Long COVID under both the Brain Regeneration Clinic and
   * Conditions; both are wanted in the IA, but only one should be indexed.
   */
  canonicalPath?: string;
  /** Keep a page out of search results. Set on anything unfinished. */
  noindex?: boolean;
  /** No canonical link at all: the 404 page, which has no address of its own. */
  noCanonical?: boolean;
  /** The phone action bar. Off on the appointment forms — see ActionBar.astro. */
  actionBar?: boolean;
  /**
   * Whether the site search may return this page (D110). Defaults to true; a
   * page that is `noindex` or canonicals elsewhere is never searchable
   * whatever this says. Off on the homepage and the 404.
   */
  searchable?: boolean;
  /** Shown beside the title in a search result — "Conditions", "Blog", … */
  searchSection?: string;
}
const {
  title,
  description = site.tagline,
  transparentNav = false,
  ogImage = '/assets/evnd-logo.png',
  canonicalPath,
  noindex = false,
  noCanonical = false,
  actionBar = true,
  searchable = true,
  searchSection,
} = Astro.props;

// While the site is up for preview nothing is indexable, whatever the page
// asked for. `nofollow` as well, so a crawler that reaches the preview host does
// not walk it. See src/data/preview.json for how to turn this off.
const robots = preview.noindex ? 'noindex, nofollow' : (noindex ? 'noindex, follow' : '');

// The search index is built from the HTML: only a <main> carrying
// `data-pagefind-body` is indexed, and once any page has it every page without
// it is dropped. So the rule "searchable ⇔ in sitemap.xml" is enforced here and
// proved after every build by scripts/search-index.mjs. The title and section
// ride along as result metadata, read from the attributes named in brackets.
const searched = searchable && !noindex && !canonicalPath;
const searchMeta = searched
  ? ['title[data-search-title]', searchSection && 'section[data-search-section]'].filter(Boolean).join(', ')
  : undefined;

// A search title for the page, where its own title lost the words people
// search for (src/data/seo-titles.ts); the visible H1 keeps the page's title.
const seoTitle = seoTitles[Astro.url.pathname];
const shown = seoTitle ?? title;
const fullTitle = shown.includes(site.name) ? shown : `${shown} — ${site.short}`;
// A description that was wrong in migration (src/data/meta-descriptions.ts).
const metaDescription = metaDescriptions[Astro.url.pathname] ?? description;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href;
const a = site.address;

// LocalBusiness/MedicalClinic schema — the old site had this via Yoast.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  url: Astro.site?.href,
  image: new URL('/assets/evnd-logo.png', Astro.site).href,
  logo: new URL('/assets/evnd-logo.png', Astro.site).href,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: a.city,
    addressRegion: a.state,
    postalCode: a.zip,
    addressCountry: 'US',
  },
  medicalSpecialty: 'Naturopathic',
  faxNumber: site.fax,
  openingHoursSpecification: openingHours(),
};

/** "9:00 am – 5:00 pm" per day -> schema.org hours, split around the lunch
 *  closure so Google doesn't show the clinic as open at 12:30 (D125). */
function openingHours() {
  const to24 = (t: string) => {
    const m = t.trim().match(/^(\d{1,2}):(\d{2})\s*(am|pm)$/i);
    if (!m) return '';
    let h = Number(m[1]) % 12;
    if (m[3].toLowerCase() === 'pm') h += 12;
    return `${String(h).padStart(2, '0')}:${m[2]}`;
  };
  const { from, to } = site.lunchBreak;
  return site.hours.flatMap(({ days, time }) => {
    const [opens, closes] = time.split('–').map(to24);
    if (!opens || !closes) return [];
    const spans = opens < from && closes > to ? [[opens, from], [to, closes]] : [[opens, closes]];
    return spans.map(([o, c]) => ({
      '@type': 'OpeningHoursSpecification', dayOfWeek: days, opens: o, closes: c,
    }));
  });
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  {!noCanonical && <link rel="canonical" href={canonical} />}
  <link rel="preload" href={displayWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bodyWoff2} as="font" type="font/woff2" crossorigin />
  {robots && <meta name="robots" content={robots} />}
  <!-- The logo's leaf (public/favicon.svg, built with the header logo by
       scripts/build-animated-logo.py); .ico for older browsers and the
       /favicon.ico request, a white-ground PNG for the iOS home screen. -->
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Weights are exactly what the stylesheet uses: 400 body, 500 buttons and
       chips, 600 labels and headings, 700 for <strong> and the prose headings
       that inherit the browser default. -->
  <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
</head>
<body class:list={[transparentNav && 'has-dark-hero', actionBar && 'has-actionbar']}>
  <a href="#main" class="skip-link">Skip to content</a>
  <TopBar />
  <MainNav />
  <main id="main"
        data-pagefind-body={searched ? '' : undefined}
        data-pagefind-meta={searchMeta}
        data-search-title={searched ? title : undefined}
        data-search-section={searched ? searchSection : undefined}>
    <slot />
  </main>
  <SearchDialog />
  <Footer />
  {actionBar && <ActionBar />}
</body>
</html>
