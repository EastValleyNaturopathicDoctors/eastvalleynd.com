---
/**
 * Legal and policy pages (D121): /privacy/, /terms-conditions/,
 * /messaging-terms/, /accessibility/, /good-faith-estimate/.
 * A plain reading column — no booking card, no mid-page prompt: nobody comes
 * to a privacy policy to book, and a sales prompt inside one reads badly.
 */
import Base from './Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { footerLegal } from '@/data/site';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  /** Shown under the title, e.g. "Last updated September 2026". */
  updated?: string;
}
const { title, description, updated } = Astro.props;
const here = Astro.url.pathname;
---
<Base title={title} description={description} searchSection="Legal">
  <article class="legal">
    <header class="page-hero legal-hero">
      <div class="container">
        <Eyebrow>East Valley Naturopathic Doctors</Eyebrow>
        <h1 class="h1">{title}</h1>
        {updated && <p class="legal-updated">{updated}</p>}
      </div>
    </header>
    <div class="container legal-wrap">
      <div class="legal-body prose">
        <slot />
      </div>
      <nav class="legal-nav" aria-label="Policies" data-pagefind-ignore>
        <p>Policies</p>
        <ul>
          {footerLegal.map((l) => (
            <li><a href={l.href} aria-current={l.href === here ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</Base>

<style is:global>
/* The hero keeps the page-hero padding; the body's prose rules are shared
   with content pages and posts (src/styles/prose.css). */
.legal-hero .h1 { max-width: 22ch; font-size: clamp(34px, 4.6vw, 58px); }
.legal-updated {
  margin: var(--space-5) 0 0; font-family: var(--font-mono); font-size: 12px;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3);
}
.legal-wrap {
  display: grid; grid-template-columns: minmax(0, var(--measure-prose)) 220px; justify-content: space-between;
  gap: var(--gap-cols);
  padding-block: var(--space-section-tight) var(--space-section);
}
/* A block of someone else's words kept verbatim — the clinic's SMS policies. */
.legal-verbatim {
  margin: var(--space-7) 0; padding: var(--pad-card);
  border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-softer);
}
.legal-verbatim > :first-child { margin-top: 0; }
.legal-verbatim > :last-child { margin-bottom: 0; }
.legal-note {
  padding: var(--pad-row); border-left: 3px solid var(--grn); background: var(--grn-soft);
  border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink);
}
.legal-nav { position: sticky; top: 110px; align-self: start; font-size: 15px; }
.legal-nav p {
  margin: 0 0 var(--space-3); font-family: var(--font-mono); font-size: 12px;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3);
}
.legal-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
.legal-nav a { display: block; padding: 7px 12px; border-radius: 10px; color: var(--ink-2); }
.legal-nav a:hover { background: var(--bg-soft); color: var(--ink); }
.legal-nav a[aria-current='page'] { background: var(--grn-soft); color: var(--ink); font-weight: 600; }
@media (max-width: 900px) {
  .legal-wrap { grid-template-columns: minmax(0, 1fr); }
  .legal-nav { position: static; border-top: 1px solid var(--line); padding-top: var(--space-6); }
}
</style>
