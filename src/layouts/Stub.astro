---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { childrenOf } from '@/lib/nav';

interface Props { title: string; path: string; }
const { title, path } = Astro.props;

/**
 * A section whose copy has not arrived still has to be navigable. Three of
 * these — /iv-therapy/, /injection-therapy/ and the tDCS page — sit above 8
 * finished pages between them, and when the mega menu stopped listing
 * grandchildren those children had no inbound link left at all. Listing them
 * here fixes it where it belongs: the parent page.
 */
const children = childrenOf(path);
---
<!-- noindex: this page says "waiting on content" — it must not be indexed,
     and it is excluded from sitemap.xml by the same token. `follow` so the
     nav links on it still pass through. -->
<Base title={title} description={`${title} — ${site.name}, Mesa AZ.`} noindex>
  <section class="page-hero stub-hero">
    <div class="container">
      <h1 class="h1">{title}</h1>
      <p class="stub-note">
        This page is scaffolded and waiting on content.
        <code>{path}</code>
      </p>
    </div>
  </section>

  {children.length > 0 && (
    <section class="section stub-children">
      <div class="container">
        <h2 class="h2">In this section</h2>
        <ul class="stub-child-list">
          {children.map((c) => (
            <li>
              <a href={c.href}>
                <span>{c.label}</span>
                <Icon name="arrow-right" size={15} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style is:global>
/* Scaffolded pages — visibly unfinished on purpose, so an empty page is never
   mistaken for a broken one during review. */
.stub-hero { border-bottom: none; }
.stub-note {
  margin-top: 20px; font-size: 14px; color: var(--ink-3);
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.stub-note code {
  font-family: var(--font-mono); font-size: 12.5px;
  background: var(--bg-soft); border: 1px solid var(--line);
  padding: 4px 8px; border-radius: 6px; color: var(--ink-2);
}

/* A scaffolded section still lists what is under it — see Stub.astro. */
.stub-children { padding-top: clamp(28px, 4vw, 44px); }
.stub-children .h2 { font-size: clamp(24px, 2.6vw, 32px); margin-bottom: 22px; }
.stub-child-list {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
  gap: 10px;
}
.stub-child-list a {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 15px 18px; border: 1px solid var(--line); border-radius: var(--radius);
  font-size: 15.5px; font-weight: 500; color: var(--ink-2);
  transition: border-color .18s, background .18s, color .18s;
}
.stub-child-list a:hover { border-color: var(--grn); background: var(--grn-soft); color: var(--ink); }
.stub-child-list svg { flex: none; color: var(--ink-3); }
.stub-child-list a:hover svg { color: var(--grn-2); }
</style>
