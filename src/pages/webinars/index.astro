---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import BookCTA from '@/components/BookCTA.astro';
import Icon from '@/components/Icon.astro';
import data from '@/data/webinars.json';

/**
 * Replaces /evnd-webinars/ — the sitemap's Note for this row is
 * "Update URL from https://www.eastvalleynd.com/evnd-webinars/".
 *
 * The list is generated: extract/build_webinars.py reads the six
 * [vc_video] + heading pairs out of the old page's WPBakery source, in page
 * order, and downloads each poster frame. Do not hand-edit webinars.json.
 */
const webinars = data.webinars;
const CHANNEL = 'https://www.youtube.com/@eastvalleynaturopathicdoct5601';
---
<Base
  title="Webinars"
  description="East Valley Naturopathic Doctors have curated a library of webinars where our doctors share research in a long form format.">
  <PageHero
    eyebrow="Resources"
    title="Our doctors, at length."
    lede="A library of recorded webinars where our physicians work through the research on a single topic properly — not in the ten minutes an appointment allows."
  />

  <section class="section webinars-section">
    <div class="container">
      <div class="webinars-grid">
        {webinars.map((w, i) => (
          <VideoFacade
            id={w.id} title={w.title} youtubeTitle={w.youtubeTitle}
            posterFile={w.posterFile} loading={i < 2 ? 'eager' : 'lazy'}
          />
        ))}
      </div>

      <p class="webinars-more">
        <a href={CHANNEL} target="_blank" rel="noopener">
          More on our YouTube channel <Icon name="arrow-up-right" size={14} />
        </a>
      </p>
    </div>
  </section>

  <BookCTA />
</Base>


<style is:global>
/* --- Webinars ---------------------------------------------------------------
   Poster-first video cards. The iframe is only created on click (see
   VideoFacade.astro), so the grid costs six local images, not six players. */
.webinars-grid {
  /* min() so the track can shrink below 340px on a narrow phone instead of
     forcing the page to scroll sideways. */
  display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
  gap: clamp(24px, 3vw, 40px);
}

.webinars-more { margin: clamp(36px, 4vw, 52px) 0 0; }
.webinars-more a {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 20px; border: 1px solid var(--line); border-radius: 999px;
  font-size: 14.5px; font-weight: 500; color: var(--ink-2);
  transition: border-color .18s, background .18s, color .18s;
}
.webinars-more a:hover { border-color: var(--grn); background: var(--grn-soft); color: var(--ink); }
</style>
