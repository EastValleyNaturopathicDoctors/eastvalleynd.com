---
import { getCollection } from 'astro:content';
import PageImage from '@/components/PageImage.astro';
import { stockFor } from '@/lib/stock';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionIndex from '../components/SectionIndex.astro';
import BlogImage from '../components/BlogImage.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import BookCTA from '../components/BookCTA.astro';
import '../styles/post-cards.css';

const latest = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 6);
const fmt = (s: string) =>
  s ? new Date(s + 'T00:00:00').toLocaleDateString('en-US',
      { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---
<Base
  title="Resources"
  description="Articles, webinars, forms and patient information from the clinicians at East Valley Naturopathic Doctors.">
  <PageHero
    eyebrow="Resources"
    title="Learn the medicine, then decide."
    lede="Articles from our physicians, webinars, patient forms and everything you need before your first visit."
  />

  <section class="section">
    <div class="container">
      <SectionIndex root="/resources/" showChildren={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Latest from the blog</h2>
        </div>
        <div class="section-head-right">
          <a class="btn btn-ghost" href="/blog/">All articles <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <div class="post-grid">
        {latest.map((p) => (
          <a class="post-card" href={`/${p.data.slug}/`}>
            <div class="post-card-media">
              {p.data.imageFile
                ? <BlogImage file={p.data.imageFile} alt={p.data.imageAlt || p.data.title} width={640} height={400} />
                : stockFor(`/${p.data.slug}/`)
                  ? <PageImage set="stock" file={stockFor(`/${p.data.slug}/`)!.file} alt={stockFor(`/${p.data.slug}/`)!.alt} width={640} height={400} />
                  : <span class="post-card-placeholder" aria-hidden="true"><Icon name="leaf" size={26} /></span>}
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                {p.data.categories[0] && <span class="post-card-cat">{p.data.categories[0]}</span>}
                <time datetime={p.data.date}>{fmt(p.data.date)}</time>
              </div>
              <h3>{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ showCta={false} />
  <BookCTA />
</Base>
