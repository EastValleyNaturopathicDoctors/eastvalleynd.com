---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Foundations from '../components/Foundations.astro';
import Practitioners from '../components/Practitioners.astro';
import SectionHead from '../components/SectionHead.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import BookCTA from '../components/BookCTA.astro';
import Icon from '../components/Icon.astro';
import entrance from '../images/site/clinic-entrance.webp';
import frontDesk from '../images/site/clinic-front-desk.webp';
import waitingRoom from '../images/site/clinic-waiting-room.webp';
import treatmentRoom from '../images/site/clinic-treatment-room.webp';
import hbotRoom from '../images/site/clinic-hyperbaric-room.jpg';

/**
 * The clinic's own photos, never stock: this page is about the people and the
 * place. The therapy photos come from the WordPress site; the entrance, front
 * desk, waiting room and treatment room from the clinic's Google listing,
 * chosen by the clinic (Oct 2026). In the order of a visit: arriving, checking
 * in, waiting, then the rooms. Copied into src/images/site so a regenerated
 * page image can't swap one out from under its caption. A tile with an href
 * links its caption. The microcurrent photo isn't here: EVND Foundations, a
 * few sections up, already shows it; nor is the entrance, which opens the
 * page in place of the team photo until the clinic has a new one (it asked at
 * the Oct 8, 2026 meeting: some of the people in it have left).
 */
const clinic: { src: ImageMetadata; caption: string; alt: string; href?: string }[] = [
  { src: frontDesk, caption: 'The front desk',
    alt: "The clinic's front desk, with supplement shelves behind it" },
  { src: waitingRoom, caption: 'The waiting room',
    alt: 'The waiting room: a row of chairs along the wall beside the reception counter' },
  { src: treatmentRoom, caption: 'A treatment room',
    alt: 'A treatment room with a reclining chair and footstool beneath framed desert photographs' },
  { src: hbotRoom, href: '/hyperbaric-oxygen-therapy/', caption: 'Hyperbaric oxygen therapy',
    alt: 'A Vitaeris 320 hyperbaric chamber beside its oxygen concentrator in a treatment room' },
];
---
<Base
  title="About EVND"
  description="East Valley Naturopathic Doctors has practiced whole-person naturopathic medicine in Mesa, Arizona since 2008. Meet the framework and the clinicians behind it.">
  <PageHero
    eyebrow="About"
    title="Eighteen years of treating the cause, not the chart."
    lede="East Valley Naturopathic Doctors opened in Mesa in 2008. Seven licensed clinicians, one in-house clinic, and a framework — EVND Foundations — refined across thousands of complex cases."
  />
  <div class="about-team">
    <div class="container">
      <Image src={entrance} alt="The walkway to the clinic's Suite 110 entrance on Southern Avenue, East Valley Naturopathic Doctors lettered on the glass door" width={1360}
             class="about-team-photo" loading="eager" fetchpriority="high" />
    </div>
  </div>
  <TrustStrip />
  <Foundations />

  <section class="section about-clinic is-band" data-pagefind-ignore>
    <div class="container">
      <SectionHead
        eyebrow="Inside the clinic"
        blurb="Suite 110 on Southern Avenue in Mesa: the front desk, the waiting room, and the treatment rooms. The IV suite, regenerative injection room, HBOT chamber and neurofeedback lab are all under one roof."
        ctaLabel="All services" ctaHref="/services/">
        Come see the clinic.
      </SectionHead>
      <div class="clinic-grid">
        {clinic.map((p) => (
          <figure class="clinic-tile">
            <Image src={p.src} alt={p.alt} width={900} />
            <figcaption>
              {p.href
                ? <a href={p.href}>{p.caption}<Icon name="arrow-right" size={14} /></a>
                : <span>{p.caption}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Practitioners />
  <Testimonials />
  <BookCTA />
</Base>

<style is:global>
/* The team photo straddles the hero's lower edge, so the hero gives up its own
   bottom padding: the photo sits half a section under the lede, and the trust
   strip half a section under the photo. */
.page-hero:has(+ .about-team) { border-bottom: 0; padding-bottom: 0; display: flow-root; }
.about-team {
  padding-block: var(--space-hero-bottom);
  background: linear-gradient(var(--bg-softer) 50%, #fff 50%);
}
.about-team-photo { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: var(--radius-lg); }

.about-clinic { background: var(--bg-soft); }
.clinic-grid {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--gap-cards);
}
.clinic-tile { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-sunk); }
.clinic-tile img { display: block; width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; }
.clinic-tile figcaption { position: absolute; left: var(--space-4); right: var(--space-4); bottom: var(--space-4); display: flex; }
.clinic-tile figcaption :is(a, span) {
  display: inline-flex; align-items: center; gap: var(--space-2);
  background: rgba(255,255,255,0.95);
  padding: var(--space-2) var(--space-3);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--ink);
}
.clinic-tile figcaption svg { color: var(--grn-2); flex-shrink: 0; transition: transform .2s; }
.clinic-tile figcaption a:hover svg { transform: translateX(3px); }

/* Four even tiles: four across, two on a tablet or laptop, one on a phone. */
@media (max-width: 1100px) { .clinic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .clinic-grid { grid-template-columns: 1fr; } }
</style>
