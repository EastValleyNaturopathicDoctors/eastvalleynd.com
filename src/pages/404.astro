---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookCTA from '../components/BookCTA.astro';
import Icon from '../components/Icon.astro';
import { nav } from '@/lib/nav';
import '../styles/link-rows.css';
---
<Base title="Page not found" description="That page has moved or no longer exists." searchable={false}>
  <PageHero
    eyebrow="404"
    title="That page has moved."
    lede="The link you followed no longer points anywhere. Try one of these, or call us and we'll point you the right way."
  />
  <section class="section">
    <div class="container">
      <ul class="link-rows">
        {nav.map((l) => (
          <li>
            <a href={l.href}>
              <span>{l.label}</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <BookCTA />
</Base>
