---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionIndex from '../components/SectionIndex.astro';
import TrustStrip from '../components/TrustStrip.astro';
import TruDOSE from '../components/TruDOSE.astro';
import BookCTA from '../components/BookCTA.astro';
import { find, live } from '@/lib/nav';

const section = find('/services/');
// Counts what the index below shows: placeholders are not listed (tracker N1).
const count = live(section?.children ?? []).length;
---
<Base
  title="Services & Therapies"
  description="IV therapy, regenerative injections, hyperbaric oxygen, neurofeedback, ozone, hormone therapy and specialty labs — a real in-house clinic in Mesa, AZ.">
  <PageHero
    eyebrow="Services & therapies"
    title="A real in-house clinic, not a referral wall."
    lede={`${count} services under one roof in Mesa — IV suite, regenerative injection room, HBOT chamber, neurofeedback lab, and full functional-lab partnerships.`}
  />
  <TrustStrip />
  <section class="section">
    <div class="container">
      <SectionIndex root="/services/" panelsLabel="Programs and clinics" tilesLabel="Individual treatments"
        filter={{ label: 'Find a service', placeholder: 'Try “IV”, “brain” or “hormone”' }} />
    </div>
  </section>
  <TruDOSE />
  <BookCTA />
</Base>
