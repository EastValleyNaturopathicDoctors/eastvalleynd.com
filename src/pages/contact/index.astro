---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import PractitionerCard from '@/components/PractitionerCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getCollection } from 'astro:content';
import { site, mapQuery, directionsHref } from '@/data/site';
import { keepTimes } from '@/lib/times';

const a = site.address;
// Each practitioner's Schedule link, from the booking the old site embedded on
// their page (D115): one scheduler opens directly; several appointment types
// open the list on their profile; none goes to the request form.
const team = (await getCollection('physicians'))
  .sort((x, y) => x.data.order - y.data.order)
  .map(({ data: d }) => ({
    ...d,
    schedule: d.booking.length === 1 ? { href: d.booking[0].url, external: true }
      : d.booking.length > 1 ? { href: `/physicians/${d.slug}/#book`, external: false }
      : { href: '/schedule-appointment/', external: false },
  }));
---
<Base
  title="Contact"
  description={`Contact East Valley Naturopathic Doctors in ${a.city}, ${a.state}. Call ${site.phone}, or send the front desk a message.`}>
  <PageHero
    eyebrow="Contact"
    title="Come see us in Mesa."
    lede="Established patients can book online under their doctor. New patients — call the office or send a message and we'll get you scheduled."
  />

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-details">
        <div class="contact-block">
          <h2>Clinic</h2>
          <p class="contact-addr">
            {site.name}<br />
            {a.street}<br />
            {a.city}, {a.state} {a.zip}
          </p>
          <p class="contact-lines">
            <a href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
            {site.fax && <span><Icon name="send" size={15} />Fax {site.fax}</span>}
          </p>
          <div class="hero-cta">
            <Button href="/schedule-appointment/" variant="dark" icon="calendar">Schedule an appointment</Button>
          </div>
        </div>

        <div class="contact-block">
          <h2>Hours</h2>
          <ul class="contact-hours">
            {site.hours.map((h) => (
              <li><span>{h.days}</span><span>{keepTimes(h.time)}</span></li>
            ))}
          </ul>
          {site.lunch && <p class="contact-note">{keepTimes(site.lunch)}</p>}
        </div>

        <div class="contact-block">
          <h2>New patients</h2>
          <p>
            Online scheduling is set up for established patients only. If you're new, please
            call the office or use the appointment request form and we'll be in touch.
          </p>
          <div class="hero-cta">
            <Button href="/new-patient-appointment-request/" variant="ghost" icon="arrow-right">
              New patient appointment request
            </Button>
          </div>
        </div>
      </div>

      <aside class="contact-map">
        {/* The address card underneath shows until the map loads, and stays
            if Google's embed is blocked, so there's never an empty frame. */}
        <div class="contact-map-frame">
          <div class="contact-map-fallback" aria-hidden="true">
            <Icon name="pin" size={28} />
            <p>{a.street}<br />{a.city}, {a.state} {a.zip}</p>
          </div>
          <iframe
          title={`Map to ${site.name}`}
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <a class="contact-directions"
           href={directionsHref}
           target="_blank" rel="noopener">
          Get directions <Icon name="arrow-up-right" size={14} />
        </a>
      </aside>
    </div>
  </section>

  <section class="section contact-message" aria-labelledby="contact-message-head">
    <div class="container contact-message-grid">
      <div class="contact-message-text">
        <h2 class="h2" id="contact-message-head">Send us a message</h2>
        <p class="lede">
          If you are a new patient looking to obtain more information about our office,
          please call or contact us below.
        </p>
        <p class="contact-message-phone">
          <a href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="section contact-team" aria-labelledby="contact-team-head" data-pagefind-ignore>
    <div class="container">
      <div class="contact-team-head">
        <h2 class="h2" id="contact-team-head">Book with your practitioner</h2>
        <p class="lede">Established patients can book online, directly with their practitioner.</p>
      </div>
      <div class="docs-list">
        {team.map((d, i) => (
          <PractitionerCard variant="schedule" name={d.name} credentials={d.credentials} slug={d.slug}
                            imageFile={d.imageFile} index={i} schedule={d.schedule} />
        ))}
      </div>
    </div>
  </section>
</Base>

<style is:global>
/* --- Contact ---------------------------------------------------------------- */
.contact-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: var(--gap-cols); align-items: start;
}
.contact-block + .contact-block { margin-top: var(--space-head); }
.contact-block h2 {
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--ink-3); margin: 0 0 var(--space-4); font-weight: 500;
}
.contact-addr { font-size: 19px; line-height: 1.55; margin: 0 0 var(--space-4); color: var(--ink); }
.contact-lines { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; }
.contact-lines a, .contact-lines span {
  display: inline-flex; align-items: center; gap: var(--space-2); font-size: 16px; color: var(--ink-2);
}
.contact-lines a:hover { color: var(--grn-2); }
.contact-hours { list-style: none; margin: 0; padding: 0; max-width: 380px; }
.contact-hours li {
  display: flex; justify-content: space-between; gap: var(--space-5);
  padding: var(--space-2) 0; border-bottom: 1px solid var(--line); font-size: 15.5px;
}
.contact-hours li span:first-child { color: var(--ink); }
.contact-hours li span:last-child { color: var(--ink-2); font-family: var(--font-mono); font-size: 14px; }
.contact-note { margin: var(--space-3) 0 0; font-size: 14.5px; color: var(--ink-3); }
.contact-map { position: sticky; top: 96px; }
.contact-map-frame {
  position: relative; aspect-ratio: 4 / 5; overflow: hidden;
  border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-soft);
}
.contact-map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
.contact-map-fallback {
  position: absolute; inset: 0; display: grid; place-content: center; justify-items: center;
  gap: var(--space-3); text-align: center; color: var(--grn-2);
}
.contact-map-fallback p { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); }
.contact-directions {
  display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3);
  font-size: 14px; font-weight: 500; color: var(--grn-2);
}
@media (max-width: 860px) {
  .contact-grid { grid-template-columns: 1fr; }
  .contact-map { position: static; }
  .contact-map-frame { aspect-ratio: 4 / 3; }
}

/* Send us a message: the words on the left, the form card on the right; one
   column on a tablet or phone. Same ground as the sections around it. */
.contact-message { padding-top: 0; }
.contact-message-grid {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  gap: var(--gap-cols); align-items: start;
}
.contact-message-text .lede { margin-top: var(--space-4); }
.contact-message-phone { margin: var(--space-6) 0 0; }
.contact-message-phone a {
  display: inline-flex; align-items: center; gap: var(--space-2);
  font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: -0.02em; color: var(--ink);
}
.contact-message-phone a:hover { color: var(--grn-2); }
.contact-message-phone svg { color: var(--grn-2); }
@media (max-width: 860px) {
  .contact-message-grid { grid-template-columns: 1fr; gap: var(--space-7); }
}

/* Book with your practitioner: the rows are PractitionerCard's schedule variant. */
.contact-team { padding-top: 0; }
.contact-team-head { margin-bottom: var(--space-head); }
.contact-team-head .lede { margin-top: var(--space-4); }
</style>
