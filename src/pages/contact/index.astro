---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { site, mapQuery, directionsHref } from '@/data/site';

const a = site.address;
---
<Base
  title="Contact"
  description={`Contact East Valley Naturopathic Doctors in ${a.city}, ${a.state}. Call ${site.phone}, or send the front desk a message.`}>
  <PageHero
    eyebrow="Contact"
    title="Come see us in Mesa."
    lede="Established patients can book online under their doctor. New patients — call the office or send a message and we'll get you scheduled."
  />

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-details">
        <div class="contact-block">
          <h2>Clinic</h2>
          <p class="contact-addr">
            {site.name}<br />
            {a.street}<br />
            {a.city}, {a.state} {a.zip}
          </p>
          <p class="contact-lines">
            <a href={site.phoneHref}><Icon name="phone" size={15} />{site.phone}</a>
            {site.fax && <span><Icon name="send" size={15} />Fax {site.fax}</span>}
          </p>
          <div class="hero-cta" style="margin-top:22px">
            <Button href="/schedule-appointment/" variant="dark" icon="calendar">Schedule an appointment</Button>
          </div>
        </div>

        <div class="contact-block">
          <h2>Hours</h2>
          <ul class="contact-hours">
            {site.hours.map((h) => (
              <li><span>{h.days}</span><span>{h.time}</span></li>
            ))}
          </ul>
          {site.lunch && <p class="contact-note">{site.lunch}</p>}
        </div>

        <div class="contact-block">
          <h2>New patients</h2>
          <p>
            Online scheduling is set up for established patients only. If you're new, please
            call the office or use the appointment request form and we'll be in touch.
          </p>
          <div class="hero-cta">
            <Button href="/new-patient-appointment-request/" variant="ghost" icon="arrow-right">
              New patient appointment request
            </Button>
          </div>
        </div>
      </div>

      <aside class="contact-map">
        <iframe
          title={`Map to ${site.name}`}
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a class="contact-directions"
           href={directionsHref}
           target="_blank" rel="noopener">
          Get directions <Icon name="arrow-up-right" size={14} />
        </a>
      </aside>
    </div>
  </section>
</Base>

<style is:global>
/* --- Contact ---------------------------------------------------------------- */
.contact-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: clamp(28px, 4vw, 64px); align-items: start;
}
.contact-block + .contact-block { margin-top: clamp(30px, 4vw, 46px); }
.contact-block h2 {
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--ink-3); margin: 0 0 14px; font-weight: 500;
}
.contact-addr { font-size: 19px; line-height: 1.55; margin: 0 0 16px; color: var(--ink); }
.contact-lines { display: flex; flex-direction: column; gap: 8px; margin: 0; }
.contact-lines a, .contact-lines span {
  display: inline-flex; align-items: center; gap: 9px; font-size: 16px; color: var(--ink-2);
}
.contact-lines a:hover { color: var(--grn-2); }
.contact-hours { list-style: none; margin: 0; padding: 0; max-width: 380px; }
.contact-hours li {
  display: flex; justify-content: space-between; gap: 20px;
  padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 15.5px;
}
.contact-hours li span:first-child { color: var(--ink); }
.contact-hours li span:last-child { color: var(--ink-2); font-family: var(--font-mono); font-size: 14px; }
.contact-note { margin: 14px 0 0; font-size: 14.5px; color: var(--ink-3); }
.contact-map { position: sticky; top: 96px; }
.contact-map iframe {
  width: 100%; aspect-ratio: 4 / 5; border: 1px solid var(--line);
  border-radius: var(--radius-lg); display: block;
}
.contact-directions {
  display: inline-flex; align-items: center; gap: 7px; margin-top: 14px;
  font-size: 14px; font-weight: 500; color: var(--grn-2);
}
@media (max-width: 860px) {
  .contact-grid { grid-template-columns: 1fr; }
  .contact-map { position: static; }
  .contact-map iframe { aspect-ratio: 4 / 3; }
}
</style>
