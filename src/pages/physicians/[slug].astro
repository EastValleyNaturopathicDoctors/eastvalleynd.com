---
import { jsonLd } from '@/lib/schema';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import BookCTA from '../../components/BookCTA.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const docs = await getCollection('physicians');
  const sorted = docs.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const initials = d.name.replace(/^Dr\.\s*/, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  jobTitle: d.credentials,
  description: d.summary,
  worksFor: { '@type': 'MedicalClinic', name: site.name },
  // Image URL is emitted by the build; omitted here rather than guessed.
};
---
<Base title={d.name} description={d.metaDescription || d.summary}>
  <section class="page-hero doc-hero">
    <div class="container doc-hero-inner">
      <div class="doc-hero-photo">
        {d.imageFile
          ? <TeamPhoto file={d.imageFile} alt={d.name} width={480} height={480}
                       loading="eager" fetchpriority="high" />
          : <span class="doc-initials" aria-hidden="true">{initials}</span>}
      </div>
      <div class="doc-hero-text">
        <Eyebrow><a href="/physicians/">Practitioners</a></Eyebrow>
        <h1 class="h1">{d.name}</h1>
        {d.credentials && <p class="doc-hero-creds">{d.credentials}</p>}
        {/* `summary` is the first paragraph of the bio, which renders in full
            immediately below — repeating it here just reads as a stutter. */}
        <div class="hero-cta">
          {d.booking.length === 1 ? (
            <Button href={d.booking[0].url} variant="dark" icon="calendar" target="_blank" rel="noopener">
              Book with {d.name.split(' ').slice(-1)[0]}
            </Button>
          ) : (
            <Button href="/new-patient-appointment-request/" variant="dark" icon="arrow-right">Request an appointment</Button>
          )}
          <Button href={site.phoneHref} variant="ghost" icon="phone">{site.phone}</Button>
        </div>
      </div>
    </div>
  </section>

  {d.booking.length > 1 && (
    <section class="section doc-booking-section">
      <div class="container">
        <Eyebrow>Book with {d.name.split(' ').slice(-1)[0]}</Eyebrow>
        <h2 class="h2">Appointment types</h2>
        <ul class="doc-booking-list">
          {d.booking.map((b) => (
            <li>
              <a href={b.url} target="_blank" rel="noopener">
                <span>{b.label}</span>
                <Icon name="arrow-up-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section doc-bio-section">
    <div class="container doc-bio">
      <article class="doc-bio-body">
        <Content />
      </article>
    </div>
  </section>

  {/* Porter and Nevels carry four reviews each, so these render as a carousel:
      more than three is the house rule, and it lives in the component. */}
  <TestimonialCarousel
    items={d.testimonials}
    eyebrow={`What patients say about ${d.name.replace(/^Dr\.\s*/, 'Dr. ')}`}
    variant="doc"
  />

  <nav class="section doc-pager" aria-label="More practitioners">
    <div class="container doc-pager-inner">
      <a class="doc-pager-link is-prev" href={`/physicians/${prev.data.slug}/`}>
        <Icon name="arrow-right" size={16} />
        <span><small>Previous</small>{prev.data.name}</span>
      </a>
      <a class="doc-pager-all" href="/physicians/">All practitioners</a>
      <a class="doc-pager-link is-next" href={`/physicians/${next.data.slug}/`}>
        <span><small>Next</small>{next.data.name}</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </nav>

  <BookCTA />
  <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
</Base>

<style is:global>
/* Detail hero */
.doc-hero { padding-bottom: clamp(40px, 5vw, 64px); }
.doc-hero-inner {
  display: grid; grid-template-columns: minmax(200px, 300px) 1fr;
  gap: clamp(24px, 4vw, 56px); align-items: center;
}
.doc-hero-photo {
  aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden;
  background: var(--grn-soft); display: grid; place-items: center;
}
.doc-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
.doc-hero-photo .doc-initials { font-size: clamp(40px, 6vw, 72px); }
.doc-hero-creds {
  font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--ink-3); margin: 10px 0 0;
}
.doc-hero-text .lede { margin-top: 18px; }
.doc-hero-text .hero-cta { margin-top: 28px; }
.doc-hero .eyebrow a { text-decoration: none; }

/* Bio body — the carried-over WordPress prose. */
.doc-bio { max-width: 74ch; }
.doc-bio-body { font-size: 17px; line-height: 1.62; color: var(--ink-2); }
.doc-bio-body > :first-child { margin-top: 0; }
.doc-bio-body p { margin: 0 0 1.15em; }
.doc-bio-body h2, .doc-bio-body h3, .doc-bio-body h4 {
  font-family: var(--font-display); color: var(--ink);
  letter-spacing: -0.015em; line-height: 1.15;
  margin: 1.9em 0 0.5em;
}
.doc-bio-body h2 { font-size: clamp(24px, 2.4vw, 32px); }
.doc-bio-body h3 { font-size: clamp(20px, 2vw, 25px); }
.doc-bio-body h4 { font-size: 18px; text-transform: uppercase; letter-spacing: 0.06em;
  font-family: var(--font-mono); color: var(--grn-2); }
.doc-bio-body ul, .doc-bio-body ol { margin: 0 0 1.15em; padding-left: 1.25em; }
.doc-bio-body li { margin-bottom: 0.4em; }
.doc-bio-body a { color: var(--grn-2); text-decoration: underline; text-underline-offset: 2px; }
.doc-bio-body strong { color: var(--ink); }

/* Prev / next */
.doc-pager { padding-top: 0; }
.doc-pager-inner {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  border-top: 1px solid var(--line); padding-top: 28px; flex-wrap: wrap;
}
.doc-pager-link { display: inline-flex; align-items: center; gap: 12px; }
.doc-pager-link small {
  display: block; font-family: var(--font-mono); font-size: 11px;
  text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3);
}
.doc-pager-link.is-prev svg { transform: rotate(180deg); }
.doc-pager-link:hover { color: var(--grn-2); }
.doc-pager-all { font-size: 14px; color: var(--ink-3); }
.doc-pager-all:hover { color: var(--ink); }

@media (max-width: 760px) {
  .doc-hero-inner { grid-template-columns: 1fr; }
  .doc-hero-photo { max-width: 200px; }
  .doc-pager-inner { flex-direction: column; align-items: flex-start; }
}

/* Condition/therapy links carried over from the WordPress bios. WPBakery laid
   these out with a grid, so the source markup has no separators; the generator
   rebuilds them as a real list. */
.doc-bio-body .doc-treats {
  list-style: none; padding: 0; margin: 0 0 1.4em;
  display: grid; gap: 8px 20px;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}
.doc-bio-body .doc-treats li { margin: 0; }
.doc-bio-body .doc-treats a {
  display: block; padding: 9px 0; font-size: 15px; font-weight: 500;
  color: var(--ink); text-decoration: none;
  border-bottom: 1px solid var(--line);
}
.doc-bio-body .doc-treats a:hover { color: var(--grn-2); border-color: var(--grn); }

/* Booking links recovered from the WordPress scheduling widgets. */
.doc-booking-section { padding-top: 0; }
.doc-booking-section .h2 { margin: 10px 0 24px; }
.doc-booking-list {
  list-style: none; margin: 0; padding: 0;
  display: grid; gap: 12px;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}
.doc-booking-list a {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 18px 20px; border: 1px solid var(--line-2); border-radius: var(--radius);
  font-weight: 500; transition: border-color .2s, background .2s;
}
.doc-booking-list a:hover { border-color: var(--grn); background: var(--grn-soft); }
</style>
