---
import { jsonLd } from '@/lib/schema';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import BookCTA from '../../components/BookCTA.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import ReviewList from '../../components/ReviewList.astro';
import BodyHtml from '../../components/BodyHtml.astro';
import { cleanLinks } from '@/lib/links';
import { stripEncodedShortcodes } from '@/lib/shortcodes';
import { site } from '../../data/site';
import { practitionerReviews } from '../../data/practitioner-reviews';
import { reviewsById } from '@/lib/reviews';
import '../../styles/pager.css';

export async function getStaticPaths() {
  const docs = await getCollection('physicians');
  const sorted = docs.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
// The bio renders from its HTML string, like the content pages, so its links
// go through the same clean-up (tracker L3), less any encoded shortcode the
// migration left as text (tracker P6).
const bio = cleanLinks(stripEncodedShortcodes(entry.rendered?.html ?? ''), `/physicians/${d.slug}/`);
const initials = d.name.replace(/^Dr\.\s*/, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
// Google reviews (src/data/practitioner-reviews.ts): the ones that name them,
// then, where those are few, reviews of the clinic under their own heading.
const picked = practitionerReviews[d.slug] ?? { named: [], more: [] };
const named = reviewsById(picked.named);
const more = reviewsById(picked.more);
/** "Dr. Porter", or a first name for the practitioners who aren't doctors. */
const shortName = d.name.startsWith('Dr.') ? `Dr. ${d.name.split(' ').slice(-1)[0]}` : d.name.split(' ')[0];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  jobTitle: d.credentials,
  description: d.summary,
  worksFor: { '@type': 'MedicalClinic', name: site.name },
  // Image URL is emitted by the build; omitted here rather than guessed.
};
---
<Base title={d.name} description={d.metaDescription || d.summary} searchSection="Practitioners">
  <section class="page-hero doc-hero">
    <div class="container doc-hero-inner">
      <div class="doc-hero-photo">
        {d.imageFile
          ? <TeamPhoto file={d.imageFile} alt={d.name} width={480} height={480}
                       loading="eager" fetchpriority="high" />
          : <span class="doc-initials" aria-hidden="true">{initials}</span>}
      </div>
      <div class="doc-hero-text">
        <Eyebrow><a href="/physicians/">Practitioners</a></Eyebrow>
        <h1 class="h1">{d.name}</h1>
        {d.credentials && <p class="doc-hero-creds">{d.credentials}</p>}
        {/* `summary` is the first paragraph of the bio, which renders in full
            immediately below — repeating it here just reads as a stutter. */}
        <div class="hero-cta">
          {d.booking.length === 1 ? (
            <Button href={d.booking[0].url} variant="dark" icon="calendar" target="_blank" rel="noopener">
              Book with {d.name.split(' ').slice(-1)[0]}
            </Button>
          ) : (
            <Button href="/new-patient-appointment-request/" variant="dark" icon="arrow-right">Request an appointment</Button>
          )}
          <Button href={site.phoneHref} variant="ghost" icon="phone">{site.phone}</Button>
        </div>
      </div>
    </div>
  </section>

  {/* One section: the booking block (when a practitioner has several
      appointment types) and the bio below it, both on the content edge. */}
  <section class="section doc-main">
    <div class="container">
      {d.booking.length > 1 && (
        <div class="doc-booking" id="book">
          <Eyebrow>Book with {d.name.split(' ').slice(-1)[0]}</Eyebrow>
          <h2 class="h2">Appointment types</h2>
          <ul class="doc-booking-list">
            {d.booking.map((b) => (
              <li>
                <a href={b.url} target="_blank" rel="noopener">
                  <span>{b.label}</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <article class="doc-bio-body prose">
        <BodyHtml html={bio} />
      </article>
    </div>
  </section>

  {(named.length > 0 || more.length > 0) && (
    <section class="section is-band doc-reviews" aria-labelledby="doc-reviews-head" data-pagefind-ignore>
      <div class="container">
        {named.length > 0 && (
          <div class="doc-reviews-group">
            <Eyebrow>From Google</Eyebrow>
            <h2 class="h2" id="doc-reviews-head">What patients say about {shortName}</h2>
            <p class="lede">Five-star reviews on Google that mention {shortName}.</p>
            <ReviewList reviews={named} />
          </div>
        )}
        {more.length > 0 && (
          <div class="doc-reviews-group">
            {named.length === 0 && <Eyebrow>From Google</Eyebrow>}
            <h2 class="h2" id={named.length === 0 ? 'doc-reviews-head' : undefined}>More from our patients</h2>
            <p class="lede">Five-star reviews of the clinic as a whole, from Google.</p>
            <ReviewList reviews={more} />
          </div>
        )}
        <p class="doc-reviews-all">
          <a href="/reviews/">Read all our reviews <Icon name="arrow-right" size={15} /></a>
        </p>
      </div>
    </section>
  )}

  <nav class="pager doc-pager" aria-label="More practitioners">
    <div class="container">
      <div class="pager-inner">
        <a class="pager-link is-prev" href={`/physicians/${prev.data.slug}/`}>
          <Icon name="arrow-right" size={16} />
          <span><small>Previous</small>{prev.data.name}</span>
        </a>
        <a class="pager-all" href="/physicians/">All practitioners</a>
        <a class="pager-link is-next" href={`/physicians/${next.data.slug}/`}>
          <span><small>Next</small>{next.data.name}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </nav>

  <BookCTA />
  <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
</Base>

<style is:global>
/* Google reviews: one group per heading, the second a block below the first. */
.doc-reviews { background: var(--bg-soft); }
.doc-reviews .lede { margin: var(--space-4) 0 var(--space-head); }
.doc-reviews-group + .doc-reviews-group { margin-top: var(--space-block); }
.doc-reviews-all { margin: var(--space-6) 0 0; }
.doc-reviews-all a { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 600; color: var(--grn-2); }
.doc-reviews-all a:hover { text-decoration: underline; text-underline-offset: 3px; }
/* Detail hero. Its bottom padding is the page-hero token (global.css). */
.doc-hero-inner {
  display: grid; grid-template-columns: minmax(200px, 300px) 1fr;
  gap: var(--gap-cols); align-items: center;
}
.doc-hero-photo {
  aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden;
  background: var(--grn-soft); display: grid; place-items: center;
}
.doc-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
.doc-hero-photo .doc-initials { font-size: clamp(40px, 6vw, 72px); }
.doc-hero-creds {
  font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--ink-3); margin: var(--space-5) 0 0;
}
.doc-hero .eyebrow a { text-decoration: none; }

@media (max-width: 760px) {
  .doc-hero-inner { grid-template-columns: 1fr; }
  .doc-hero-photo { max-width: 200px; }
}

/* Booking links recovered from the WordPress scheduling widgets, then the
   bio, in one section: one block step between them, not two paddings. */
.doc-booking .h2 + .doc-booking-list { margin-top: var(--space-head); }
/* The contact page's Schedule links land here, clear of the sticky header. */
.doc-booking { scroll-margin-top: 110px; }
.doc-booking + .doc-bio-body { margin-top: var(--space-block); }
.doc-booking-list {
  list-style: none; margin: 0; padding: 0;
  display: grid; gap: var(--gap-cards);
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}
.doc-booking-list a {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
  height: 100%;   /* a row's cards match the tallest */
  padding: var(--pad-row); border: 1px solid var(--line-2); border-radius: var(--radius);
  font-weight: 500; transition: border-color .2s, background .2s;
}
.doc-booking-list a:hover { border-color: var(--grn); background: var(--grn-soft); }

/* Bio body — the carried-over WordPress prose, on the shared article column
   (src/styles/prose.css, via BodyHtml). Only its own extras live here. */
.doc-bio-body h4 {
  font-size: 18px; text-transform: uppercase; letter-spacing: 0.06em;
  font-family: var(--font-mono); color: var(--grn-2);
}

/* Condition/therapy links carried over from the WordPress bios. WPBakery laid
   these out with a grid, so the source markup has no separators; the generator
   rebuilds them as a real list. */
.doc-bio-body .doc-treats {
  list-style: none; padding: 0; margin: 0 0 var(--space-7);
  display: grid; gap: var(--space-2) var(--space-5);
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}
.doc-bio-body .doc-treats li { margin: 0; }
.doc-bio-body .doc-treats a {
  display: block; padding: var(--space-2) 0; font-size: 15px; font-weight: 500;
  color: var(--ink); text-decoration: none;
  border-bottom: 1px solid var(--line);
}
.doc-bio-body .doc-treats a:hover { color: var(--grn-2); border-color: var(--grn); }
</style>
