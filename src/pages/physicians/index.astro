---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PractitionerCard from '../../components/PractitionerCard.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import BookCTA from '../../components/BookCTA.astro';

const docs = (await getCollection('physicians')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Our Practitioners"
  description="Meet the board-licensed naturopathic doctors, massage therapist, nutritionist and aesthetician at East Valley Naturopathic Doctors in Mesa, AZ.">
  <PageHero
    eyebrow="Meet our practitioners"
    title="Seven clinicians. One way of practicing medicine."
    lede="Board-licensed NMDs in the state of Arizona, plus licensed massage, nutrition and skincare practitioners. Each brings a distinct specialty."
  />
  <TrustStrip />
  <section class="section practitioners-section">
    <div class="container">
      <div class="docs-list">
        {docs.map((d, i) => (
          <PractitionerCard
            level="h2"
            name={d.data.name} credentials={d.data.credentials} slug={d.data.slug}
            imageFile={d.data.imageFile} summary={d.data.summary} index={i}
          />
        ))}
      </div>
    </div>
  </section>
  <BookCTA />
</Base>
