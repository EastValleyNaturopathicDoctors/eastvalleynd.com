# Files in dist/ that Cloudflare should not upload or serve.
# .htaccess is the Apache copy of the redirects; Cloudflare reads _redirects instead.
.htaccess
# " 2" / " 3" copies that iCloud sync makes beside a file or folder ("index 2.html",
# "sitemap 2.xml", "plaquex 2"). scripts/stray-copies.mjs deletes them after the
# build, but iCloud can add more before a deploy (tracker R3). Only copies of the
# names the build itself writes, so a real upload such as "Intake Form 2.pdf"
# still deploys (tracker K11).
index [0-9]*.html
404 [0-9]*.html
sitemap [0-9]*.xml
robots [0-9]*.txt
_redirects [0-9]*
_headers [0-9]*
# Folder copies: every deployed folder is a URL segment, which never has a space
# (scripts/stray-copies.mjs fails the build on a folder in public/ named so).
* [0-9]/
* [0-9][0-9]/
